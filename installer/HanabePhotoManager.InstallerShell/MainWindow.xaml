<Window x:Class="HanabePhotoManager.InstallerShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hanabe Photo Manager 安装程序" Width="780" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="/Assets/HanabeApp.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.84" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Text}" /></Style>
    </Window.Resources>

    <Border CornerRadius="24" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/><RowDefinition Height="78"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="24,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="34" Height="34" Source="{DynamicResource Image.AppLogo}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" Text="Hanabe Photo Manager" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Width="74" Padding="0" Margin="0,0,8,0" Click="ThemeButton_Click" Content="深色" />
                    <Button Width="40" Padding="0" Click="CloseButton_Click" Content="×" FontSize="22" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="42,12,42,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="20" Background="{DynamicResource Brush.SurfaceMuted}" Padding="24">
                    <StackPanel>
                        <Image Width="104" Height="104" HorizontalAlignment="Left" Source="{DynamicResource Image.AppLogo}" />
                        <TextBlock Margin="0,22,0,8" FontSize="24" FontWeight="Bold" Text="安装照片管理器" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="22" Text="简单、清晰地管理本机照片。安装过程只需要几步。" TextWrapping="Wrap" />
                        <StackPanel Margin="0,30,0,0">
                            <TextBlock x:Name="StepOne" Margin="0,0,0,14" Text="●  1  安装选项" />
                            <TextBlock x:Name="StepTwo" Margin="0,0,0,14" Foreground="{DynamicResource Brush.TextSecondary}" Text="○  2  使用须知" />
                            <TextBlock x:Name="StepThree" Margin="0,0,0,14" Foreground="{DynamicResource Brush.TextSecondary}" Text="○  3  正在安装" />
                            <TextBlock x:Name="StepFour" Foreground="{DynamicResource Brush.TextSecondary}" Text="○  4  完成" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2">
                    <StackPanel x:Name="WelcomePanel">
                        <TextBlock FontSize="30" FontWeight="Bold" Text="准备安装" />
                        <TextBlock Margin="0,8,0,28" Foreground="{DynamicResource Brush.TextSecondary}" Text="选择安装位置，然后阅读使用须知。" />
                        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="安装位置" />
                        <Border CornerRadius="14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="14,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Padding="14,8" Click="BrowseButton_Click" Content="更改" />
                                <TextBox x:Name="InstallFolderBox" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Text}" FontSize="14" Text="C:\Program Files\照片管理器" />
                            </DockPanel>
                        </Border>
                        <Border Margin="0,22,0,0" Padding="18" CornerRadius="14" Background="{DynamicResource Brush.SurfaceMuted}">
                            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="22" Text="安装器将在你点击“开始安装”后请求管理员权限。照片库与个人数据不会写入安装目录。" />
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LicensePanel" Visibility="Collapsed">
                        <TextBlock FontSize="30" FontWeight="Bold" Text="使用须知" />
                        <TextBlock Margin="0,8,0,16" Foreground="{DynamicResource Brush.TextSecondary}" Text="请从头阅读到末尾，之后才可以确认同意。" />
                        <Border Height="258" CornerRadius="16" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                            <ScrollViewer x:Name="LicenseScroll" Padding="20" VerticalScrollBarVisibility="Auto" ScrollChanged="LicenseScroll_ScrollChanged">
                                <TextBlock x:Name="LicenseText" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="23" />
                            </ScrollViewer>
                        </Border>
                        <CheckBox x:Name="AcceptCheckBox" Margin="4,16,0,0" IsEnabled="False" Foreground="{DynamicResource Brush.Text}" Checked="AcceptCheckBox_Changed" Unchecked="AcceptCheckBox_Changed" Content="我已阅读并同意以上使用须知" />
                        <TextBlock x:Name="ReadHint" Margin="4,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="请继续向下滚动" />
                    </StackPanel>

                    <StackPanel x:Name="InstallingPanel" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Text="正在安装" />
                        <TextBlock Margin="0,10,0,30" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="请稍候，不要关闭安装程序。" />
                        <ProgressBar Height="8" IsIndeterminate="True" Foreground="{DynamicResource Brush.Accent}" />
                    </StackPanel>

                    <StackPanel x:Name="CompletePanel" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ResultTitle" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Text="安装完成" />
                        <TextBlock x:Name="ResultMessage" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="Hanabe Photo Manager 已准备就绪。" TextWrapping="Wrap" />
                        <Button x:Name="CopyLogButton" Margin="0,20,0,0" HorizontalAlignment="Center" Visibility="Collapsed" Click="CopyLogButton_Click" Content="复制日志位置" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="42,10,42,22">
                <Button x:Name="BackButton" HorizontalAlignment="Left" Width="106" Click="BackButton_Click" Content="上一步" Visibility="Collapsed" />
                <Button x:Name="NextButton" HorizontalAlignment="Right" MinWidth="136" Style="{StaticResource PrimaryButton}" Click="NextButton_Click" Content="下一步" />
            </Grid>
        </Grid>
    </Border>
</Window>
