<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Bundle</OutputType>
    <OutputName>HanabePhotoManager-Setup-x64</OutputName>
    <BundleVersion Condition="'$(BundleVersion)' == ''">0.1.0</BundleVersion>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\0.1.0\HanabePhotoManager-x64.msi</MsiPath>
    <DefineConstants>BundleVersion=$(BundleVersion);MsiPath=$(MsiPath)</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
  </ItemGroup>

  <!-- 主题 .wxl 只通过 LocalizationFile 作为 BA 主题本地化引用，不能同时被 **/*.wxl 默认包含，
       否则与内置主题本地化冲突报 duplicate-ID（WIX0100）。 -->
  <ItemGroup>
    <EmbeddedResource Remove="themes\HanabeTheme.wxl" />
  </ItemGroup>

</Project>
