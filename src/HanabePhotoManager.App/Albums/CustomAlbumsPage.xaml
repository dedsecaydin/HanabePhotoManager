<UserControl x:Class="HanabePhotoManager.App.Albums.CustomAlbumsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:albums="clr-namespace:HanabePhotoManager.App.Albums">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Style="{DynamicResource Card.Default}" Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <Button Content="添加文件夹" Style="{DynamicResource Button.Primary}" Click="AddFolder_Click" AutomationProperties.Name="添加自定义相册文件夹" />
          <TextBlock Margin="0,10,0,12" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Text="添加的是应用内引用；移除相册不会删除磁盘中的文件夹或照片。" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Albums}" SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type albums:CustomAlbumItemViewModel}">
              <StackPanel Margin="4,6">
                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" Text="{Binding AvailabilityText}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Style="{DynamicResource Card.Default}" Padding="16" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{DynamicResource Layout.SectionTitle}" Text="{Binding SelectedAlbum.DisplayName}" />
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            <TextBox Margin="0,12,0,0" Text="{Binding EditableDisplayName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelectedAlbum}" AutomationProperties.Name="自定义相册显示名称" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
            <Button Content="重命名" Style="{DynamicResource Button.Secondary}" Command="{Binding RenameSelectedCommand}" />
            <Button Content="刷新" Style="{DynamicResource Button.Secondary}" Command="{Binding RefreshSelectedCommand}" />
            <Button Content="移除引用" Style="{DynamicResource Button.Danger}" Command="{Binding RemoveSelectedCommand}" ToolTip="仅从应用列表移除，不删除磁盘文件夹或照片。" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Photos}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type albums:CustomAlbumPhoto}">
                <Border Width="180" Height="204" Margin="0,0,12,12" Style="{DynamicResource Card.Interactive}" Padding="6">
                  <StackPanel>
                    <Border Height="158" ClipToBounds="True" Background="{DynamicResource Brush.Surface.Subtle}">
                      <Image Source="{Binding FullPath}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Margin="4,8,4,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Style="{DynamicResource StatusPanel.Empty}" Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
          <TextBlock Text="选择或添加一个包含图片的文件夹。" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
