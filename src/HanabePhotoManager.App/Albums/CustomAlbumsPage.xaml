<UserControl x:Class="HanabePhotoManager.App.Albums.CustomAlbumsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:albums="clr-namespace:HanabePhotoManager.App.Albums"
             xmlns:app="clr-namespace:HanabePhotoManager.App">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <app:PathThumbnailConverter x:Key="PathThumb" />
    <app:FileSizeConverter x:Key="FileSize" />

    <!-- 相册卡片：16:10 大圆角封面 + 名称 + 路径 -->
    <Style x:Key="AlbumCardButton" TargetType="Button">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="{StaticResource Radius.Dialog}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Top" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.ContainerHigh}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.ContainerHighest}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 16:10 封面占位（无封面数据时显示相册图标） -->
    <Style x:Key="AlbumCoverSurface" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerHigh}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource Layout.PagePanel}" Padding="16">
    <Grid>
    <!-- ═══════════ 相册总览：卡片网格 ═══════════ -->
    <ScrollViewer x:Name="AlbumOverviewPanel" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,0,4">
        <DockPanel Margin="2,0,2,16">
          <StackPanel>
            <TextBlock Text="自定义相册" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" />
            <TextBlock Text="添加的是应用内引用；移除相册不会删除磁盘中的文件夹或照片。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}" Margin="0,3,0,0" />
          </StackPanel>
          <Border DockPanel.Dock="Right" Padding="10,3" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHigh}" VerticalAlignment="Center">
            <TextBlock Text="{Binding Albums.Count, StringFormat={}{0} 个}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
          </Border>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Albums}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type albums:CustomAlbumItemViewModel}">
              <Button Width="232" Margin="0,0,16,16" Style="{StaticResource AlbumCardButton}" Click="AlbumCard_Click" AutomationProperties.Name="打开相册">
                <Button.ContextMenu>
                  <ContextMenu Style="{DynamicResource Menu.Context}" FontFamily="{StaticResource Typography.FontFamily.UI}" FontSize="{StaticResource Typography.Body}">
                    <MenuItem Style="{DynamicResource Menu.Item}" Header="管理" Click="AlbumMenu_Manage_Click" />
                    <MenuItem Style="{DynamicResource Menu.Item}" Header="重命名" Click="AlbumMenu_Rename_Click" />
                    <Separator Style="{DynamicResource Separator.Menu}" />
                    <MenuItem Style="{DynamicResource Menu.Item}" Foreground="{DynamicResource Brush.Status.Danger}" Header="删除" Click="AlbumMenu_Delete_Click" />
                  </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                  <Border Height="128" Style="{StaticResource AlbumCoverSurface}">
                    <Grid>
                      <Path Data="{StaticResource Icon.Album}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.4" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.TertiaryContainer}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsFolderAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="⚠ 不可用" Foreground="{DynamicResource Brush.OnTertiaryContainer}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource Typography.Label}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="6,10,6,0" />
                  <TextBlock Text="{Binding FolderPath}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" TextTrimming="CharacterEllipsis" Margin="6,3,6,4" ToolTip="{Binding FolderPath}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空相册引导文案 -->
        <Border Margin="0,36,0,8" Padding="32,28"
                HorizontalAlignment="Center" IsHitTestVisible="False">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Albums.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="还没有自定义相册" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" />
            <TextBlock Text="点击下方「＋ 新建相册」添加磁盘文件夹作为相册引用；移除相册不会删除文件夹或照片。"
                       Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- 末尾虚线「＋新建相册」卡 -->
        <Button Width="232" Margin="0,0,16,16" Padding="10" HorizontalContentAlignment="Stretch" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="AddFolder_Click" AutomationProperties.Name="新建相册">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" Height="128" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLow}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="＋" FontSize="{StaticResource Typography.Display}" FontWeight="Light" Foreground="{DynamicResource Brush.OnSurfaceVariant}" HorizontalAlignment="Center" />
                  <TextBlock Text="新建相册" FontSize="{StaticResource Typography.Label}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                  <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <!-- ═══════════ 相册详情：hero + 照片区 + Inspector ═══════════ -->
    <Grid x:Name="AlbumDetailPanel" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 详情 hero -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="18,20" Background="Transparent" BorderThickness="0">
          <StackPanel>
            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="12,7" Content="← 全部相册" Click="BackToAlbums_Click" AutomationProperties.Name="返回全部相册" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="150" Height="96" Style="{StaticResource AlbumCoverSurface}" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.Album}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.4" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,18,0">
                <TextBlock Text="{Binding SelectedAlbum.DisplayName}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <Border Padding="10,5" Margin="0,8,0,0" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHigh}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding SelectedAlbum.FolderPath}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" TextTrimming="CharacterEllipsis" MaxWidth="520" ToolTip="{Binding SelectedAlbum.FolderPath}" />
                </Border>
                <DockPanel Margin="0,12,0,0" MaxWidth="460">
                  <Button DockPanel.Dock="Right" Content="重命名" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding RenameSelectedCommand}" />
                  <TextBox x:Name="AlbumRenameTextBox" Text="{Binding EditableDisplayName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelectedAlbum}" AutomationProperties.Name="自定义相册显示名称" />
                </DockPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button Content="刷新" Style="{StaticResource Button.Secondary}" Margin="0,0,0,8" Command="{Binding RefreshSelectedCommand}" />
                <Button Content="移除引用" Style="{StaticResource Button.Danger}" Command="{Binding RemoveSelectedCommand}" ToolTip="仅从应用列表移除，不删除磁盘文件夹或照片。" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 照片区：网格 / 列表切换 -->
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="2,0,2,12">
            <TextBlock Text="照片" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border DockPanel.Dock="Right" Style="{StaticResource Navigation.Segment}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AlbumViewGridButton" Content="网格" GroupName="AlbumViewMode" Style="{StaticResource Navigation.SegmentItem}" IsChecked="True" Checked="AlbumViewMode_Checked" AutomationProperties.Name="网格视图" />
                <RadioButton x:Name="AlbumViewListButton" Content="列表" GroupName="AlbumViewMode" Style="{StaticResource Navigation.SegmentItem}" Checked="AlbumViewMode_Checked" AutomationProperties.Name="列表视图" />
              </StackPanel>
            </Border>
            <Border Padding="10,3" Margin="12,0,0,0" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHigh}" VerticalAlignment="Center">
              <TextBlock Text="{Binding Photos.Count, StringFormat={}{0} 张}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
            </Border>
          </DockPanel>

          <Grid Grid.Row="1">
            <ScrollViewer x:Name="AlbumPhotoGridPanel" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Photos}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type albums:CustomAlbumPhoto}">
                    <Border Width="140" Height="168" Margin="0,0,12,12" Padding="6" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.ContainerLow}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="AlbumPhoto_Click">
                      <StackPanel>
                        <Border Height="122" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Brush.Surface.Container}" ClipToBounds="True">
                          <Grid>
                            <Path Data="{StaticResource Icon.Library}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.4" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Image Source="{Binding FullPath, Converter={StaticResource PathThumb}}" Stretch="UniformToFill" />
                          </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,7,2,0" ToolTip="{Binding Name}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <ScrollViewer x:Name="AlbumPhotoListPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <ItemsControl ItemsSource="{Binding Photos}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type albums:CustomAlbumPhoto}">
                    <Border Margin="0,0,0,8" Padding="8,8,14,8" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLow}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="AlbumPhoto_Click">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Brush.Surface.Container}" ClipToBounds="True">
                          <Grid>
                            <Path Data="{StaticResource Icon.Library}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Image Source="{Binding FullPath, Converter={StaticResource PathThumb}, ConverterParameter=96}" Stretch="UniformToFill" />
                          </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource Typography.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="14,0,12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Length, Converter={StaticResource FileSize}}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}" VerticalAlignment="Center" Width="80" TextAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,28">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPhotos}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="该文件夹中没有可显示的图片。" Foreground="{DynamicResource Brush.Text.Secondary}" />
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- Inspector：选中照片 EXIF -->
      <Border Grid.Column="2" Style="{StaticResource Layout.Section}">
        <Grid>
          <StackPanel x:Name="InspectorEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Border Width="48" Height="48" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.Container}" HorizontalAlignment="Center">
              <Path Data="{StaticResource Icon.Album}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.6" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
            <TextBlock Text="未选择照片" Style="{StaticResource Inspector.Header}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="在照片网格或列表中点击一张照片，这里会显示它的拍摄信息。" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" FontSize="{StaticResource Typography.BodySmall}" Margin="0,8,0,0" />
          </StackPanel>
          <ScrollViewer x:Name="InspectorContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <Border Height="130" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Container}" ClipToBounds="True">
                <Grid>
                  <Path Data="{StaticResource Icon.Library}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.4" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  <Image x:Name="InspectorThumb" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <TextBlock x:Name="InspectorPhotoName" Style="{StaticResource Inspector.Header}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <TextBlock Text="文件信息" Style="{StaticResource Inspector.SectionLabel}" Margin="0,12,0,8" />
              <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="66" Text="尺寸" Style="{StaticResource Inspector.FieldLabel}" /><TextBlock x:Name="InspectorDimensions" Text="未记录" Style="{StaticResource Inspector.FieldValue}" /></DockPanel>
              <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="66" Text="拍摄时间" Style="{StaticResource Inspector.FieldLabel}" /><TextBlock x:Name="InspectorTakenAt" Text="未记录" Style="{StaticResource Inspector.FieldValue}" /></DockPanel>
              <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="66" Text="相机" Style="{StaticResource Inspector.FieldLabel}" /><TextBlock x:Name="InspectorCamera" Text="未记录" Style="{StaticResource Inspector.FieldValue}" /></DockPanel>
              <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="66" Text="镜头" Style="{StaticResource Inspector.FieldLabel}" /><TextBlock x:Name="InspectorLens" Text="未记录" Style="{StaticResource Inspector.FieldValue}" /></DockPanel>
              <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="66" Text="ISO" Style="{StaticResource Inspector.FieldLabel}" /><TextBlock x:Name="InspectorIso" Text="未记录" Style="{StaticResource Inspector.FieldValue}" /></DockPanel>
              <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="66" Text="文件大小" Style="{StaticResource Inspector.FieldLabel}" /><TextBlock x:Name="InspectorFileSize" Text="未记录" Style="{StaticResource Inspector.FieldValue}" /></DockPanel>
              <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="66" Text="所属相册" Style="{StaticResource Inspector.FieldLabel}" /><TextBlock x:Name="InspectorAlbum" Text="未记录" Style="{StaticResource Inspector.FieldValue}" /></DockPanel>
              <Separator Margin="0,10,0,12" Style="{DynamicResource Separator.Menu}" />
              <TextBlock Text="操作" Style="{StaticResource Inspector.SectionLabel}" Margin="0,0,0,8" />
              <WrapPanel>
                <Button Content="打开原图" Style="{StaticResource Button.Toolbar}" Margin="0,0,6,6" Click="Inspector_OpenOriginal" />
                <Button Content="复制路径" Style="{StaticResource Button.Toolbar}" Margin="0,0,6,6" Click="Inspector_CopyPath" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- FAB：新建相册（仅总览可见） -->
    <Button x:Name="AlbumFab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Style="{StaticResource Button.Fab}" Click="AddFolder_Click" ToolTip="新建相册" AutomationProperties.Name="新建相册">
      <Path Data="{StaticResource Icon.Plus}" Stroke="{DynamicResource Brush.OnPrimary}" StrokeThickness="2.2" Width="24" Height="24" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Button>
  </Grid>
  </Border>
</UserControl>
