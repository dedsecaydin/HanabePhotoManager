<UserControl x:Class="HanabePhotoManager.App.Cloud.CloudPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid Background="{DynamicResource Brush.Background.Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{DynamicResource Toolbar.Container}" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Button Content="后退" Style="{DynamicResource Button.Toolbar}" Margin="0,0,4,0" Click="BrowserBack_Click"/>
        <Button Content="前进" Style="{DynamicResource Button.Toolbar}" Click="BrowserForward_Click"/>
        <Button Content="刷新" Style="{DynamicResource Button.Toolbar}" Margin="4,0,0,0" Click="BrowserRefresh_Click"/>
        <Button Content="首页" Style="{DynamicResource Button.Toolbar}" Margin="4,0,0,0" Click="BrowserHome_Click"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Style="{DynamicResource Card.Default}" Padding="0" ClipToBounds="True">
      <Grid>
        <wv2:WebView2 Name="CloudLoginBrowser" Visibility="Collapsed"/>
        <Border x:Name="CloudStatusPanel" Style="{DynamicResource Status.Panel}"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24">
          <StackPanel>
            <TextBlock x:Name="CloudStatusTitle" Text="正在加载云服务"
                       Style="{DynamicResource Status.Title}" TextAlignment="Center"/>
            <TextBlock x:Name="CloudStatusDescription" Text="正在准备安全的内嵌浏览器，请稍候。"
                       Style="{DynamicResource Status.Description}" TextAlignment="Center"/>
            <Button x:Name="CloudRetryButton" Content="重试" Style="{DynamicResource Button.Primary}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"
                    Click="CloudRetry_Click"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
