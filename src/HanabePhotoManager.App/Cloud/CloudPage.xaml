<UserControl x:Class="HanabePhotoManager.App.Cloud.CloudPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cloud="clr-namespace:HanabePhotoManager.App.Cloud"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <UserControl.Resources>
    <cloud:PercentToArcGeometryConverter x:Key="PercentToArc"/>
    <Style x:Key="CloudStatBlock" TargetType="Border">
      <Setter Property="Padding" Value="6,10"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Container}"/>
    </Style>
    <Style x:Key="CloudTqIcon" TargetType="Border">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Brush.Background.Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="320"/>
    </Grid.ColumnDefinitions>

    <!-- ═══════ 主区：内嵌浏览器 ═══════ -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{DynamicResource Toolbar.Container}" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <Button Content="后退" Style="{DynamicResource Button.Toolbar}" Margin="0,0,4,0" Click="BrowserBack_Click"/>
          <Button Content="前进" Style="{DynamicResource Button.Toolbar}" Click="BrowserForward_Click"/>
          <Button Content="刷新" Style="{DynamicResource Button.Toolbar}" Margin="4,0,0,0" Click="BrowserRefresh_Click"/>
          <Button Content="首页" Style="{DynamicResource Button.Toolbar}" Margin="4,0,0,0" Click="BrowserHome_Click"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{DynamicResource Card.Default}" Padding="0" ClipToBounds="True">
        <Grid>
          <wv2:WebView2 Name="CloudLoginBrowser" Visibility="Collapsed"/>
          <Border x:Name="CloudStatusPanel" Style="{DynamicResource Status.Panel}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24">
            <StackPanel>
              <TextBlock x:Name="CloudStatusTitle" Text="正在加载云服务"
                         Style="{DynamicResource Status.Title}" TextAlignment="Center"/>
              <TextBlock x:Name="CloudStatusDescription" Text="正在准备安全的内嵌浏览器，请稍候。"
                         Style="{DynamicResource Status.Description}" TextAlignment="Center"/>
              <Button x:Name="CloudRetryButton" Content="重试" Style="{DynamicResource Button.Primary}"
                      HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"
                      Click="CloudRetry_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ═══════ Inspector：云盘总览 + 传输队列（真实绑定 CloudHubViewModel） ═══════ -->
    <Border Grid.Column="2" Style="{DynamicResource Inspector.Panel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border x:Name="CloudOverviewInspector" Padding="12" CornerRadius="{DynamicResource Radius.Control}"
                  Background="{DynamicResource Brush.Surface.Container}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="44" Height="44" CornerRadius="{DynamicResource Radius.Full}"
                      Background="{DynamicResource Brush.PrimaryContainer}" VerticalAlignment="Center">
                <TextBlock Text="云" Foreground="{DynamicResource Brush.OnPrimaryContainer}" FontSize="{DynamicResource Typography.TitleSmall}" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AccountTitle}" Style="{DynamicResource Inspector.Header}"/>
                <TextBlock Text="{Binding AccountSubtitle}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Typography.Caption}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Border Grid.Column="2" Padding="6,4" CornerRadius="{DynamicResource Radius.Full}" VerticalAlignment="Center">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerHigh}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAccountConnected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding AccountBadgeText}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                      <Setter Property="FontSize" Value="{DynamicResource Typography.Caption}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAccountConnected}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimaryContainer}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </Grid>
          </Border>

          <Button x:Name="QuarkLoginButton" Content="登录夸克网盘" Style="{DynamicResource Button.Primary}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,12" Visibility="Collapsed"
                  Click="QuarkLogin_Click"/>

          <TextBlock Text="云存储总览" Style="{DynamicResource Inspector.Header}"/>
          <TextBlock Text="容量使用 · 自动同步照片与视频" Style="{DynamicResource Status.Description}" Margin="0,2,0,12"/>

          <Grid Width="128" Height="128" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Ellipse Stroke="{DynamicResource Brush.Surface.ContainerHigh}" StrokeThickness="12" Fill="Transparent"/>
            <Path Stroke="{DynamicResource Brush.Primary}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="{Binding UsedPercent, Converter={StaticResource PercentToArc}}"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="{Binding UsedPercentText}" FontSize="{DynamicResource Typography.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding UsedBytesText}" FontSize="{DynamicResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding CapacityText}" Foreground="{DynamicResource Brush.Text.Secondary}"
                     FontSize="{DynamicResource Typography.BodySmall}" HorizontalAlignment="Center" Margin="0,0,0,14"/>

          <UniformGrid Columns="3">
            <Border Style="{StaticResource CloudStatBlock}" Margin="0,0,8,0">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="—" FontSize="{DynamicResource Typography.TitleSmall}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
                <TextBlock Text="已同步" FontSize="{DynamicResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CloudStatBlock}" Margin="4,0,4,0">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="—" FontSize="{DynamicResource Typography.TitleSmall}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
                <TextBlock Text="本月上传" FontSize="{DynamicResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CloudStatBlock}" Margin="8,0,0,0">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding ActiveTransferCount}" FontSize="{DynamicResource Typography.TitleSmall}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
                <TextBlock Text="传输中" FontSize="{DynamicResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Text="已同步与本月上传暂无统计源 · 传输中来自本地任务队列"
                     Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Typography.Caption}"
                     HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

          <DockPanel Margin="0,16,0,4">
            <TextBlock Text="传输队列" Style="{DynamicResource Inspector.Header}"/>
          </DockPanel>
          <TextBlock Text="上传 / 下载 / 同步 · 优先任务先执行" Style="{DynamicResource Status.Description}" Margin="0,2,0,6"/>

          <ItemsControl ItemsSource="{Binding TransferJobs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource CloudTqIcon}" Background="{DynamicResource Brush.PrimaryContainer}">
                    <TextBlock Text="⇅" Foreground="{DynamicResource Brush.OnPrimaryContainer}" FontWeight="Bold"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Typography.BodySmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    <ProgressBar Height="4" Maximum="1" Value="{Binding Progress}" Margin="0,5,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="{DynamicResource Typography.Caption}" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Margin="0,8,0,0" Padding="12" CornerRadius="{DynamicResource Radius.Control}"
                  Background="{DynamicResource Brush.Surface.Container}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasTransferJobs}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="暂无传输任务" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="本地任务队列为空 · 传输记录将显示在这里" FontSize="{DynamicResource Typography.Caption}"
                         Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>

          <TextBlock Text="说明" Style="{DynamicResource Inspector.SectionLabel}" Margin="0,16,0,6"/>
          <TextBlock Text="右侧云盘总览已接入 CloudHubViewModel：账户与容量来自当前网盘 provider 实时读取（GetAccountStateAsync），传输队列来自本地 JsonCloudTransferQueueStore。百度网盘需要已保存的 API 会话；夸克网盘基于官方 quark-drive CLI 读取真实账户状态（未授权时如实显示未登录，可点击“登录夸克网盘”按钮完成浏览器授权）。切换百度 / 夸克标签时自动刷新对应账户状态。"
                     Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" FontSize="{DynamicResource Typography.BodySmall}"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
