<Window x:Class="HanabePhotoManager.App.Collage.CollageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能拼图" Width="1100" Height="820" MinWidth="900" MinHeight="700"
        Style="{DynamicResource Dialog.Window}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Margin" Value="{StaticResource Spacing.Field.Gap}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Input.ComboBox}">
            <Setter Property="Margin" Value="{StaticResource Spacing.Field.Gap}"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource Input.Switch}">
            <Setter Property="Margin" Value="{StaticResource Spacing.Field.Gap}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="{DynamicResource Spacing.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300">
            <StackPanel x:Name="ControlsPanel">
                <TextBlock Text="智能拼图" Style="{DynamicResource Layout.PageTitle}"/>
                <TextBlock Text="选图 · 自动排版 · 微调 · 导出" Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="{DynamicResource Spacing.Row.Vertical.8}"/>
                <WrapPanel Margin="{DynamicResource Spacing.Row.Vertical.8}">
                    <Button Content="添加照片" Click="Add"/>
                    <Button Content="文件名排序" Click="NameSort"/>
                    <Button Content="拍摄时间排序" Click="TimeSort"/>
                    <CheckBox Content="锁定顺序" IsChecked="{Binding OrderLocked}"/>
                </WrapPanel>
                <WrapPanel Margin="{DynamicResource Spacing.Row.Vertical.8}">
                    <ComboBox x:Name="LayoutBox" Width="150" SelectedIndex="0" SelectionChanged="SettingsChanged"
                              AutomationProperties.Name="排版类型">
                        <ComboBoxItem Content="规则网格"/>
                        <ComboBoxItem Content="自适应行"/>
                        <ComboBoxItem Content="主图杂志"/>
                        <ComboBoxItem Content="长图"/>
                    </ComboBox>
                    <ComboBox x:Name="AspectBox" Width="135" SelectedIndex="0" SelectionChanged="AspectChanged"
                              AutomationProperties.Name="画布比例">
                        <ComboBoxItem Content="自由比例"/>
                        <ComboBoxItem Content="3:2"/>
                        <ComboBoxItem Content="4:3"/>
                        <ComboBoxItem Content="1:1"/>
                        <ComboBoxItem Content="9:16"/>
                    </ComboBox>
                    <CheckBox x:Name="CropBox" Click="SettingsChanged" Content="允许裁切" ToolTip="关闭时完整适配，不拉伸"/>
                    <CheckBox x:Name="FaceBox" Click="SettingsChanged" Content="人脸建议" ToolTip="启用裁切时参考本地检测的人脸位置"/>
                    <Button Content="生成 / 换一组" Click="Generate" Style="{DynamicResource Button.Primary}"/>
                </WrapPanel>
                <Expander Header="照片顺序与主图" Foreground="{DynamicResource Brush.Text.Primary}"
                          Margin="{DynamicResource Spacing.Row.Vertical.8}">
                    <WrapPanel Margin="{DynamicResource Spacing.Row.Vertical.8}">
                        <Button Content="设为主图" Click="Hero"/>
                        <Button Content="建议主图" Click="SuggestHero"/>
                        <Button Content="清除主图" Click="ClearHero"/>
                        <Button Content="上移" Click="Up"/>
                        <Button Content="下移" Click="Down"/>
                        <Button Content="交换两张" Click="Swap" ToolTip="按 Ctrl 选择两张后交换"/>
                        <Button Content="移除" Click="Remove"/>
                    </WrapPanel>
                </Expander>
                <Expander Header="高级 · 分辨率、留白与背景" Foreground="{DynamicResource Brush.Text.Primary}"
                          Margin="{DynamicResource Spacing.Row.Vertical.8}">
                    <WrapPanel Margin="{DynamicResource Spacing.Row.Vertical.8}">
                        <StackPanel Width="110" Margin="{DynamicResource Spacing.Field.Gap}">
                            <TextBlock Text="宽度（像素）" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="WidthBox" TextChanged="SettingsChanged" AutomationProperties.Name="宽度像素"/>
                        </StackPanel>
                        <StackPanel Width="110" Margin="{DynamicResource Spacing.Field.Gap}">
                            <TextBlock Text="高度（像素）" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="HeightBox" TextChanged="SettingsChanged" AutomationProperties.Name="高度像素"/>
                        </StackPanel>
                        <StackPanel Width="100" Margin="{DynamicResource Spacing.Field.Gap}">
                            <TextBlock Text="边距（像素）" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="MarginBox" TextChanged="SettingsChanged" AutomationProperties.Name="边距像素"/>
                        </StackPanel>
                        <StackPanel Width="100" Margin="{DynamicResource Spacing.Field.Gap}">
                            <TextBlock Text="间隔（像素）" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="GapBox" TextChanged="SettingsChanged" AutomationProperties.Name="间隔像素"/>
                        </StackPanel>
                        <StackPanel Width="140" Margin="{DynamicResource Spacing.Field.Gap}">
                            <TextBlock Text="背景颜色代码" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="BackgroundBox" TextChanged="SettingsChanged" AutomationProperties.Name="背景颜色代码"/>
                        </StackPanel>
                    </WrapPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="{DynamicResource Spacing.Row.Vertical.8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="照片 · 拖动调整顺序" Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="{DynamicResource Spacing.Row.Vertical.8}"/>
                <ListBox x:Name="PhotoList" Grid.Row="1" SelectionMode="Extended" ItemsSource="{Binding Photos}"
                         Style="{DynamicResource List.Default}" ItemContainerStyle="{DynamicResource ListItem.Default}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                         PreviewMouseLeftButtonDown="DragStart" MouseMove="DragMove" Drop="PhotoDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1" Margin="{DynamicResource Spacing.Inline.8}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <ComboBox x:Name="CandidateBox" SelectedIndex="0" SelectionChanged="CandidateChanged"
                          AutomationProperties.Name="排版候选">
                    <ComboBoxItem Content="候选 1"/>
                    <ComboBoxItem Content="候选 2"/>
                    <ComboBoxItem Content="候选 3"/>
                </ComboBox>
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Subtle}" ClipToBounds="True"
                        Padding="{DynamicResource Spacing.Card}">
                    <Viewbox><Canvas x:Name="Preview" Width="600" Height="400" ClipToBounds="True"/></Viewbox>
                </Border>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding HeroProvenance}" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
            <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"/>
            </ScrollViewer>
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="6" Maximum="100" Margin="{DynamicResource Spacing.Row.Vertical.8}"/>
            <WrapPanel Margin="{DynamicResource Spacing.Row.Vertical.8}">
                <ComboBox x:Name="FormatBox" Width="125" SelectedIndex="0" AutomationProperties.Name="导出格式">
                    <ComboBoxItem Content="JPG"/><ComboBoxItem Content="PNG"/><ComboBoxItem Content="TIFF"/>
                </ComboBox>
                <Button Content="选择文件夹并导出" Click="Export" Style="{DynamicResource Button.Primary}" Margin="{DynamicResource Spacing.Field.Gap}"/>
                <Button Content="取消任务" Click="Cancel"/>
            </WrapPanel>
            <TextBlock Text="人脸检测失败时采用中心裁切。ICC 输入统一至 sRGB，转换失败则停止导出；无配置输入按 sRGB 假定。"
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"/>
        </StackPanel>
    </Grid>
</Window>
