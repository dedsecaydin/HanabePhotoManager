<UserControl x:Class="HanabePhotoManager.App.Compression.CompressionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:watermark="clr-namespace:HanabePhotoManager.App.Watermark"
             xmlns:wechat="clr-namespace:HanabePhotoManager.App.WeChat"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="ImageToolTabItem" TargetType="{x:Type ListBoxItem}">
      <Setter Property="MinWidth" Value="126"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="TabSurface" CornerRadius="11" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/>
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Brush.Background.Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{DynamicResource Card.Default}" Padding="8" Margin="0,0,0,12">
      <ListBox x:Name="ImageToolModeTabs" ItemsSource="{Binding ToolModes}"
               SelectedValuePath="Value" SelectedValue="{Binding SelectedToolMode}"
               ItemContainerStyle="{StaticResource ImageToolTabItem}"
               Background="Transparent" BorderThickness="0" Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               KeyboardNavigation.DirectionalNavigation="Cycle">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid Grid.Row="1">
      <Grid.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Opacity" Value="0"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsFileOperationMode}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
              <DataTrigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
              </DataTrigger.EnterActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{DynamicResource Card.Default}">
          <StackPanel>
            <TextBlock Text="添加图片" Style="{DynamicResource Layout.SectionTitle}"/>
            <TextBlock Text="拖入图片或文件夹；文件夹会自动扫描全部子目录。拼图按队列顺序处理，不限制张数。" Style="{DynamicResource Status.Description}" Margin="0,6,0,16"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Content="选择图片" Style="{DynamicResource Button.Secondary}" Click="ChooseFiles_Click"/>
              <Button Grid.Column="1" Margin="8,0,0,0" Content="选择文件夹" Style="{DynamicResource Button.Secondary}" Click="ChooseFolder_Click"/>
            </Grid>
            <Button Margin="0,8,0,0" Content="清空列表" Style="{DynamicResource Button.Ghost}" Command="{Binding ClearCommand}"/>
          </StackPanel>
        </Border>

        <Border Margin="0,16,0,0">
          <Border.Style>
            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Card.Default}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Setter Property="Opacity" Value="0"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompressionMode}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                  <DataTrigger.EnterActions>
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
              <ComboBox Grid.ColumnSpan="2" HorizontalAlignment="Stretch" MaxWidth="Infinity"
                        Style="{DynamicResource Input.SettingsComboBox}" ItemsSource="{Binding TargetModes}"
                        DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TargetMode}"/>
              <TextBox Grid.Row="1" Margin="0,8,0,0" Style="{DynamicResource Input.TextBox}"
                       Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}"/>
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" MinWidth="0" MaxWidth="Infinity" HorizontalAlignment="Stretch"
                        Style="{DynamicResource Input.SettingsComboBox}" ItemsSource="{Binding TargetUnits}"
                        SelectedItem="{Binding TargetUnit}"/>
            </Grid>
            <TextBlock Text="保持原始像素尺寸，并优先选择满足大小上限的最高质量。" Style="{DynamicResource Status.Description}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Margin="0,16,0,0">
          <Border.Style>
            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Card.Default}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Setter Property="Opacity" Value="0"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCollageMode}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                  <DataTrigger.EnterActions>
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
                  </DataTrigger.EnterActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="保留每张图片原本大小；较窄或较矮的图片会居中，空白区域使用白色。" Style="{DynamicResource Status.Description}" Margin="0,0,0,12"/>
            <ComboBox ItemsSource="{Binding CollageOrientations}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding CollageOrientation}"
                      Style="{DynamicResource Input.SettingsComboBox}" HorizontalAlignment="Stretch" MaxWidth="Infinity"/>
            <TextBlock Margin="0,6,0,0" Opacity="0.72"><Run Text="纵向拼接"/><Run Text=" · "/><Run Text="横向拼接"/></TextBlock>
            <CheckBox Margin="0,14,0,0" Content="限制输出文件大小" IsChecked="{Binding CollageLimitOutputSize}"/>
            <Grid Margin="0,8,0,0" Visibility="{Binding CollageLimitOutputSize, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
              <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}"/>
              <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="0" MaxWidth="Infinity" HorizontalAlignment="Stretch"
                        Style="{DynamicResource Input.SettingsComboBox}" ItemsSource="{Binding TargetUnits}"
                        SelectedItem="{Binding TargetUnit}"/>
            </Grid>
            <TextBlock Text="限制大小只调整 JPEG 编码质量，不改变拼图像素尺寸。" Style="{DynamicResource Status.Description}" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>

        <Border Margin="0,16,0,0" Style="{DynamicResource Card.Default}">
          <StackPanel>
            <TextBlock Text="输出目录" Margin="0,0,0,6"/>
            <TextBox IsReadOnly="True" Style="{DynamicResource Input.TextBox}" Text="{Binding OutputDirectory}"/>
            <Button Margin="0,8,0,0" Content="选择输出目录" Style="{DynamicResource Button.Secondary}" Click="ChooseOutput_Click"/>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Content="开始压缩" Style="{DynamicResource Button.Primary}" Command="{Binding StartCommand}"
                      Visibility="{Binding IsCompressionMode, Converter={StaticResource BoolToVis}}"/>
              <Button Content="开始拼图" Style="{DynamicResource Button.Primary}" Command="{Binding StartCommand}"
                      Visibility="{Binding IsCollageMode, Converter={StaticResource BoolToVis}}"/>
              <Button Grid.Column="1" Margin="8,0,0,0" Content="取消" Style="{DynamicResource Button.Secondary}" Command="{Binding CancelCommand}"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

      <Border Grid.Column="2" Style="{DynamicResource Card.Default}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
          <StackPanel>
            <TextBlock Text="输入队列" Style="{DynamicResource Layout.SectionTitle}"/>
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding StatusText}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Items.Count, StringFormat={}{0:N0} 项}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding OriginalTotalBytes, StringFormat=原始 {0:N0} 字节}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
          </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,12">
          <ProgressBar Height="8" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}">
            <ProgressBar.Style>
              <Style TargetType="{x:Type ProgressBar}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="IsIndeterminate" Value="True"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <TextBlock Margin="0,6,0,0" Text="{Binding CurrentFile}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" Style="{DynamicResource List.Default}" ItemContainerStyle="{DynamicResource ListItem.Default}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="移除" Style="{DynamicResource Button.Toolbar}"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SizeText}" FontSize="{DynamicResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Results}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" Foreground="{DynamicResource Brush.Text.Secondary}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Opacity" Value="0"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsWatermarkMode}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
              <DataTrigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
              </DataTrigger.EnterActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <watermark:WatermarkPage DataContext="{Binding DataContext.Watermark, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Opacity" Value="0"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsWeChatSendMode}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
              <DataTrigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
              </DataTrigger.EnterActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <wechat:WeChatSenderView DataContext="{Binding WeChatSender}"/>
    </Grid>
  </Grid>
</UserControl>
