<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HanabePhotoManager.App.Compression.CompressionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid Background="{DynamicResource Brush.Background.Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{DynamicResource Card.Default}">
          <StackPanel>
            <TextBlock Text="添加图片" Style="{DynamicResource Layout.SectionTitle}" />
            <TextBlock Text="拖入图片或文件夹；文件夹会自动扫描全部子目录。" Style="{DynamicResource Status.Description}" Margin="0,6,0,16" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button Content="选择图片" Style="{DynamicResource Button.Secondary}" Click="ChooseFiles_Click" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="选择文件夹" Style="{DynamicResource Button.Secondary}" Click="ChooseFolder_Click" />
            </Grid>
            <Button Margin="0,8,0,0" Content="清空列表" Style="{DynamicResource Button.Ghost}" Command="{Binding ClearCommand}" />
          </StackPanel>
        </Border>
        <Border Margin="0,16,0,0" Style="{DynamicResource Card.Default}">
          <StackPanel>
            <TextBlock Text="压缩目标" Style="{DynamicResource Layout.SectionTitle}" />
            <Grid Margin="0,12,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="92" />
              </Grid.ColumnDefinitions>
              <ComboBox Grid.ColumnSpan="2" HorizontalAlignment="Stretch" MaxWidth="Infinity" Style="{DynamicResource Input.SettingsComboBox}" ItemsSource="{Binding TargetModes}" SelectedValuePath="Value" SelectedValue="{Binding TargetMode}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Grid.Row="1" Margin="0,8,0,0" Style="{DynamicResource Input.TextBox}" Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}" />
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" MinWidth="0" MaxWidth="Infinity" HorizontalAlignment="Stretch" Style="{DynamicResource Input.SettingsComboBox}" ItemsSource="{Binding TargetUnits}" SelectedItem="{Binding TargetUnit}" />
            </Grid>
            <TextBlock Text="保持原始像素尺寸，并优先选择满足大小上限的最高质量。" Style="{DynamicResource Status.Description}" Margin="0,8,0,0" />
            <TextBlock Text="输出目录" Margin="0,16,0,6" />
            <TextBox IsReadOnly="True" Style="{DynamicResource Input.TextBox}" Text="{Binding OutputDirectory}" />
            <Button Margin="0,8,0,0" Content="选择输出目录" Style="{DynamicResource Button.Secondary}" Click="ChooseOutput_Click" />
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button Content="开始压缩" Style="{DynamicResource Button.Primary}" Command="{Binding StartCommand}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="取消" Style="{DynamicResource Button.Secondary}" Command="{Binding CancelCommand}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Column="2" Style="{DynamicResource Card.Default}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
          <StackPanel>
            <TextBlock Text="压缩队列" Style="{DynamicResource Layout.SectionTitle}" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding StatusText}" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Items.Count, StringFormat={}{0:N0} 项}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding OriginalTotalBytes, StringFormat=原始 {0:N0} 字节}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
          </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,12">
          <ProgressBar Height="8" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
          <TextBlock Margin="0,6,0,0" Text="{Binding CurrentFile}" Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" Style="{DynamicResource List.Default}" ItemContainerStyle="{DynamicResource ListItem.Default}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="移除" Style="{DynamicResource Button.Toolbar}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SizeText}" FontSize="{DynamicResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Results}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Brush.Text.Secondary}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
