<UserControl x:Class="HanabePhotoManager.App.Compression.CompressionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:watermark="clr-namespace:HanabePhotoManager.App.Watermark"
             xmlns:wechat="clr-namespace:HanabePhotoManager.App.WeChat"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="ImageToolTabItem" TargetType="{x:Type ListBoxItem}">
      <Setter Property="MinWidth" Value="126"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="TabSurface" CornerRadius="999" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Brush.SecondaryContainer}"/>
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.OnSecondaryContainer}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolCardButton" TargetType="Button">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLow}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Card" CornerRadius="{StaticResource Radius.Container}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" ClipToBounds="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Container}"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Outline}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.ContainerHigh}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolStatBlock" TargetType="Border">
      <Setter Property="Padding" Value="10,14"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Container}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Brush.Background.Canvas}">

    <!-- ═══════════ 视图 1：工具卡片网格 ═══════════ -->
    <ScrollViewer x:Name="ToolGridHost" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="图片小工具" Style="{DynamicResource Layout.PageTitle}"/>
        <TextBlock Text="批量压缩、拼接与水印工具，以及微信原图发送。选择一项开始。"
                   Style="{DynamicResource Status.Description}" Margin="0,8,0,20"/>
        <WrapPanel>
          <Button Style="{StaticResource ToolCardButton}" Tag="Compression" Click="ToolCard_Click" Width="252" Margin="0,0,14,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{DynamicResource Brush.PrimaryContainer}" CornerRadius="28,28,0,0">
                <Viewbox Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource Icon.Compress}" Stroke="{DynamicResource Brush.OnPrimaryContainer}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                </Viewbox>
              </Border>
              <StackPanel Grid.Row="1" Margin="18,14,18,18">
                <TextBlock Text="图片压缩" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold"/>
                <TextBlock Text="保持原始像素尺寸，按「每张上限」或「整批总大小」压缩到目标体积，自动挑选最高可用质量。"
                           Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Style="{StaticResource ToolCardButton}" Tag="Collage" Click="ToolCard_Click" Width="252" Margin="0,0,14,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{DynamicResource Brush.TertiaryContainer}" CornerRadius="28,28,0,0">
                <Viewbox Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource Icon.Album}" Stroke="{DynamicResource Brush.OnTertiaryContainer}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                </Viewbox>
              </Border>
              <StackPanel Grid.Row="1" Margin="18,14,18,18">
                <TextBlock Text="图片拼图" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold"/>
                <TextBlock Text="不限张数按队列顺序纵向 / 横向拼接，保留每张图片原本大小，可选限制输出文件大小。"
                           Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Style="{StaticResource ToolCardButton}" Tag="Watermark" Click="ToolCard_Click" Width="252" Margin="0,0,14,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{DynamicResource Brush.SecondaryContainer}" CornerRadius="28,28,0,0">
                <Viewbox Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource Icon.Watermark}" Stroke="{DynamicResource Brush.OnSecondaryContainer}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                </Viewbox>
              </Border>
              <StackPanel Grid.Row="1" Margin="18,14,18,18">
                <TextBlock Text="批量水印" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold"/>
                <TextBlock Text="透明 PNG 签名或铺满水印，预览中拖拽定位，支持单张独立参数与文件夹批处理，保留 EXIF / GPS / ICC。"
                           Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Style="{StaticResource ToolCardButton}" Tag="WeChat" Click="ToolCard_Click" Width="252" Margin="0,0,14,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{DynamicResource Brush.PrimaryContainer}" CornerRadius="28,28,0,0">
                <Viewbox Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource Icon.Export}" Stroke="{DynamicResource Brush.OnPrimaryContainer}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                </Viewbox>
              </Border>
              <StackPanel Grid.Row="1" Margin="18,14,18,18">
                <TextBlock Text="微信发送" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold"/>
                <TextBlock Text="原图发送队列，每批最多 9 张、不压缩不转码；自动检测微信、定位目标聊天，结果不确定时安全暂停。"
                           Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ═══════════ 视图 2：工具详情工作台 ═══════════ -->
    <Grid x:Name="ToolDetailHost" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{DynamicResource Card.Default}" Padding="8" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Content="← 返回工具" Style="{DynamicResource Button.Secondary}" Click="BackToGrid_Click" Margin="0,0,12,0"/>
          <ListBox Grid.Column="1" x:Name="ImageToolModeTabs" ItemsSource="{Binding ToolModes}"
                   SelectedValuePath="Value" SelectedValue="{Binding SelectedToolMode}"
                   ItemContainerStyle="{StaticResource ImageToolTabItem}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   KeyboardNavigation.DirectionalNavigation="Cycle">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

        <Grid>
          <Grid>
            <Grid.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFileOperationMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                      <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Motion.Duration.Normal}" EasingFunction="{StaticResource Motion.Easing.Standard}"/></Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{DynamicResource Card.Default}">
                  <StackPanel>
                    <TextBlock Text="添加图片" Style="{DynamicResource Layout.SectionTitle}"/>
                    <TextBlock Text="拖入图片或文件夹；文件夹会自动扫描全部子目录。拼图按队列顺序处理，不限制张数。" Style="{DynamicResource Status.Description}" Margin="0,6,0,16"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Button Content="选择图片" Style="{DynamicResource Button.Secondary}" Click="ChooseFiles_Click"/>
                      <Button Grid.Column="1" Margin="8,0,0,0" Content="选择文件夹" Style="{DynamicResource Button.Secondary}" Click="ChooseFolder_Click"/>
                    </Grid>
                    <Button Margin="0,8,0,0" Content="清空列表" Style="{DynamicResource Button.Ghost}" Command="{Binding ClearCommand}"/>
                  </StackPanel>
                </Border>

                <Border Margin="0,16,0,0">
                  <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Card.Default}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Setter Property="Opacity" Value="0"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompressionMode}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                          <DataTrigger.EnterActions>
                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Motion.Duration.Normal}" EasingFunction="{StaticResource Motion.Easing.Standard}"/></Storyboard></BeginStoryboard>
                          </DataTrigger.EnterActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="压缩设置" Style="{DynamicResource Layout.SectionTitle}"/>
                    <Grid Margin="0,10,0,0">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                      <ComboBox Grid.ColumnSpan="2" HorizontalAlignment="Stretch" MaxWidth="Infinity"
                                Style="{DynamicResource Input.SettingsComboBox}" ItemsSource="{Binding TargetModes}"
                                DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TargetMode}"/>
                      <TextBox Grid.Row="1" Margin="0,8,0,0" Style="{DynamicResource Input.TextBox}"
                               Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}"/>
                      <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" MinWidth="0" MaxWidth="Infinity" HorizontalAlignment="Stretch"
                                Style="{DynamicResource Input.SettingsComboBox}" ItemsSource="{Binding TargetUnits}"
                                SelectedItem="{Binding TargetUnit}"/>
                    </Grid>
                    <TextBlock Text="保持原始像素尺寸，并优先选择满足大小上限的最高质量。" Style="{DynamicResource Status.Description}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>

                <Border Margin="0,16,0,0">
                  <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Card.Default}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Setter Property="Opacity" Value="0"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCollageMode}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                          <DataTrigger.EnterActions>
                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Motion.Duration.Normal}" EasingFunction="{StaticResource Motion.Easing.Standard}"/></Storyboard></BeginStoryboard>
                          </DataTrigger.EnterActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="拼图设置" Style="{DynamicResource Layout.SectionTitle}"/>
                    <TextBlock Text="保留每张图片原本大小；较窄或较矮的图片会居中，空白区域使用白色。" Style="{DynamicResource Status.Description}" Margin="0,6,0,12"/>
                    <ComboBox ItemsSource="{Binding CollageOrientations}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding CollageOrientation}"
                              Style="{DynamicResource Input.SettingsComboBox}" HorizontalAlignment="Stretch" MaxWidth="Infinity"/>
                    <TextBlock Margin="0,6,0,0" Opacity="0.72"><Run Text="纵向拼接"/><Run Text=" · "/><Run Text="横向拼接"/></TextBlock>
                    <CheckBox Margin="0,14,0,0" Content="限制输出文件大小" IsChecked="{Binding CollageLimitOutputSize}"/>
                    <Grid Margin="0,8,0,0" Visibility="{Binding CollageLimitOutputSize, Converter={StaticResource BoolToVis}}">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                      <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}"/>
                      <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="0" MaxWidth="Infinity" HorizontalAlignment="Stretch"
                                Style="{DynamicResource Input.SettingsComboBox}" ItemsSource="{Binding TargetUnits}"
                                SelectedItem="{Binding TargetUnit}"/>
                    </Grid>
                    <TextBlock Text="限制大小只调整 JPEG 编码质量，不改变拼图像素尺寸。" Style="{DynamicResource Status.Description}" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Style="{DynamicResource Card.Default}">
                  <StackPanel>
                    <TextBlock Text="输出目录" Style="{DynamicResource Layout.SectionTitle}"/>
                    <TextBox IsReadOnly="True" Style="{DynamicResource Input.TextBox}" Text="{Binding OutputDirectory}" Margin="0,10,0,0"/>
                    <Button Margin="0,8,0,0" Content="选择输出目录" Style="{DynamicResource Button.Secondary}" Click="ChooseOutput_Click"/>
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Button Content="开始压缩" Style="{DynamicResource Button.Primary}" Command="{Binding StartCommand}"
                              Visibility="{Binding IsCompressionMode, Converter={StaticResource BoolToVis}}"/>
                      <Button Content="开始拼图" Style="{DynamicResource Button.Primary}" Command="{Binding StartCommand}"
                              Visibility="{Binding IsCollageMode, Converter={StaticResource BoolToVis}}"/>
                      <Button Grid.Column="1" Margin="8,0,0,0" Content="取消" Style="{DynamicResource Button.Secondary}" Command="{Binding CancelCommand}"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{DynamicResource Card.Default}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                  <StackPanel>
                    <TextBlock Text="输入队列" Style="{DynamicResource Layout.SectionTitle}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding StatusText}"/>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Items.Count, StringFormat={}{0:N0} 项}" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OriginalTotalBytes, StringFormat=原始 {0:N0} 字节}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                  </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,16,0,12">
                  <ProgressBar Height="8" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}">
                    <ProgressBar.Style>
                      <Style TargetType="{x:Type ProgressBar}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsScanning}" Value="True">
                            <Setter Property="IsIndeterminate" Value="True"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ProgressBar.Style>
                  </ProgressBar>
                  <TextBlock Margin="0,6,0,0" Text="{Binding CurrentFile}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Items}" Style="{DynamicResource List.Default}" ItemContainerStyle="{DynamicResource ListItem.Default}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="移除" Style="{DynamicResource Button.Toolbar}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding SizeText}" FontSize="{DynamicResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" IsHitTestVisible="False">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="暂未添加压缩图片" FontSize="{DynamicResource Typography.BodySmall}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="选择图片或文件夹后加入队列。" Foreground="{DynamicResource Brush.Text.Tertiary}"
                               FontSize="{DynamicResource Typography.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Results}" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" Foreground="{DynamicResource Brush.Text.Secondary}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </Grid>

          <Grid>
            <Grid.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsWatermarkMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                      <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Motion.Duration.Normal}" EasingFunction="{StaticResource Motion.Easing.Standard}"/></Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <watermark:WatermarkPage DataContext="{Binding DataContext.Watermark, RelativeSource={RelativeSource AncestorType=Window}}"/>
          </Grid>

          <Grid>
            <Grid.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsWeChatSendMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                      <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Motion.Duration.Normal}" EasingFunction="{StaticResource Motion.Easing.Standard}"/></Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <wechat:WeChatSenderView DataContext="{Binding WeChatSender}"/>
          </Grid>
        </Grid>

        <Border Grid.Column="2">
          <Border.Style>
            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Inspector.Panel}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFileOperationMode}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="运行统计" Style="{DynamicResource Inspector.Header}"/>
              <TextBlock Text="当前工具的处理进度与结果摘要" Style="{DynamicResource Status.Description}" Margin="0,4,0,16"/>
              <UniformGrid Columns="2">
                <Border Style="{StaticResource ToolStatBlock}" Margin="0,0,8,8">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Items.Count}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="输入项" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolStatBlock}" Margin="8,0,0,8">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OriginalTotalBytes, StringFormat={}{0:N0}}" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="原始字节" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolStatBlock}" Margin="0,0,8,8">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OutputTotalBytes, StringFormat={}{0:N0}}" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="输出字节" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolStatBlock}" Margin="8,0,0,8">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="进度" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <TextBlock Text="处理结果" Style="{DynamicResource Inspector.SectionLabel}" Margin="0,12,0,6"/>
              <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,3"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="提示" Style="{DynamicResource Inspector.SectionLabel}" Margin="0,14,0,6"/>
              <TextBlock Text="保持原始像素尺寸的压缩不会改变照片分辨率，仅优化编码体积；适合微信 / 网盘分享前批量瘦身。"
                         Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" FontSize="{StaticResource Typography.BodySmall}"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
