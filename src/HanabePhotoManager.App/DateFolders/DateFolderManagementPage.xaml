<UserControl x:Class="HanabePhotoManager.App.DateFolders.DateFolderManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:datefolders="clr-namespace:HanabePhotoManager.App.DateFolders">
  <UserControl.Resources>
    <Thickness x:Key="DateHeat.CellGap">2</Thickness>
    <Thickness x:Key="DateHeat.Zero">0</Thickness>
    <Thickness x:Key="DateHeat.MonthGap">0,0,12,12</Thickness>
    <Thickness x:Key="DateHeat.CardPadding">12,10</Thickness>
    <Thickness x:Key="DateHeat.ColumnGap">0,0,16,0</Thickness>
  </UserControl.Resources>
  <Border Style="{StaticResource Layout.PagePanel}" Padding="{StaticResource Spacing.Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Margin="{StaticResource Spacing.Stack.16}">
        <StackPanel>
          <TextBlock Text="Days to remember" Style="{DynamicResource Layout.Eyebrow}" />
          <TextBlock Text="日期文件夹" Style="{StaticResource Layout.PageTitle}" />
          <TextBlock Text="编辑备注后统一保存；日期与文件夹路径始终只读。"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     FontSize="{StaticResource Typography.BodySmall}"
                     Margin="{StaticResource Spacing.Stack.4}" />
          <TextBlock Text="{Binding Summary, Mode=OneWay}"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     FontSize="{StaticResource Typography.Caption}"
                     Margin="{StaticResource Spacing.Stack.8}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="刷新" Style="{StaticResource Button.Secondary}"
                  Command="{Binding RefreshCommand}" AutomationProperties.Name="刷新日期文件夹" />
          <Button Content="保存全部" Style="{StaticResource Button.Primary}" Margin="{StaticResource Spacing.Inline.8}"
                  Command="{Binding SaveAllCommand}" AutomationProperties.Name="保存全部备注更改" />
        </StackPanel>
      </DockPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="200" MaxWidth="392" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 月历热力图：有内容的日期为粉色，有备注的更亮；灰色日期没有文件夹，不能点 -->
        <ScrollViewer Grid.RowSpan="2" Margin="{StaticResource DateHeat.ColumnGap}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="日期月历热力图">
          <ItemsControl ItemsSource="{Binding HeatMonths}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type datefolders:DateHeatMonth}">
                <Border Width="170" Margin="{StaticResource DateHeat.MonthGap}" Padding="{StaticResource DateHeat.CardPadding}" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Glass.Surface}" BorderBrush="{DynamicResource Brush.Glass.Stroke}" BorderThickness="{StaticResource BorderThickness.Glass}">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding FolderCount, StringFormat={}{0} 天}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                      <TextBlock Text="{Binding Title}" FontWeight="{StaticResource Typography.FontWeight.SemiBold}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Cells}" Margin="{StaticResource Spacing.Stack.8}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type datefolders:DateHeatCell}">
                          <Button x:Name="HeatCell" Height="20" Margin="{StaticResource DateHeat.CellGap}" Padding="{StaticResource DateHeat.Zero}" IsEnabled="{Binding HasFolder}" ToolTip="{Binding ToolTipText}" ToolTipService.ShowOnDisabled="True"
                                  Command="{Binding DataContext.SelectHeatCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Chip" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Brush.Surface.ContainerHigh}">
                                  <TextBlock x:Name="DayText" Text="{Binding Day}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                  <DataTrigger Binding="{Binding HasFolder}" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter TargetName="Chip" Property="Opacity" Value="0.55" />
                                    <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding HasRemark}" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Primary.Fill}" />
                                    <Setter TargetName="Chip" Property="Opacity" Value="1" />
                                  </DataTrigger>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Opacity" Value="1" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Button.Template>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="0" Grid.Column="1" Margin="{StaticResource Spacing.Stack.8}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="128" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="日期" Style="{StaticResource Layout.SettingsFieldLabel}" />
          <TextBlock Grid.Column="1" Text="文件夹路径" Style="{StaticResource Layout.SettingsFieldLabel}" />
          <TextBlock Grid.Column="2" Text="备注" Style="{StaticResource Layout.SettingsFieldLabel}" />
          <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource Layout.SettingsFieldLabel}" />
        </Grid>
        <ListBox x:Name="DateFolderList" Grid.Row="1" Grid.Column="1" Style="{StaticResource List.Default}" ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionChanged="DateFolderList_SelectionChanged"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" AutomationProperties.Name="日期文件夹备注列表">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type datefolders:DateFolderItemViewModel}">
              <Border Padding="{StaticResource Spacing.Row.Vertical.8}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="{StaticResource BorderThickness.Divider.Bottom}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="128" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Month, StringFormat={}{0:00}}"
                               FontWeight="{StaticResource Typography.FontWeight.SemiBold}" />
                    <TextBlock Text="." FontWeight="{StaticResource Typography.FontWeight.SemiBold}" />
                    <TextBlock Text="{Binding Day, StringFormat={}{0:00}}"
                               FontWeight="{StaticResource Typography.FontWeight.SemiBold}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Margin="{StaticResource Spacing.Field.Gap}" Style="{StaticResource Input.TextBox}"
                           Text="{Binding FullPath, Mode=OneWay}" IsReadOnly="True"
                           AutomationProperties.Name="日期文件夹路径" />
                  <TextBox Grid.Column="2" Margin="{StaticResource Spacing.Field.Gap}" Style="{StaticResource Input.TextBox}"
                           Text="{Binding EditedRemark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="日期文件夹备注" />
                  <TextBlock Grid.Column="3" Text="{Binding StatusText, Mode=OneWay}"
                             VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Border>
</UserControl>

