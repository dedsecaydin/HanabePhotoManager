<Window x:Class="HanabePhotoManager.App.DeleteConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="删除确认" Width="520" SizeToContent="Height" ResizeMode="NoResize" Style="{StaticResource Dialog.Window}" WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
  <Border Margin="16" Style="{StaticResource Dialog.Surface}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="确认删除" Style="{StaticResource Dialog.Title}"/><TextBlock Text="Hanabe Photo Manager" Style="{StaticResource Dialog.Body}" Margin="0,4,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="×" Width="36" Height="36" ToolTip="取消" Style="{StaticResource Button.Ghost}" Click="Cancel_Click"/>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,20,0,20">
        <TextBlock Name="MessageText" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Border Margin="0,16,0,0" Style="{StaticResource Card.Subtle}" Padding="14,12"><StackPanel><TextBlock Name="CountText" Foreground="{DynamicResource Brush.Status.Danger}" FontWeight="SemiBold"/><TextBlock Text="文件会进入 Windows 回收站，之后仍可恢复。" Style="{StaticResource Dialog.Body}" Margin="0,4,0,0"/></StackPanel></Border>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Esc 取消" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" VerticalAlignment="Center"/>
        <Button x:Name="CancelButton" Grid.Column="1" Content="取消" IsCancel="True" MinWidth="108" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Click="Cancel_Click"/>
        <Button Grid.Column="2" Content="移入回收站" MinWidth="138" Style="{StaticResource Button.Danger}" Click="Confirm_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
