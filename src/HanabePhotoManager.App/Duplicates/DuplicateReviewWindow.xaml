<Window x:Class="HanabePhotoManager.App.DuplicateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重复内容审查" Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource Dialog.Window}">
  <Border Margin="16" Style="{DynamicResource Dialog.Surface}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="发现重复内容" Style="{DynamicResource Dialog.Title}" />
        <TextBlock Name="SummaryText" Text="以下文件内容相同，勾选要删除的文件（取消勾选=保留）。"
                   Style="{DynamicResource Dialog.Body}" Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
        <StackPanel Name="GroupsPanel" />
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="跳过" Width="88" Margin="0,0,8,0"
                Style="{DynamicResource Button.Secondary}" Click="Skip_Click" />
        <Button Content="合并/删除选中" Width="132"
                Style="{DynamicResource Button.Primary}" Click="Delete_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
