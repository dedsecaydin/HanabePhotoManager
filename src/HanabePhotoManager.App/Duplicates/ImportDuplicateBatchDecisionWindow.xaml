<Window x:Class="HanabePhotoManager.App.Duplicates.ImportDuplicateBatchDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检测到重复导入" Width="680" Height="500" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource Dialog.Window}">
  <Border Margin="16" Style="{DynamicResource Dialog.Surface}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="检测到内容完全相同的文件" Style="{DynamicResource Dialog.Title}"/>
        <TextBlock Name="DescriptionText" Style="{DynamicResource Dialog.Body}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Row="1">
        <RadioButton Name="SkipAllOption" IsChecked="True" Content="全部跳过（推荐）" Margin="0,0,0,8"/>
        <TextBlock Text="不会覆盖或删除图库文件；重复文件不会写入新的元数据记录。" Style="{DynamicResource Dialog.Body}" Margin="24,0,0,14" TextWrapping="Wrap"/>
        <RadioButton Name="ImportAllOption" Content="全部仍导入" Margin="0,0,0,14"/>
        <RadioButton Name="DecideIndividuallyOption" Content="逐个选择" Margin="0,0,0,12"/>
        <ListBox Name="MatchesList" MaxHeight="175"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="取消" Width="88" Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}" Click="Cancel_Click"/>
        <Button Content="继续" Width="100" Style="{DynamicResource Button.Primary}" Click="Continue_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
