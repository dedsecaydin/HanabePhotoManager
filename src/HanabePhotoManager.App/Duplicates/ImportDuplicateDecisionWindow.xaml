<Window x:Class="HanabePhotoManager.App.Duplicates.ImportDuplicateDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检测到重复导入" Width="760" Height="520" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource Dialog.Window}">
  <Border Margin="16" Style="{DynamicResource Dialog.Surface}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="检测到内容完全相同的文件" Style="{DynamicResource Dialog.Title}"/>
        <TextBlock Name="DescriptionText" Style="{DynamicResource Dialog.Body}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="新导入文件" FontWeight="SemiBold"/><Border Height="290" Margin="0,8,0,0" Background="{DynamicResource Brush.Surface.Subtle}"><Image Name="IncomingImage" Stretch="Uniform"/></Border><TextBlock Name="IncomingPathText" TextWrapping="Wrap" FontSize="{StaticResource Typography.Caption}" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="图库内已存在文件" FontWeight="SemiBold"/><Border Height="290" Margin="0,8,0,0" Background="{DynamicResource Brush.Surface.Subtle}"><Image Name="ExistingImage" Stretch="Uniform"/></Border><TextBlock Name="ExistingPathText" TextWrapping="Wrap" FontSize="{StaticResource Typography.Caption}" Margin="0,8,0,0"/></StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="跳过" Width="88" Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}" Click="Skip_Click"/>
        <Button Content="在资源管理器中定位已存在文件" Width="190" Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}" Click="Locate_Click"/>
        <Button Content="仍要导入" Width="100" Style="{DynamicResource Button.Primary}" Click="ImportAnyway_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
