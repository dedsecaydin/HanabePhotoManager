<Window x:Class="HanabePhotoManager.App.HanabeAssistantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HanabePhotoManager.App.Controls" Title="Hanabe 任务助手" Width="380" SizeToContent="Height" MinHeight="104" MaxHeight="360" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" AutomationProperties.Name="{Binding AssistantSnapshot.AccessibleName}">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></Window.Resources>
  <Border x:Name="ShellBorder" Margin="8" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.Elevated}" BorderThickness="0" PreviewMouseLeftButtonDown="Surface_PreviewMouseLeftButtonDown">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="AssistantAvatar" Width="64" Height="72" CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True" Background="Transparent" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
        <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="AvatarScale"/><RotateTransform x:Name="AvatarRotation"/><TranslateTransform x:Name="AvatarTranslation"/></TransformGroup></Border.RenderTransform>
        <controls:AnimatedGifImage AnimationSource="{Binding AssistantAnimationSource}" FallbackSource="Assets/Hanabe/hanabe-assistant.png" UseNearestNeighbor="{Binding IsPixelAssistantStyle}" Stretch="Uniform"/>
      </Border>
      <Border x:Name="IdleSpeechBubble" Grid.Column="1" MaxWidth="96" Margin="6,4,0,0" Padding="10,7" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="12,12,12,3" Background="{DynamicResource Brush.Surface.Elevated}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <TextBlock x:Name="IdleSpeechText" Text="Zzz…" TextWrapping="Wrap" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
      </Border>
      <StackPanel x:Name="ActiveTaskPanel" Grid.Column="1" Margin="10,0,0,0">
        <DockPanel Height="28">
          <Button DockPanel.Dock="Right" Width="28" Height="28" ToolTip="隐藏本次悬浮窗" AutomationProperties.Name="隐藏本次悬浮窗" Style="{StaticResource Button.Ghost}" Click="HideButton_Click">
            <Path Data="{StaticResource Icon.X}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <TextBlock DockPanel.Dock="Right" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="{StaticResource Typography.Caption}" Visibility="{Binding AssistantSnapshot.IsProgressVisible, Converter={StaticResource BoolToVis}}">
            <Run Text="成功 "/><Run Text="{Binding ImportSuccessCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Status.Success}" FontWeight="SemiBold"/>
            <Run Text=" 失败 "/><Run Text="{Binding ImportFailedCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Status.Danger}" FontWeight="SemiBold"/>
            <Run Text=" 跳过 "/><Run Text="{Binding ImportSkippedCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Status.Warning}" FontWeight="SemiBold"/>
          </TextBlock>
          <TextBlock Text="Hanabe" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Margin="0,2,0,0" Visibility="{Binding AssistantSnapshot.IsProgressVisible, Converter={StaticResource BoolToVis}}">
          <Border Margin="0,2,0,2" Padding="10,7" CornerRadius="12,12,12,3" Background="{DynamicResource Brush.Surface.Default}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
            <Button Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Padding="0" Click="OpenHanabe_Click"><TextBlock Text="{Binding AssistantSnapshot.Detail}" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"/></Button>
          </Border>
          <StackPanel Margin="0,5,0,0" Visibility="{Binding AssistantSnapshot.IsProgressVisible, Converter={StaticResource BoolToVis}}"><ProgressBar Minimum="0" Maximum="100" Value="{Binding AssistantSnapshot.ProgressValue}" IsIndeterminate="{Binding AssistantSnapshot.IsProgressIndeterminate}" Height="4" Focusable="False"/><DockPanel Margin="0,3,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding EstimatedTimeRemaining}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/><TextBlock Text="{Binding AssistantSnapshot.ProgressValue, StringFormat={}{0:0}%}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Primary}"/></DockPanel><TextBlock Text="{Binding ProgressLabel}" Margin="0,3,0,0" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressLabel}"/></StackPanel>
        </StackPanel>
        <Border Height="1" Margin="0,8,0,7" Background="{DynamicResource Brush.Border.Subtle}" Visibility="{Binding Recovery.IsBusy, Converter={StaticResource BoolToVis}}"/>
        <StackPanel Visibility="{Binding Recovery.IsBusy, Converter={StaticResource BoolToVis}}"><DockPanel><TextBlock Text="恢复扫描" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding Recovery.ProgressValue, StringFormat={}{0:0}%}" Foreground="{DynamicResource Brush.Primary}"/></DockPanel><ProgressBar Margin="0,5,0,0" Height="4" Maximum="100" Value="{Binding Recovery.ProgressValue, Mode=OneWay}"/><TextBlock Margin="0,3,0,0" Text="{Binding Recovery.StatusText}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Border Height="1" Margin="0,8,0,7" Background="{DynamicResource Brush.Border.Subtle}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Compression.IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Compression.IsScanning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
        <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Compression.IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Compression.IsScanning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><DockPanel><TextBlock Text="图片处理" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding Compression.ProgressValue, StringFormat={}{0:0}%}" Foreground="{DynamicResource Brush.Primary}"/></DockPanel><ProgressBar Margin="0,5,0,0" Height="4" Maximum="100" Value="{Binding Compression.ProgressValue, Mode=OneWay}"/><TextBlock Margin="0,3,0,0" Text="{Binding Compression.StatusText}" Foreground="{DynamicResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="停止" Style="{StaticResource Button.Ghost}" Command="{Binding CancelCurrentTaskCommand}" Visibility="{Binding AssistantSnapshot.CanStop, Converter={StaticResource BoolToVis}}"/><Button Content="继续" Style="{StaticResource Button.Ghost}" Click="Resume_Click" Visibility="{Binding AssistantSnapshot.CanResume, Converter={StaticResource BoolToVis}}"/><Button Content="查看" Style="{StaticResource Button.Ghost}" Click="OpenHanabe_Click" Visibility="{Binding AssistantSnapshot.CanViewReport, Converter={StaticResource BoolToVis}}"/></StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
