<Window x:Class="HanabePhotoManager.App.HanabeAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HanabePhotoManager.App.Controls"
        Title="Hanabe 任务助手" Width="350" Height="112" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" AutomationProperties.Name="Hanabe 桌面任务助手">
  <Border Margin="8" Padding="12" CornerRadius="{StaticResource Radius.Dialog}"
          Background="{DynamicResource Brush.Surface.Elevated}"
          BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
          PreviewMouseLeftButtonDown="Surface_PreviewMouseLeftButtonDown">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
      <Border Width="72" Height="72" CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True" Background="Transparent">
        <controls:AnimatedGifImage AnimationSource="{Binding AssistantAnimationSource}"
                                   FallbackSource="Assets/Hanabe/hanabe-assistant.png"
                                   UseNearestNeighbor="{Binding IsPixelAssistantStyle}"
                                   Stretch="Uniform" />
      </Border>
      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
        <TextBlock Text="Hanabe" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBlock Text="{Binding ProgressLabel}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,5"/>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="5" Focusable="False" FocusVisualStyle="{x:Null}"/>
        <DockPanel Margin="0,4,0,0">
          <TextBlock DockPanel.Dock="Right" Text="{Binding EstimatedTimeRemaining}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
          <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Primary}"/>
        </DockPanel>
      </StackPanel>
      <Button Grid.Column="2" Width="24" Height="24" Content="×" ToolTip="隐藏本次悬浮窗"
              Style="{StaticResource Button.Ghost}" Click="HideButton_Click" VerticalAlignment="Top"/>
    </Grid>
  </Border>
</Window>
