<Window x:Class="HanabePhotoManager.App.HanabeAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hanabe 任务助手" Width="620" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource Pet.Brush.F6EEF3}" UseLayoutRounding="True"
        AutomationProperties.Name="{Binding AssistantSnapshot.AccessibleName}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors/HanabePet.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    <DrawingBrush x:Key="Pet.Perforation" TileMode="Tile" Viewport="0,0,9,8" ViewportUnits="Absolute" Viewbox="0,0,9,8" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="{StaticResource Pet.Brush.00000000}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,9,8"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="{StaticResource Pet.Brush.D9140E18}"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,0,3,8"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style x:Key="Pet.Sticker" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Height="20" Padding="8,0" CornerRadius="3" Background="{TemplateBinding Background}">
              <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/></Border.Effect>
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.LayoutTransform><ScaleTransform x:Name="RootScale"/></Grid.LayoutTransform>
    <Grid x:Name="Surface" Width="620" Height="540">

      <!-- 栖息 / 显影 -->
      <Grid x:Name="Stage">
        <Ellipse x:Name="Halo" Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-120" Opacity="0" IsHitTestVisible="False">
          <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="HaloColor" Color="{StaticResource Pet.Color.66FF7AA8}" Offset="0"/><GradientStop Color="{StaticResource Pet.Color.00FF7AA8}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>

        <Canvas x:Name="Pile" Width="90" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,372,0" IsHitTestVisible="False"/>
        <Border x:Name="PileBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,380,62" Height="18" Padding="7,0" CornerRadius="9" Background="{StaticResource Pet.Brush.E6140E18}" BorderBrush="{StaticResource Pet.Brush.33FFFFFF}" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
          <TextBlock x:Name="PileText" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Pet.Brush.7FE0B8}" VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="CharBox" Width="260" Height="200" HorizontalAlignment="Right" VerticalAlignment="Bottom" ClipToBounds="True" Background="Transparent" Cursor="Hand"
                ToolTip="单击戳一下 · 双击打开 Hanabe · 拖动移动 · 拖到屏幕右边会躲起来"
                AutomationProperties.Name="Hanabe 角色；单击互动，双击打开应用，拖动移动"
                MouseLeftButtonDown="Char_MouseLeftButtonDown">
          <Border.RenderTransform><TranslateTransform x:Name="CharShake"/></Border.RenderTransform>
          <Image x:Name="Bust" Width="260" VerticalAlignment="Bottom" Margin="0,0,0,-52" RenderTransformOrigin="0.5,1">
            <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="BustScale"/><RotateTransform x:Name="BustSway"/><TranslateTransform x:Name="BustY"/></TransformGroup></Image.RenderTransform>
          </Image>
        </Border>

        <!-- 拍立得：正面显影，背面是手写详情 -->
        <Grid x:Name="Polaroid" Width="168" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,196,10" Visibility="Collapsed"
              RenderTransformOrigin="0.5,0.9" Cursor="Hand" TextOptions.TextFormattingMode="Ideal" MouseLeftButtonUp="Polaroid_MouseLeftButtonUp"
              AutomationProperties.Name="任务拍立得；单击翻面查看详情">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="PolFlip"/>
              <ScaleTransform x:Name="PolRaise"/>
              <RotateTransform x:Name="PolTilt" Angle="-5"/>
              <TranslateTransform x:Name="PolMove"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Grid.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.45"/></Grid.Effect>

          <Border x:Name="PolFront" CornerRadius="4" Padding="9,9,9,8" Background="{StaticResource Pet.Brush.F7F1EC}">
            <StackPanel>
              <Grid Height="104" ClipToBounds="True">
                <Grid>
                  <Grid.Effect><BlurEffect x:Name="SceneBlur" Radius="5"/></Grid.Effect>
                  <Rectangle>
                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{StaticResource Pet.Color.2A1F3D}" Offset="0"/><GradientStop Color="{StaticResource Pet.Color.5B3A6E}" Offset="0.45"/><GradientStop Color="{StaticResource Pet.Color.E58BA8}" Offset="0.78"/><GradientStop Color="{StaticResource Pet.Color.FFD1B8}" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                  </Rectangle>
                  <Ellipse Width="20" Height="20" Fill="{StaticResource Pet.Brush.FFF4E8}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,22,0"/>
                  <Ellipse Height="100" Margin="-40,0,-40,-58" VerticalAlignment="Bottom" Fill="{StaticResource Pet.Brush.2B1830}"/>
                  <Rectangle x:Name="DevDark" Fill="{StaticResource Pet.Brush.140E18}" Opacity="0.78"/>
                </Grid>
                <Rectangle x:Name="Flash" Opacity="0" IsHitTestVisible="False">
                  <Rectangle.Fill><RadialGradientBrush Center="0.6,0.35" GradientOrigin="0.6,0.35" RadiusX="0.8" RadiusY="1"><GradientStop Color="{StaticResource Pet.Color.FFFFFFFF}" Offset="0"/><GradientStop Color="{StaticResource Pet.Color.00FFFFFF}" Offset="1"/></RadialGradientBrush></Rectangle.Fill>
                </Rectangle>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Height="18" Padding="6,0" CornerRadius="9" Background="{StaticResource Pet.Brush.B30D0A12}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="PolDot" Width="6" Height="6" Fill="{StaticResource Pet.Brush.FF7AA8}"/>
                    <TextBlock x:Name="PolChip" Margin="4,0,0,0" FontSize="10" Foreground="{StaticResource Pet.Brush.F6EEF3}"/>
                  </StackPanel>
                </Border>
                <Border x:Name="Stamp" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Pet.Brush.E8FF5A7A}" BorderThickness="2" CornerRadius="6" Padding="8,2" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                  <Border.RenderTransform><TransformGroup><RotateTransform Angle="-14"/><ScaleTransform x:Name="StampScale" ScaleX="2" ScaleY="2"/></TransformGroup></Border.RenderTransform>
                  <TextBlock Text="收好啦！" FontSize="16" FontWeight="Black" Foreground="{StaticResource Pet.Brush.E8FF5A7A}"/>
                </Border>
                <Path x:Name="Bookmark" Data="M0,0 L14,0 L14,34 L7,27 L0,34 Z" Fill="{StaticResource Pet.Brush.D8344F}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,14,0" Opacity="0" RenderTransformOrigin="0.5,0" IsHitTestVisible="False">
                  <Path.RenderTransform><RotateTransform x:Name="BookmarkSwing"/></Path.RenderTransform>
                </Path>
              </Grid>
              <Grid Height="8" Margin="0,7,0,0" ClipToBounds="True" Background="{StaticResource Pet.Brush.2A2028}">
                <Rectangle x:Name="FilmFill" HorizontalAlignment="Left" Width="0" Fill="{StaticResource Pet.Brush.FF7AA8}"/>
                <Rectangle x:Name="FilmShimmer" Width="60" HorizontalAlignment="Left" Visibility="Collapsed">
                  <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{StaticResource Pet.Color.00FF7AA8}" Offset="0"/><GradientStop Color="{StaticResource Pet.Color.FFFF7AA8}" Offset="0.5"/><GradientStop Color="{StaticResource Pet.Color.00FF7AA8}" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                  <Rectangle.RenderTransform><TranslateTransform x:Name="FilmShimmerX"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Fill="{StaticResource Pet.Perforation}" Opacity="0.55"/>
              </Grid>
              <DockPanel Margin="0,5,0,0">
                <TextBlock x:Name="PolCount" DockPanel.Dock="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Pet.Brush.6E5463}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                <TextBlock x:Name="PolCaption" FontFamily="Segoe Script" FontSize="13.5" Foreground="{StaticResource Pet.Brush.3A2433}" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <Border x:Name="PolBack" CornerRadius="4" Padding="10,9" Background="{StaticResource Pet.Brush.F7F1EC}" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Width="16" Height="16" Cursor="Hand" ToolTip="躲到屏幕边上" AutomationProperties.Name="躲到屏幕边上" Click="HideButton_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><Path Data="M2,2 L8,8 M8,2 L2,8" Stroke="{StaticResource Pet.Brush.8C6F80}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                  </Button>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="BackDot" Width="6" Height="6" Fill="{StaticResource Pet.Brush.D62B66}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BackChip" Margin="4,0,0,0" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Pet.Brush.D62B66}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock x:Name="BackTitle" Margin="0,3,0,0" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Pet.Brush.2E1A26}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BackDetail" Margin="0,2,0,0" FontSize="9.5" Foreground="{StaticResource Pet.Brush.6E5463}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                <StackPanel x:Name="BackBar" Margin="0,6,0,0">
                  <Grid Height="4"><Border CornerRadius="2" Background="{StaticResource Pet.Brush.1F3A2433}"/><Border x:Name="BackBarFill" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="{StaticResource Pet.Brush.D62B66}"/></Grid>
                  <DockPanel Margin="0,2,0,0"><TextBlock x:Name="BackEta" DockPanel.Dock="Right" FontSize="9" Foreground="{StaticResource Pet.Brush.8C6F80}"/><TextBlock x:Name="BackPct" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Pet.Brush.D62B66}"/></DockPanel>
                </StackPanel>
                <TextBlock x:Name="BackHint" Margin="0,5,0,0" FontFamily="Segoe Script, Microsoft YaHei UI" FontSize="9.5" Foreground="{StaticResource Pet.Brush.5A3D4E}" TextWrapping="Wrap" LineHeight="13"/>
                <StackPanel x:Name="BackStats" Orientation="Horizontal" Margin="0,5,0,0">
                  <TextBlock FontSize="9.5" Foreground="{StaticResource Pet.Brush.2E8F6A}" FontWeight="Bold"><Run Text="成功 "/><Run x:Name="StatOk"/></TextBlock>
                  <TextBlock FontSize="9.5" Foreground="{StaticResource Pet.Brush.B9741A}" FontWeight="Bold" Margin="8,0,0,0"><Run Text="跳过 "/><Run x:Name="StatSkip"/></TextBlock>
                  <TextBlock FontSize="9.5" Foreground="{StaticResource Pet.Brush.C8233F}" FontWeight="Bold" Margin="8,0,0,0"><Run Text="失败 "/><Run x:Name="StatFail"/></TextBlock>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="BackActions" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"/>
            </Grid>
          </Border>
        </Grid>

        <Border x:Name="Bubble" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,212" MaxWidth="230"
                Padding="11,7" CornerRadius="14,14,4,14" Background="{StaticResource Pet.Brush.EB140E18}" BorderBrush="{StaticResource Pet.Brush.2EFFFFFF}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="1,1">
          <Border.RenderTransform><ScaleTransform x:Name="BubbleScale"/></Border.RenderTransform>
          <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/></Border.Effect>
          <StackPanel>
            <TextBlock x:Name="BubbleText" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
            <TextBlock x:Name="BubbleSub" FontSize="10.5" Foreground="{StaticResource Pet.Brush.B9AAB8}" Margin="0,2,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 探头：躲在屏幕右边 -->
      <Grid x:Name="Peek" Width="130" Height="170" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Background="Transparent" Cursor="Hand"
            ToolTip="Hanabe · 单击出来" AutomationProperties.Name="Hanabe 躲在屏幕边上；单击出来"
            MouseLeftButtonUp="Peek_MouseLeftButtonUp" MouseEnter="Peek_MouseEnter" MouseLeave="Peek_MouseLeave">
        <Grid.RenderTransform><TranslateTransform x:Name="PeekSlide"/></Grid.RenderTransform>
        <Ellipse x:Name="PeekGlow" Width="150" Height="150" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-70,0" IsHitTestVisible="False">
          <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="PeekGlowColor" Color="{StaticResource Pet.Color.88FF5A7A}" Offset="0"/><GradientStop Color="{StaticResource Pet.Color.00FF5A7A}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Image x:Name="PeekImg" Width="132" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-46,0" RenderTransformOrigin="0.5,0.5">
          <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{StaticResource Pet.Color.FF000000}" Offset="0.7"/><GradientStop Color="{StaticResource Pet.Color.00000000}" Offset="1"/></LinearGradientBrush></Image.OpacityMask>
          <Image.RenderTransform><TransformGroup><RotateTransform Angle="-18"/><TranslateTransform x:Name="PeekBob"/></TransformGroup></Image.RenderTransform>
        </Image>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,14" Height="20" Padding="7,0" CornerRadius="10" Background="{StaticResource Pet.Brush.F0140E18}" BorderBrush="{StaticResource Pet.Brush.33FFFFFF}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="PeekDot" Width="7" Height="7" Fill="{StaticResource Pet.Brush.FF7AA8}"/>
            <TextBlock x:Name="PeekText" Margin="5,0,0,0" FontSize="10.5" FontWeight="Bold"/>
          </StackPanel>
        </Border>
      </Grid>

      <Canvas x:Name="Fx" IsHitTestVisible="False"/>
    </Grid>
  </Grid>
</Window>
