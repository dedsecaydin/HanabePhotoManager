<Window x:Class="HanabePhotoManager.App.HanabeAssistantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HanabePhotoManager.App.Controls" Title="Hanabe 任务助手" Width="360" SizeToContent="Height" MinHeight="112" MaxHeight="240" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" AutomationProperties.Name="{Binding AssistantSnapshot.AccessibleName}">
  <Border Margin="8" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.Elevated}" BorderThickness="0" PreviewMouseLeftButtonDown="Surface_PreviewMouseLeftButtonDown">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="56" Height="56" CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True" Background="Transparent" VerticalAlignment="Top"><controls:AnimatedGifImage AnimationSource="{Binding AssistantAnimationSource}" FallbackSource="Assets/Hanabe/hanabe-assistant.png" UseNearestNeighbor="{Binding IsPixelAssistantStyle}" Stretch="Uniform"/></Border>
      <StackPanel Grid.Column="1" Margin="10,0,0,0">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Width="28" Height="28" Content="×" ToolTip="隐藏本次悬浮窗" AutomationProperties.Name="隐藏本次悬浮窗" Style="{StaticResource Button.Ghost}" Click="HideButton_Click"/>
          <TextBlock Text="Hanabe" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
        </DockPanel>
        <Button Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Padding="0" Margin="0,4,0,0" Click="OpenHanabe_Click"><TextBlock Text="{Binding AssistantSnapshot.Detail}" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"/></Button>
        <StackPanel Margin="0,6,0,0" Visibility="{Binding AssistantSnapshot.IsProgressVisible, Converter={StaticResource BoolToVis}}"><ProgressBar Minimum="0" Maximum="100" Value="{Binding AssistantSnapshot.ProgressValue}" IsIndeterminate="{Binding AssistantSnapshot.IsProgressIndeterminate}" Height="5" Focusable="False"/><DockPanel Margin="0,3,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding EstimatedTimeRemaining}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/><TextBlock Text="{Binding AssistantSnapshot.ProgressValue, StringFormat={}{0:0}%}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Primary}"/></DockPanel></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="停止" Style="{StaticResource Button.Ghost}" Command="{Binding CancelCurrentTaskCommand}" Visibility="{Binding AssistantSnapshot.CanStop, Converter={StaticResource BoolToVis}}"/><Button Content="继续" Style="{StaticResource Button.Ghost}" Click="Resume_Click" Visibility="{Binding AssistantSnapshot.CanResume, Converter={StaticResource BoolToVis}}"/><Button Content="查看" Style="{StaticResource Button.Ghost}" Click="OpenHanabe_Click" Visibility="{Binding AssistantSnapshot.CanViewReport, Converter={StaticResource BoolToVis}}"/></StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
