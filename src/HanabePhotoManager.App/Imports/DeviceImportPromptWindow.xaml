<Window x:Class="HanabePhotoManager.App.Imports.DeviceImportPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检测到媒体设备" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{DynamicResource Dialog.Window}">
  <Border Margin="{DynamicResource Spacing.Card}" Style="{DynamicResource Dialog.Surface}">
    <StackPanel>
      <TextBlock Text="检测到新的照片或视频来源" Style="{DynamicResource Dialog.Title}"/>
      <TextBlock Text="设备中发现可导入的媒体。进入导入页后可以检查来源、目标照片库和导入设置。"
                 Style="{DynamicResource Dialog.Body}" Margin="{DynamicResource Spacing.Stack.8}"/>
      <Border Padding="{DynamicResource Spacing.Card}" Margin="{DynamicResource Spacing.Row.Vertical.8}"
              Background="{DynamicResource Brush.Surface.ContainerLow}" CornerRadius="{DynamicResource Radius.Control}">
        <StackPanel>
          <TextBlock Text="来源设备" FontSize="{DynamicResource Typography.Label}" FontWeight="SemiBold"/>
          <TextBlock x:Name="RootPathText" Style="{DynamicResource Dialog.Body}" Margin="{DynamicResource Spacing.Stack.4}"/>
          <TextBlock Text="目标照片库" FontSize="{DynamicResource Typography.Label}" FontWeight="SemiBold" Margin="{DynamicResource Spacing.Stack.8}"/>
          <TextBlock x:Name="DestinationPathText" Style="{DynamicResource Dialog.Body}" Margin="{DynamicResource Spacing.Stack.4}"/>
        </StackPanel>
      </Border>
      <TextBlock Text="点击“进入导入”只会选中来源并打开页面。检查后点击“开始分析与导入”才会处理文件。"
                 Style="{DynamicResource Dialog.Body}" Margin="{DynamicResource Spacing.Stack.8}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Spacing.Stack.8}">
        <Button x:Name="LaterButton" Content="稍后处理" IsCancel="True" Style="{DynamicResource Button.Secondary}"
                Click="Later_Click" AutomationProperties.Name="稍后处理检测到的设备"/>
        <Button x:Name="ImportButton" Content="进入导入" IsDefault="True" Style="{DynamicResource Button.Primary}"
                Click="Import_Click" Margin="{DynamicResource Spacing.Inline.8}" AutomationProperties.Name="进入导入并选择此设备"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
