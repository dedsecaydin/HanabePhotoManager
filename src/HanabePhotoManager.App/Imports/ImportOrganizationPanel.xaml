<UserControl x:Class="HanabePhotoManager.App.Imports.ImportOrganizationPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel IsEnabled="{Binding CanEditImportOrganization}">
  <TextBlock Text="分类与场次" Style="{DynamicResource Inspector.SectionLabel}" />
  <TextBlock Text="Ctrl 多选，拖到下方分类或场次。" TextWrapping="Wrap" Style="{DynamicResource Dialog.Body}" Margin="{DynamicResource Spacing.Stack.8}" />
  <ItemsControl ItemsSource="{Binding ImportDropCategories}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Button Content="{Binding Display}" Margin="4" Padding="12,8" AllowDrop="True" DragOver="Target_DragOver" Drop="Category_Drop"
      Command="{Binding DataContext.AssignImportCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource Button.Subtle}" />
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="场次" Style="{DynamicResource Inspector.SectionLabel}" Margin="{DynamicResource Spacing.Stack.8}" />
  <Button Content="自动分组" ToolTip="按拍摄时间分组，间隔 30 分钟；结果可调整、可撤销" Command="{Binding SuggestImportSessionsCommand}" Style="{DynamicResource Button.Subtle}" Margin="{DynamicResource Spacing.Stack.8}" />
  <DockPanel Margin="{DynamicResource Spacing.Stack.8}">
   <Button DockPanel.Dock="Right" Content="新建" Command="{Binding AddImportSessionCommand}" Style="{DynamicResource Button.Subtle}" />
   <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding NewImportSessionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" ToolTip="场次名称，例如：棚拍 · 上午" AutomationProperties.Name="场次名称" />
  </DockPanel>
  <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ImportSessionBuckets}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Button Content="{Binding}" HorizontalContentAlignment="Left" Margin="0,4" AllowDrop="True" DragOver="Target_DragOver" Drop="Session_Drop"
      Command="{Binding DataContext.AssignImportSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource Button.Subtle}" />
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl></ScrollViewer>
  <WrapPanel Margin="{DynamicResource Spacing.Stack.8}">
   <Button Content="撤销" Command="{Binding UndoImportOrganizationCommand}" Style="{DynamicResource Button.Ghost}" Margin="0,0,6,0" />
   <Button Content="清除场次" Command="{Binding AssignImportSessionCommand}" CommandParameter="" Style="{DynamicResource Button.Ghost}" />
  </WrapPanel>
  <TextBlock Text="导入后保存场次，不移动原片。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Typography.Caption}" />
 </StackPanel>
</UserControl>
