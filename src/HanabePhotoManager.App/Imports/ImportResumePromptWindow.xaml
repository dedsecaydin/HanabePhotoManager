<Window x:Class="HanabePhotoManager.App.Imports.ImportResumePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="继续上次传输" Width="640" Height="390" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource Dialog.Window}">
  <Border Margin="16" Style="{DynamicResource Dialog.Surface}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="检测到未完成的照片传输" Style="{DynamicResource Dialog.Title}"/>
        <TextBlock x:Name="SummaryText" Margin="0,10,0,0" Style="{DynamicResource Dialog.Body}" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Grid.Row="1" Margin="0,18,0,0" Padding="14" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
        <StackPanel>
          <TextBlock Text="继续传输会从尚未完成的文件开始，不重复覆盖已完成文件。" TextWrapping="Wrap"/>
          <TextBlock Margin="0,8,0,0" Text="放弃记录只会清除续传状态，不会删除已导入文件或源文件。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
          <TextBlock Margin="0,8,0,0" Text="稍后处理会保留记录，并在下次启动时再次提醒。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="放弃记录" Style="{DynamicResource Button.Secondary}" Click="Discard_Click" AutomationProperties.Name="放弃上次传输记录"/>
        <Button Grid.Column="2" Content="稍后处理" Style="{DynamicResource Button.Secondary}" Click="Later_Click" IsCancel="True" AutomationProperties.Name="稍后处理上次传输"/>
        <Button Grid.Column="4" Content="继续传输" Style="{DynamicResource Button.Primary}" Click="Continue_Click" IsDefault="True" AutomationProperties.Name="继续上次传输"/>
      </Grid>
    </Grid>
  </Border>
</Window>
