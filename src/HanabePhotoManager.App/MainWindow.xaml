                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="46" />
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="13" Background="{DynamicResource Brush.Surface.Subtle}">
                                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Text="{Binding Icon}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                              <DockPanel>
                                                <TextBlock FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="7,2" CornerRadius="9" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                                  <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding BadgeText}" />
                                                </Border>
                                              </DockPanel>
                                              <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" Opacity="0.95" Margin="0,2,0,0" Text="{Binding Brand}" />
                                              <TextBlock TextWrapping="Wrap" Opacity="0.78" FontSize="12" Margin="0,3,0,0" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="选择" Margin="10,0,0,0" Padding="12,7" VerticalAlignment="Center" Background="{DynamicResource Brush.Surface.Subtle}" Command="{Binding DataContext.ImportFromDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                          </Grid>
                                        </Border>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Expander>
                            </DataTemplate>
