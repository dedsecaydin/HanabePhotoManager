                      <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="缩略图大小" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Text="{Binding ZoomableGridTileSize, StringFormat={}{0:N0}px}" />
                      </DockPanel>
                      <Slider Minimum="48" Maximum="512" Value="{Binding ZoomableGridTileSize}" />
