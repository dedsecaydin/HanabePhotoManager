                        <TextBlock Text="本地 AI 人物识别" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding EnablePersonRecognition}" />
                      </DockPanel>
                    </Border>
