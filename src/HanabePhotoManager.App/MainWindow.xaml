      <Border x:Name="SidebarClip" Grid.Column="0" ClipToBounds="True" HorizontalAlignment="Left">
      <Border x:Name="SidebarSurface" Style="{StaticResource Sidebar.Container}" Width="{Binding SidebarContentWidth}" HorizontalAlignment="Left" ContextMenuOpening="Sidebar_ContextMenuOpening">
        <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
        <DockPanel LastChildFill="True">
          <DockPanel DockPanel.Dock="Top" Margin="6,0,6,20" LastChildFill="True">
            <Border DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Subtle}" ClipToBounds="True" x:Name="SidebarLogoSurface" PreviewMouseLeftButtonDown="SidebarLogoSurface_PreviewMouseLeftButtonDown">
              <Grid><Image Stretch="UniformToFill" Source="Assets/Hanabe/workspace-hero.png"/><Image Stretch="UniformToFill" Source="{Binding AppIconImage}" Visibility="{Binding HasCustomAppIcon, Converter={StaticResource BoolToVis}}"/></Grid>
            </Border>
            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsSidebarFull, Converter={StaticResource BoolToVis}}"><TextBlock Text="Hanabe" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Bold"/><TextBlock Text="照片工作台" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"/></StackPanel>
          </DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="ThemeToggleButton" AutomationProperties.Name="切换主题" Style="{StaticResource Navigation.RailItem}" Click="ToggleTheme_Click" ToolTip="切换明暗主题">
              <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                  <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="ThemeToggleIcon" Data="{StaticResource Icon.Theme.Moon}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                </Border>
                <TextBlock x:Name="ThemeToggleLabel" Text="深色" FontSize="{StaticResource Typography.Body}" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Brush.OnSurfaceVariant}" Visibility="{Binding IsSidebarFull, Converter={StaticResource BoolToVis}}" />
                
          </StackPanel>
            </Button>
            <Button AutomationProperties.Name="设置" Command="{Binding ShowSettingsCommand}" ToolTip="设置">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Navigation.RailItem}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                      <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                  <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Settings}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                </Border>
                <TextBlock Text="设置" FontSize="{StaticResource Typography.Body}" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Brush.OnSurfaceVariant}" Visibility="{Binding IsSidebarFull, Converter={StaticResource BoolToVis}}" />
                
          </StackPanel>
            </Button>
            <TextBlock Text="●" FontSize="{StaticResource Typography.BodySmall}" HorizontalAlignment="Center" Margin="0,8,0,4">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsBusy}">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
            <Border Style="{DynamicResource Layout.GlassPanel}" Padding="10" Margin="0,12,0,0" Visibility="{Binding IsSidebarFull, Converter={StaticResource BoolToVis}}"><StackPanel><TextBlock Text="Hanabe" FontWeight="SemiBold"/><TextBlock Text="Keep memories" Style="{DynamicResource Layout.Eyebrow}"/></StackPanel></Border>
          </StackPanel>
          <ScrollViewer Style="{StaticResource Sidebar.NavigationScroller}" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
            <Grid x:Name="PrimaryNavigationHost">
            <ItemsControl x:Name="PrimaryNavigationList"
                          ItemsSource="{Binding NavigationItems}"
                          AllowDrop="True"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Once"
                          Drop="PrimaryNavigationList_Drop">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type navigations:NavigationItemViewModel}">
                  <Button x:Name="NavigationButton" Tag="{Binding Key}"
                          Style="{StaticResource Navigation.RailItem}"
                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                          ToolTip="{Binding Label}"
                          Command="{Binding Command}"
                          AutomationProperties.Name="{Binding Label}"
                          PreviewMouseLeftButtonDown="PrimaryNavigationItem_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PrimaryNavigationItem_PreviewMouseMove">
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" Background="Transparent" HorizontalAlignment="Center">
                          <Viewbox x:Name="NavigationIcon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="NavigationIconPath" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                          </Viewbox>
                        </Border>
                        <TextBlock x:Name="NavigationLabel" Text="{Binding Label}" FontSize="{StaticResource Typography.Body}" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Value="True">
                      <DataTrigger.Binding><MultiBinding Converter="{StaticResource CategoryEqualityMultiConverter}"><Binding Path="Key"/><Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding>
                      <Setter TargetName="NavigationButton" Property="Background" Value="{DynamicResource Brush.Primary.Fill}"/>
                      <Setter TargetName="NavigationLabel" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}"/>
                      <Setter TargetName="NavigationIconPath" Property="Stroke" Value="{DynamicResource Brush.OnPrimary}"/>
                      <Setter TargetName="NavigationLabel" Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>

                      <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Text">
                        <Setter TargetName="NavigationIcon" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Icon">
                        <Setter TargetName="NavigationLabel" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Home"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Home}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Import"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Import}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Preview"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Library}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="CustomAlbums"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Album}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="FaceSearch"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.FaceSearch}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="MapPhotos"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Map}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Compression"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Compress}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Key}" Value="DateFolders"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Calendar}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Watermark"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Watermark}" /></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </Border>
      </Border>
      <Border Grid.Column="1">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Layout.Workspace}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                <Setter Property="Padding" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Background="Transparent" x:Name="TopBarSurface" PreviewMouseLeftButtonDown="TopBarSurface_PreviewMouseLeftButtonDown" Margin="24,16,16,12">
            <Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
              <!-- 收起 / 展开左侧功能栏（Ctrl+B）；右键功能栏可选择显示哪些功能页 -->
              <Button x:Name="SidebarToggleButton" Style="{StaticResource Window.CaptionButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding SidebarToggleToolTip}" AutomationProperties.Name="收起或展开左侧功能栏" Margin="0,0,8,0">
                <Path Data="M3,4.5 L17,4.5 M3,10 L17,10 M3,15.5 L17,15.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
              </Button>
              <TextBlock Text="{Binding PageTitle, StringFormat=Hanabe · 照片工作台   /   {0}}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}" Margin="{StaticResource Spacing.Inline.8}"/>
            </StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <!-- 全局搜索：回车 = 搜照片；Ctrl+Enter 或 ✦ = 交给 AI 助手（会调用软件功能，改文件前先问你） -->
              <Grid x:Name="WorkspaceSearchHost" Width="360" Height="40" Margin="0,0,10,0">
                <TextBox x:Name="WorkspaceSearchBox" Padding="12,0,44,0" VerticalContentAlignment="Center" Style="{DynamicResource Input.TextBox}" ToolTip="回车：搜索照片 · Ctrl+Enter：问 AI 助手 · Ctrl K：跳到图库搜索" AutomationProperties.Name="全局照片搜索" KeyDown="WorkspaceSearch_KeyDown"/>
                <TextBlock Text="搜照片，或 Ctrl+Enter 让 AI 帮你做" Margin="14,0,48,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.BodySmall}" TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=WorkspaceSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
