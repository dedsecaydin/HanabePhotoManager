                                                    <TextBlock Opacity="0.82" FontSize="{StaticResource Typography.Caption}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Viewer.Text}" FontWeight="Medium" Text="{Binding Caption}" />
