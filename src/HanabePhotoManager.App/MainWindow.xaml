                    </StackPanel>
                  </StackPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <Border Width="250" Style="{DynamicResource Card.Default}" Padding="14" Margin="0,0,14,14" Visibility="{Binding IsBrowseConditionsExpanded, Converter={StaticResource BoolToVis}}">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                          <Button DockPanel.Dock="Left" Content="‹" Width="34" Height="30" Padding="0" Margin="0" Command="{Binding PreviousCalendarMonthCommand}" />
                          <Button DockPanel.Dock="Right" Content="›" Width="34" Height="30" Padding="0" Margin="0" Command="{Binding NextCalendarMonthCommand}" />
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{Binding CalendarMonthTitle}" />
                        </DockPanel>
                        <Button Margin="0,0,0,10" Height="34" Padding="10,0" Content="全部日期" Command="{Binding ShowAllDatesCommand}" AutomationProperties.Name="返回全部日期" />
                        <UniformGrid Columns="7" Margin="0,0,0,5">
                          <TextBlock Text="一" HorizontalAlignment="Center" Opacity="0.58" FontSize="11" />
                          <TextBlock Text="二" HorizontalAlignment="Center" Opacity="0.58" FontSize="11" />
                          <TextBlock Text="三" HorizontalAlignment="Center" Opacity="0.58" FontSize="11" />
                          <TextBlock Text="四" HorizontalAlignment="Center" Opacity="0.58" FontSize="11" />
                          <TextBlock Text="五" HorizontalAlignment="Center" Opacity="0.58" FontSize="11" />
                          <TextBlock Text="六" HorizontalAlignment="Center" Opacity="0.58" FontSize="11" />
                          <TextBlock Text="日" HorizontalAlignment="Center" Opacity="0.58" FontSize="11" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                              <Button Height="32" Padding="0" Margin="2" FontSize="12" Content="{Binding DayText}" IsEnabled="{Binding IsAvailable}" Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <FrameworkElement.Style>
                                  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                    <Setter Property="UIElement.Opacity" Value="0.46" />
                                    <Style.Triggers>
                                      <DataTrigger Value="False" Binding="{Binding IsCurrentMonth}">
                                        <Setter Property="UIElement.Opacity" Value="0.16" />
                                      </DataTrigger>
                                      <DataTrigger Value="True" Binding="{Binding IsAvailable}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                        <Setter Property="UIElement.Opacity" Value="1" />
                                      </DataTrigger>
                                      <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="亮起日期包含照片；灰色日期不可点击" TextWrapping="Wrap" FontSize="11" Opacity="0.62" Margin="2,10,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Width="250" HorizontalAlignment="Left" Style="{DynamicResource Card.Default}" Padding="14" Margin="0,0,14,0">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="人物" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <Button DockPanel.Dock="Right" Padding="10,4" Content="扫描" Command="{Binding PeopleAlbums.ScanCommand}" AutomationProperties.Name="在本机扫描人物相册" />
                        </DockPanel>
                        <TextBlock Text="{Binding PeopleAlbums.StatusText}" Opacity="0.68" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10" />
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding PeopleAlbums.ScanProgressValue, Mode=OneWay}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}" />
                        <Button Margin="0,6,0,8" Content="取消扫描" Command="{Binding PeopleAlbums.CancelScanCommand}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding PeopleAlbums.SummaryText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="返回全部照片" Margin="0,0,0,8" Command="{Binding PeopleAlbums.ClearSelectionCommand}" Visibility="{Binding PeopleAlbums.SelectedAlbum, Converter={StaticResource BoolToVis}}" />
                        <Border x:Name="PeopleRecognitionModelPanel" Padding="9" Margin="0,0,0,8" CornerRadius="10" Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                          <StackPanel>
                            <TextBlock Text="{Binding PeopleAlbums.RecognitionEngineText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PeopleAlbums.RecognitionDetailsText}" Margin="0,3,0,0" FontSize="10" Opacity="0.68" TextWrapping="Wrap" />
                            <TextBlock Text="切换位置：设置 → 高级 → 人脸识别" Margin="0,3,0,0" FontSize="10" Opacity="0.68" TextWrapping="Wrap" />
                            <Button Content="前往设置" Margin="0,6,0,0" Command="{Binding ShowSettingsCommand}" />
                          </StackPanel>
                        </Border>
                        <Button x:Name="PeopleBubbleButton" Content="显示全部人物" Margin="0,2,0,0" Command="{Binding PeopleAlbums.ToggleBubblesCommand}" />
                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="18" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Visibility="{Binding PeopleAlbums.AreBubblesOpen, Converter={StaticResource BoolToVis}}">
                           <ItemsControl ItemsSource="{Binding PeopleAlbums.Albums}" MaxWidth="330">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PersonAlbumItemViewModel}">
                              <StackPanel Width="88" Margin="0,0,8,12">
                                <Button Width="68" Height="68" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Command="{Binding SelectCommand}" ToolTip="点击只看此人物">
                                  <Border Width="68" Height="68" CornerRadius="9" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1.5">
                                    <Border.Background><ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill" /></Border.Background>
                                  </Border>
                                </Button>
                                <DockPanel Margin="0,5,0,0">
                                  <Button DockPanel.Dock="Right" Width="22" Height="25" Padding="0" Content="✓" FontSize="10" Command="{Binding SaveNameCommand}" ToolTip="保存姓名" />
                                  <TextBox Height="25" Padding="5,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="可自定义姓名" />
                                </DockPanel>
                                <TextBlock HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10" Opacity="0.58" Text="{Binding PhotoCount, StringFormat={}{0} 张}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                           </ItemsControl>
                        </Border>
                        <Button Content="清除人物筛选" Margin="0,6,0,0" Command="{Binding PeopleAlbums.ClearSelectionCommand}" Visibility="{Binding PeopleAlbums.SelectedAlbum, Converter={StaticResource BoolToVis}}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  </ScrollViewer>
                </DockPanel>
                <Border x:Name="BrowseUnifiedWorkspace" Grid.Column="1" CornerRadius="{StaticResource Radius.Container}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Padding="16">
                  <Grid>
                  <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="0" CornerRadius="{StaticResource Radius.Control}" Background="Transparent" BorderThickness="0" Visibility="{Binding IsBrowseConditionsExpanded, Converter={StaticResource BoolToVis}}">
                      <StackPanel>
                      <!-- 合并搜索：文件名 / 语义描述统一入口 -->
                      <Border Style="{DynamicResource Card.Subtle}" Margin="0,0,0,10" Padding="14,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <StackPanel>
                            <TextBlock Text="智能搜索" Style="{DynamicResource Layout.SettingsFieldLabel}" Margin="0,0,0,6" />
                            <TextBox x:Name="BrowseSmartSearchBox"
                                     Style="{StaticResource Input.TextBox}"
                                     Text="{Binding UnifiedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="智能搜索照片"
                                     ToolTip="输入文件名或路径直接匹配；输入自然描述进行语义搜索。" />
                          </StackPanel>
                          <ComboBox Grid.Column="1" Width="120" Height="36" Margin="12,14,0,0"
                                    ItemsSource="{Binding BrowseSearchModeChoices}"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding BrowseSearchMode, Mode=TwoWay}"
                                    AutomationProperties.Name="智能搜索模式">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Button Grid.Column="2"
                                  Style="{DynamicResource Button.Ghost}"
                                  Margin="8,14,0,0"
                                  Content="取消"
                                  Command="{Binding SemanticSearch.CancelCommand}"
                                  Visibility="{Binding SemanticSearch.IsBusy, Converter={StaticResource BoolToVis}}" />
