                         Foreground="{DynamicResource Brush.Text.Secondary}"
                         FontSize="{StaticResource Typography.Caption}"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Margin="0,0,14,0" Padding="10,5" Style="{StaticResource Button.Ghost}"
                      Command="{Binding TogglePageHelpCommand}" AutomationProperties.Name="查看当前页面说明"
