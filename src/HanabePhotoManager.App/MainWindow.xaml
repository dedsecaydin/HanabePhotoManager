                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Margin="0,0,8,0" Padding="0" Content="{Binding}" Command="{Binding DataContext.SetPreviewCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <Control.Template>
                                      <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Name="Chip" CornerRadius="{StaticResource Radius.Small}" Padding="12,6" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="Transparent" BorderThickness="1" Cursor="Hand"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource Brush.OnSurfaceVariant}" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" /></Border>
                                        <ControlTemplate.Triggers>
                                          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Value="True"><Condition.Binding><MultiBinding Converter="{StaticResource CategoryEqualityMultiConverter}"><Binding Path="." /><Binding Path="DataContext.CurrentPreviewCategory" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></Condition.Binding></Condition></MultiDataTrigger.Conditions><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}" /><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnPrimaryContainer}" /></MultiDataTrigger>
                                          <Trigger Property="UIElement.IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Surface.ContainerHighest}" /><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" /></Trigger>
                                          <Trigger Property="ButtonBase.IsPressed" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Surface.Container}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                      </ControlTemplate>
                                    </Control.Template>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
