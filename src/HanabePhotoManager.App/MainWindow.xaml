                                            </StackPanel>
                                            <Button Grid.Column="2" Content="选择" Margin="10,0,0,0" Padding="12,7" VerticalAlignment="Center" Background="{DynamicResource Brush.Surface.Subtle}" Command="{Binding DataContext.ImportFromDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                          </Grid>
                                        </Border>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Expander>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <Border Grid.Column="1" Padding="16" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" Text="{Binding SelectedDeviceTitle}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.84" Margin="0,4,0,0" Text="{Binding SelectedDeviceSummary}" />
                          </StackPanel>
                          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                            <ItemsControl ItemsSource="{Binding SelectedDeviceContents}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceContentItemViewModel}">
                                  <Border Margin="0,0,0,8" Padding="12" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <Grid>
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <TextBlock FontSize="{StaticResource Typography.TitleSmall}" VerticalAlignment="Center" Text="{Binding Icon}" />
                                      <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.BodySmall}" Text="{Binding Kind}" />
                                        <TextBlock Opacity="0.78" FontSize="{StaticResource Typography.BodySmall}" TextWrapping="Wrap" Text="{Binding Detail}" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </DockPanel>
                      </Border>
                    </Grid>
                  </DockPanel>
                </Border>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Border>
            <Grid Name="ImportPage" Style="{StaticResource PageSurface}" Visibility="{Binding IsImportPage, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource Layout.PagePanel}" Padding="16">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource Layout.PageTitle}" Text="{Binding PageTitle}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" Text="{Binding PageSubtitle}" />
                  </StackPanel>
                <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
              </Grid.ColumnDefinitions>

              <!-- 左：导入源（320px） -->
              <Border Grid.Column="0" Style="{StaticResource Layout.Section}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <Border AllowDrop="True" Padding="16,18" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Margin="0,0,0,20" DragOver="SourceAutoImportDropTarget_DragOver" Drop="SourceAutoImportDropTarget_Drop">
                      <StackPanel>
                        <Viewbox Width="30" Height="30" HorizontalAlignment="Center" Margin="0,0,0,8">
                          <Path Data="{StaticResource Icon.Import}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                        <TextBlock Text="拖入相机文件夹" FontWeight="SemiBold" FontSize="{StaticResource Typography.Label}" HorizontalAlignment="Center" />
                        <TextBlock Text="自动读取 · 自动分类 · 自动生成日期目录" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,6,0,0" />
                        <Border Height="1" Background="{DynamicResource Brush.OutlineVariant}" Margin="0,14" />
                        <TextBlock Text="来源" FontWeight="SemiBold" FontSize="{StaticResource Typography.Label}" />
                        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerHigh}">
                          <TextBlock Text="{Binding SourceFolder, StringFormat=来源：{0}}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.BodySmall}" />
                        </Border>
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                          <Button Grid.Column="0" Content="选择来源文件夹" Style="{StaticResource Button.Secondary}" Command="{Binding BrowseSourceCommand}" Padding="10,7" />
                          <Button Grid.Column="2" Content="选择多个文件" Style="{StaticResource Button.Secondary}" Command="{Binding BrowseSourceFilesCommand}" Padding="10,7" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- 高级选项（默认收起，180ms M3 缓动） -->
                    <Button Style="{StaticResource Button.Disclosure}" Command="{Binding ToggleImportAdvancedCommand}" AutomationProperties.Name="展开或收起高级选项">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="高级选项" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" FontSize="{StaticResource Typography.Caption}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="▸" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImportAdvancedExpanded}" Value="True">
                                  <Setter Property="Text" Value="▾" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Button>
                    <Border ClipToBounds="True">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="MaxHeight" Value="0" />
                          <Setter Property="Opacity" Value="0" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsImportAdvancedExpanded}" Value="True">
                              <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                  <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="600" Duration="{StaticResource Motion.Duration.Normal}">
                                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Duration.Normal}" />
                                  </Storyboard>
                                </BeginStoryboard>
                              </DataTrigger.EnterActions>
                              <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                  <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="{StaticResource Motion.Duration.Normal}">
                                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Duration.Normal}" />
                                  </Storyboard>
                                </BeginStoryboard>
                              </DataTrigger.ExitActions>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel Margin="0,8,0,0" IsEnabled="{Binding IsImportAdvancedExpanded}">
                        <Border Padding="4,10" Background="Transparent" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="0,0,0,1">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="转移方式" FontWeight="SemiBold" /><TextBlock Text="复制或移动来源文件" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            <ComboBox Grid.Column="1" SelectedValuePath="Mode" DisplayMemberPath="Display" ItemsSource="{Binding TransferModes}" SelectedValue="{Binding SelectedTransferMode}" />
                          </Grid>
                        </Border>

                        <Border Padding="4,10" Background="Transparent" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="0,0,0,1">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                              <TextBlock Text="本地 AI 人物识别" FontWeight="SemiBold" />
                              <TextBlock Text="只识别 JPG/JPEG；同名 RAW 自动继承，视频跳过；仅本机处理。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,3,10,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding EnablePersonRecognition}" />
                          </Grid>
                        </Border>

                        <Border Padding="4,10" Background="Transparent" BorderThickness="0">
                          <StackPanel>
                            <TextBlock Text="拖入后期 / 素材" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="12,10" AllowDrop="True" Drop="EditedDropTarget_Drop">
                                <StackPanel><TextBlock Text="修后" FontWeight="SemiBold" /><TextBlock Text="后期完成文件" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                              </Border>
                              <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="12,10" AllowDrop="True" Drop="MaterialDropTarget_Drop">
                                <StackPanel><TextBlock Text="素材" FontWeight="SemiBold" /><TextBlock Text="项目素材" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                              </Border>
                            </Grid>
                            <TextBlock Text="无法判断归属时会停下来让你确认，不会乱放。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,10,0,0" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <Button Content="开始分析与导入" Style="{StaticResource Button.Primary}" Command="{Binding AnalyzeAndImportCommand}" />
                    <Button Content="取消导入" Style="{StaticResource Button.Secondary}" Margin="0,10,0,0" Command="{Binding CancelCurrentTaskCommand}" Visibility="{Binding IsImportRunning, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </ScrollViewer>
              </Border>

              <!-- 中：导入队列 -->
              <Border Grid.Column="2" Padding="16" Background="Transparent" BorderThickness="0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="导入队列" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                    <TextBlock FontWeight="SemiBold" Opacity="0.88" Margin="0,6,0,0" Text="{Binding TargetDateText}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.88" Margin="0,6,0,0" Text="{Binding ImportReport}" />
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                      <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ImportReport}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ScrollViewer.Style>
                      <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding ImportReport}" />
                    </ScrollViewer>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Primary}" Margin="0,6,0,0" Text="{Binding ImportActionHint}" />
                    <Border Margin="0,10,0,0" Padding="12" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Visibility="{Binding IsImportRunning, Converter={StaticResource BoolToVis}}">
                      <DockPanel>
                        <StackPanel>
                          <TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold" />
                          <ProgressBar Width="240" HorizontalAlignment="Left" Margin="0,8,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ImportSections}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImportCategorySectionViewModel}">
                          <Border Margin="0,0,0,14" Padding="14" Background="Transparent" BorderThickness="0">
                            <StackPanel>
                              <DockPanel Margin="0,0,0,12">
                                <Border Width="42" Height="42" CornerRadius="{StaticResource Radius.Control}" Margin="0,0,12,0" Background="{Binding AccentBrush}">
                                  <TextBlock FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}" />
                                </Border>
                                <StackPanel>
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHighest}" VerticalAlignment="Center">
                                      <TextBlock Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Text="{Binding Items.Count, StringFormat={}{0} 项}" />
                                    </Border>
                                  </StackPanel>
                                  <TextBlock Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.BodySmall}" Text="{Binding Subtitle}" />
                                  <TextBlock Foreground="{DynamicResource Brush.Primary}" FontSize="{StaticResource Typography.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding RenderHint}" />
                                </StackPanel>
                              </DockPanel>
                              <ItemsControl ItemsSource="{Binding VisibleItems}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type vm:ImportPreviewItemViewModel}">
                                    <Border Width="196" Margin="0,0,10,10" CornerRadius="{StaticResource Radius.Control}" ClipToBounds="True" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Background="{DynamicResource Brush.Surface.ContainerLowest}">
                                      <StackPanel>
                                        <Grid Height="108" Background="{DynamicResource Brush.Surface.ContainerHigh}">
                                          <Rectangle Fill="{DynamicResource Brush.Accent.Subtle}" />
                                          <Grid Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                              <TextBlock Foreground="{DynamicResource Brush.Primary}" FontSize="{StaticResource Typography.Display}" FontWeight="Black" HorizontalAlignment="Center" Text="{Binding ExtensionBadge}" />
                                              <TextBlock Text="暂无系统缩略图" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            </StackPanel>
                                          </Grid>
                                          <Rectangle Opacity="0.9">
                                            <Shape.Fill>
                                              <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Thumbnail}" />
                                            </Shape.Fill>
                                          </Rectangle>
                                          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Overlay.Scrim}">
                                            <TextBlock Foreground="{DynamicResource Brush.Viewer.Text}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Text="{Binding QueueNumber}" />
                                          </Border>
                                          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Padding="7,3" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Overlay.Scrim}">
                                            <TextBlock Foreground="{DynamicResource Brush.Viewer.Text}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Text="{Binding CategoryBadge}" />
                                          </Border>
                                        </Grid>
                                        <StackPanel Margin="12">
                                          <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                          <TextBlock Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding SourceFileName}" />
                                          <TextBlock Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,2,0,0" Text="{Binding SizeText}" />
                                          <TextBlock Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,1,0,0" Text="{Binding TargetDateText}" />
                                          <Border HorizontalAlignment="Left" Padding="8,3" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHigh}" Margin="0,6,0,0" Visibility="{Binding HasPersonLabel, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Text="{Binding PersonLabel}" />
                                          </Border>
                                          <Border HorizontalAlignment="Left" Padding="8,3" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.PrimaryContainer}" Margin="0,6,0,0" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Foreground="{DynamicResource Brush.OnPrimaryContainer}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Text="需要人工确认" />
                                          </Border>
                                          <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding IsSelected}" />
                                            <ComboBox Grid.Column="1" DisplayMemberPath="Display" Margin="6,0,0,0" ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding SelectedCategory}" />
                                          </Grid>
                                        </StackPanel>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Button HorizontalAlignment="Left" Padding="14,7" Margin="0,4,0,0" Content="{Binding HiddenCount, StringFormat=继续显示更多（剩余 {0:N0} 张）}" Command="{Binding ShowMoreCommand}" Visibility="{Binding HasHiddenItems, Converter={StaticResource BoolToVis}}" Style="{StaticResource Button.Secondary}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              <!-- 右：Inspector（320px） -->
              <Border Grid.Column="4" Style="{StaticResource Layout.Section}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <Border x:Name="ImportTipCard" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.PrimaryContainer}" Margin="0,0,0,14">
                      <TextBlock x:Name="ImportTipText" Text="💡 遇到不认识的 RAW / 视频格式？到 设置 → 照片库与导入 → 自定义导入格式 里添加后缀（如 R3D、BRAW），保存后会自动记住。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnPrimaryContainer}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="导入设置" Style="{StaticResource Inspector.SectionLabel}" />
                    <Border Margin="0,8,0,0" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="精确查重（SHA-256）" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" />
                            <TextBlock Text="文件大小粗筛 → 流式哈希确认；重复自动跳过" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,2,10,0" />
                          </StackPanel>
                          <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="True" IsEnabled="False" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Brush.OutlineVariant}" Margin="0,10" />
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="相似照片审查（感知哈希）" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" />
                            <TextBlock Text="仅做全库相似度审查，不自动阻止导入" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,2,10,0" />
                          </StackPanel>
                          <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="False" IsEnabled="False" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Brush.OutlineVariant}" Margin="0,10" />
                        <Grid Opacity="0.72">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="修后目录只读保护" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" />
                            <TextBlock Text="«修后» 文件夹永不写入、不可覆盖（铁律，不可关闭）" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,2,10,0" />
                          </StackPanel>
                          <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="True" IsEnabled="False" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <TextBlock Text="去重结果" Style="{StaticResource Inspector.SectionLabel}" Margin="0,20,0,0" />
                    <Border Margin="0,8,0,0" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                      <StackPanel>
                        <TextBlock Text="导入时自动检测重复并统一处理" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" />
                        <RadioButton Content="全部跳过（推荐）" IsChecked="True" IsEnabled="False" Margin="0,8,0,0" />
                        <RadioButton Content="全部仍导入" IsEnabled="False" Margin="0,4,0,0" />
                        <RadioButton Content="逐个选择" IsEnabled="False" Margin="0,4,0,0" />
                        <TextBlock Text="检测到重复时会弹出确认窗口，可统一或逐个处理。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>

                    <TextBlock Text="归属确认" Style="{StaticResource Inspector.SectionLabel}" Margin="0,20,0,0" />
                    <Border Margin="0,8,0,0" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Visibility="{Binding HasUnconfirmedItems, Converter={StaticResource BoolToVis}}">
                      <StackPanel>
                        <TextBlock Text="无法判断归属的文件" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" />
                        <TextBlock Text="{Binding UnconfirmedSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,2,0,0" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding UnconfirmedItems}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,0,6,6" Padding="8,4" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Brush.Surface.ContainerHigh}" ToolTip="{Binding FullPath}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Name}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="6,0,0,0" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                          <ComboBox Grid.Row="0" Height="36" ItemsSource="{Binding UnconfirmedCategoryChoices}" SelectedItem="{Binding SelectedUnconfirmedCategory, Mode=TwoWay}" AutomationProperties.Name="选择归属文件夹" />
                          <Button Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="确认归属并导入" Command="{Binding ConfirmUnconfirmedImportCommand}" AutomationProperties.Name="确认归属并导入" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <TextBlock Text="本次导入摘要" Style="{StaticResource Inspector.SectionLabel}" Margin="0,20,0,0" />
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Padding="10,8" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                          <TextBlock x:Name="ImportSuccessText" HorizontalAlignment="Center" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" Text="{Binding ImportSuccessCount}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform x:Name="ImportSuccessScale" ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                          </TextBlock>
                          <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Text="成功" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Padding="10,8" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                          <TextBlock x:Name="ImportSkippedText" HorizontalAlignment="Center" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Bold" Foreground="{DynamicResource Brush.Tertiary}" Text="{Binding ImportSkippedCount}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform x:Name="ImportSkippedScale" ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                          </TextBlock>
                          <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Text="跳过" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="4" Padding="10,8" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                          <TextBlock x:Name="ImportFailedText" HorizontalAlignment="Center" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Danger}" Text="{Binding ImportFailedCount}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform x:Name="ImportFailedScale" ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                          </TextBlock>
                          <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Text="失败" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </Border>
                </Grid>
                </DockPanel>
              </Border>
            </Grid>
            <Grid Name="PreviewPage" Style="{StaticResource PageSurface}" Visibility="{Binding IsPreviewPage, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource Layout.PagePanel}" Padding="16">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource Layout.PageTitle}" Text="{Binding PageTitle}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" Text="{Binding PageSubtitle}" />
                  </StackPanel>
                <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Expander x:Name="BrowseConditionsPanel" Grid.Row="0" Header="浏览条件"
                        IsExpanded="{Binding IsBrowseConditionsExpanded, Mode=TwoWay}" Margin="0,0,0,14">
                <Expander.HeaderTemplate>
                  <DataTemplate>
                    <DockPanel MinHeight="38" LastChildFill="True" ClipToBounds="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="重置" Command="{Binding DataContext.ResetBrowseConditionsCommand, RelativeSource={RelativeSource AncestorType=Expander}}" Padding="10,5" Margin="6,0,6,0" />
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="浏览条件" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DataContext.BrowseConditionsSummary, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </Expander.HeaderTemplate>
                <Border x:Name="BrowseSummaryCard" Style="{DynamicResource Card.Default}" Padding="18,14" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="{DynamicResource Brush.Surface.Subtle}" Foreground="{DynamicResource Brush.Text.Primary}" Padding="10,5" Margin="0,0,10,0" Command="{Binding DeleteSelectedFilesCommand}" Visibility="{Binding HasSelectedFiles, Converter={StaticResource BoolToVis}}">
                      <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"><Path Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                        <TextBlock Text="删除选中" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <TextBlock Text="当前浏览" Opacity="0.62" FontSize="{StaticResource Typography.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding SelectedDateTitle}" />
                    <Border Margin="14,0,0,0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Padding="10,5" VerticalAlignment="Center">
                      <TextBlock Opacity="0.88" FontSize="{StaticResource Typography.Caption}" Text="{Binding PreviewSummaryText}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              </Expander>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" LastChildFill="True">
                  <StackPanel x:Name="BrowseSidebarThumbnailControls" DockPanel.Dock="Bottom" Width="250" Margin="0,10,14,4">
                    <StackPanel Visibility="{Binding IsGridBrowseMode, Converter={StaticResource BoolToVis}}">
                      <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ZoomableGridTileSize, StringFormat={}{0:N0}px}" />
                        <TextBlock Text="缩略图大小" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="−" Style="{StaticResource Button.Icon}" Width="32" Height="32" Padding="0" Click="GalleryZoomOut_Click" ToolTip="缩小缩略图" />
                        <Slider x:Name="GalleryZoomSlider" Grid.Column="2" Minimum="48" Maximum="512" Value="{Binding ZoomableGridTileSize, Mode=OneWay}" ValueChanged="GalleryZoomSlider_ValueChanged" ToolTip="调整缩略图大小" />
                        <Button Grid.Column="4" Content="+" Style="{StaticResource Button.Icon}" Width="32" Height="32" Padding="0" Click="GalleryZoomIn_Click" ToolTip="放大缩略图" />
                      </Grid>
                      <DockPanel Margin="0,5,0,0">
                        <Button DockPanel.Dock="Right" Content="重置" Style="{StaticResource Button.Ghost}" MinHeight="24" Padding="8,2" FontSize="{StaticResource Typography.Caption}" Click="GalleryZoomReset_Click" />
                        <TextBlock Text="Ctrl + 滚轮：以指针位置缩放" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" VerticalAlignment="Center" />
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <Border Width="250" Style="{DynamicResource Card.Default}" Padding="14" Margin="0,0,14,14" Visibility="{Binding IsBrowseConditionsExpanded, Converter={StaticResource BoolToVis}}">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                          <Button DockPanel.Dock="Left" Content="‹" Width="34" Height="32" Padding="0" Margin="0" Command="{Binding PreviousCalendarMonthCommand}" />
                          <Button DockPanel.Dock="Right" Content="›" Width="34" Height="32" Padding="0" Margin="0" Command="{Binding NextCalendarMonthCommand}" />
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" Text="{Binding CalendarMonthTitle}" />
                        </DockPanel>
                        <Button Margin="0,0,0,10" Height="34" Padding="10,0" Content="全部日期" Command="{Binding ShowAllDatesCommand}" AutomationProperties.Name="返回全部日期" />
                        <UniformGrid Columns="7" Margin="0,0,0,5">
                          <TextBlock Text="一" HorizontalAlignment="Center" Opacity="0.58" FontSize="{StaticResource Typography.Caption}" />
                          <TextBlock Text="二" HorizontalAlignment="Center" Opacity="0.58" FontSize="{StaticResource Typography.Caption}" />
                          <TextBlock Text="三" HorizontalAlignment="Center" Opacity="0.58" FontSize="{StaticResource Typography.Caption}" />
                          <TextBlock Text="四" HorizontalAlignment="Center" Opacity="0.58" FontSize="{StaticResource Typography.Caption}" />
                          <TextBlock Text="五" HorizontalAlignment="Center" Opacity="0.58" FontSize="{StaticResource Typography.Caption}" />
                          <TextBlock Text="六" HorizontalAlignment="Center" Opacity="0.58" FontSize="{StaticResource Typography.Caption}" />
                          <TextBlock Text="日" HorizontalAlignment="Center" Opacity="0.58" FontSize="{StaticResource Typography.Caption}" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                              <Button Height="32" Padding="0" Margin="2" FontSize="{StaticResource Typography.BodySmall}" Content="{Binding DayText}" IsEnabled="{Binding IsAvailable}" Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <FrameworkElement.Style>
                                  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                    <Setter Property="UIElement.Opacity" Value="0.46" />
                                    <Style.Triggers>
                                      <DataTrigger Value="False" Binding="{Binding IsCurrentMonth}">
                                        <Setter Property="UIElement.Opacity" Value="0.16" />
                                      </DataTrigger>
                                      <DataTrigger Value="True" Binding="{Binding IsAvailable}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                        <Setter Property="UIElement.Opacity" Value="1" />
                                      </DataTrigger>
                                      <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="亮起日期包含照片；灰色日期不可点击" TextWrapping="Wrap" FontSize="{StaticResource Typography.Caption}" Opacity="0.62" Margin="2,10,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Width="250" HorizontalAlignment="Left" Style="{DynamicResource Card.Default}" Padding="14" Margin="0,0,14,0">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="人物" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <Button DockPanel.Dock="Right" Padding="10,4" Content="扫描" Command="{Binding PeopleAlbums.ScanCommand}" AutomationProperties.Name="在本机扫描人物相册" />
                        </DockPanel>
                        <TextBlock Text="{Binding PeopleAlbums.StatusText}" Opacity="0.68" TextWrapping="Wrap" FontSize="{StaticResource Typography.Caption}" Margin="0,0,0,10" />
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding PeopleAlbums.ScanProgressValue, Mode=OneWay}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}" />
                        <Button Margin="0,6,0,8" Content="取消扫描" Command="{Binding PeopleAlbums.CancelScanCommand}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding PeopleAlbums.SummaryText}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="返回全部照片" Margin="0,0,0,8" Command="{Binding PeopleAlbums.ClearSelectionCommand}" Visibility="{Binding PeopleAlbums.SelectedAlbum, Converter={StaticResource NullToVis}}" />
                        <Button x:Name="PeopleBubbleButton" Content="显示全部人物" Margin="0,2,0,0" Command="{Binding PeopleAlbums.ToggleBubblesCommand}" />
                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="18" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Visibility="{Binding PeopleAlbums.AreBubblesOpen, Converter={StaticResource BoolToVis}}">
                           <ItemsControl ItemsSource="{Binding PeopleAlbums.Albums}" MaxWidth="330">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PersonAlbumItemViewModel}">
                              <StackPanel Width="88" Margin="0,0,8,12">
                                <Button Width="68" Height="68" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Command="{Binding SelectCommand}" ToolTip="点击只看此人物">
                                  <Border Width="68" Height="68" CornerRadius="9" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1.5">
                                    <Border.Background><ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill" /></Border.Background>
                                  </Border>
                                </Button>
                                <DockPanel Margin="0,5,0,0">
                                  <Button DockPanel.Dock="Right" Width="22" Height="25" Padding="0" Content="✓" FontSize="{StaticResource Typography.Caption}" Command="{Binding SaveNameCommand}" ToolTip="保存姓名" />
                                  <TextBox Height="25" Padding="5,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="{StaticResource Typography.Caption}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="可自定义姓名" />
                                </DockPanel>
                                <TextBlock HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="{StaticResource Typography.Caption}" Opacity="0.58" Text="{Binding PhotoCount, StringFormat={}{0} 张}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                           </ItemsControl>
                        </Border>
                        <Button Content="清除人物筛选" Margin="0,6,0,0" Command="{Binding PeopleAlbums.ClearSelectionCommand}" Visibility="{Binding PeopleAlbums.SelectedAlbum, Converter={StaticResource NullToVis}}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  </ScrollViewer>
                </DockPanel>
                <Border x:Name="BrowseUnifiedWorkspace" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="16">
                  <Grid>
                  <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="0" CornerRadius="{StaticResource Radius.Control}" Background="Transparent" BorderThickness="0" Visibility="{Binding IsBrowseConditionsExpanded, Converter={StaticResource BoolToVis}}">
                      <StackPanel>
                      <!-- 合并搜索：文件名 / 语义描述统一入口 -->
                      <Border Background="Transparent" BorderThickness="0" Margin="0,0,0,10" Padding="0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <StackPanel>
                            <TextBlock Text="智能搜索" Style="{DynamicResource Layout.SettingsFieldLabel}" Margin="0,0,0,6" />
                            <TextBox x:Name="BrowseSmartSearchBox"
                                     Style="{StaticResource Input.TextBox}"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding UnifiedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="智能搜索照片"
                                     ToolTip="输入文件名或路径直接匹配；输入自然描述进行语义搜索。" />
                          </StackPanel>
                          <ComboBox Grid.Column="1" Width="116" Height="36" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    ItemsSource="{Binding BrowseSearchModeChoices}"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding BrowseSearchMode, Mode=TwoWay}"
                                    AutomationProperties.Name="智能搜索模式">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Button Grid.Column="2"
                                  Style="{DynamicResource Button.Ghost}"
                                  Height="36"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Bottom"
                                  Content="取消"
                                  Command="{Binding SemanticSearch.CancelCommand}"
                                  Visibility="{Binding SemanticSearch.IsBusy, Converter={StaticResource BoolToVis}}" />
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                      Visibility="{Binding SemanticSearch.HasActiveQuery, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Minimum="0" Maximum="100" Height="{StaticResource Spacing.6}"
                                         Value="{Binding SemanticSearch.ProgressValue, Mode=OneWay}"
                                         Visibility="{Binding SemanticSearch.IsBusy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding SemanticSearch.StatusText}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <!-- 高频筛选（分类 / 修图状态 / 评分分类）+ 高级筛选折叠入口 -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                          <StackPanel VerticalAlignment="Center" Margin="0,0,16,10">
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Vertical" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding FeatureDescriptionPosition}" Value="Left">
                                    <Setter Property="Orientation" Value="Horizontal" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <TextBlock Text="分类" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Margin" Value="2,0,0,6" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding FeatureDescriptionPosition}" Value="Left">
                                      <Setter Property="Margin" Value="0,0,14,0" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <ComboBox MinWidth="130" Height="36" ItemsSource="{Binding PreviewCategoryFilters}" SelectedItem="{Binding CurrentPreviewCategory, Mode=TwoWay}" AutomationProperties.Name="按分类筛选" />
                          </StackPanel>
                          <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="修图状态" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Margin="2,0,0,6" />
                            <Border Padding="2" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                              <StackPanel Orientation="Horizontal">
                                <Button Content="全部" Tag="全部" CommandParameter="全部" Style="{StaticResource PreviewSegmentButton}" AutomationProperties.Name="显示全部照片" Command="{Binding SetPreviewRetouchFilterCommand}" />
                                <Button Content="已修" Tag="已修" CommandParameter="已修" Style="{StaticResource PreviewSegmentButton}" AutomationProperties.Name="仅显示已修照片" Command="{Binding SetPreviewRetouchFilterCommand}" />
                                <Button Content="未修" Tag="未修" CommandParameter="未修" Style="{StaticResource PreviewSegmentButton}" AutomationProperties.Name="仅显示未修照片" Command="{Binding SetPreviewRetouchFilterCommand}" />
                              </StackPanel>
                            </Border>
                          </StackPanel>
                          <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="评分分类" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Margin="2,0,0,6" />
                            <ComboBox MinWidth="130" Height="36" ItemsSource="{Binding RatingFilters}" SelectedItem="{Binding RatingFilter, Mode=TwoWay}" AutomationProperties.Name="按照片评分筛选" />
                          </StackPanel>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,10">
                          <ToggleButton Style="{StaticResource Toggle.ModeButton}"
                                        IsChecked="{Binding IsMultiSelectMode, Mode=TwoWay}"
                                        AutomationProperties.Name="多选模式"
                                        ToolTip="多选模式：开启后单击可勾选多张照片">
                            <StackPanel Orientation="Horizontal">
                              <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"><Path Data="{StaticResource Icon.CheckSquare}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                              <TextBlock Text="多选" VerticalAlignment="Center" />
                            </StackPanel>
                          </ToggleButton>
                          <Button Style="{StaticResource Button.Disclosure}" Command="{Binding ToggleAdvancedFiltersCommand}" Margin="8,0,0,0" AutomationProperties.Name="展开或收起高级筛选">
                            <StackPanel Orientation="Horizontal">
                              <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"><Path Data="{StaticResource Icon.Settings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                              <TextBlock Text="高级筛选" VerticalAlignment="Center" />
                              <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" FontSize="{StaticResource Typography.Caption}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▸" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsAdvancedFiltersExpanded}" Value="True">
                                        <Setter Property="Text" Value="▾" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Grid>
                      <!-- 高级筛选（默认收起，180ms M3 缓动） -->
                      <Border ClipToBounds="True">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="MaxHeight" Value="0" />
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsAdvancedFiltersExpanded}" Value="True">
                                <DataTrigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="400" Duration="{StaticResource Motion.Duration.Normal}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Duration.Normal}" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="{StaticResource Motion.Duration.Normal}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Duration.Normal}" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </DataTrigger.ExitActions>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel Margin="0,10,0,0" IsEnabled="{Binding IsAdvancedFiltersExpanded}">
                          <WrapPanel>
                            <StackPanel Margin="0,0,16,10">
                              <TextBlock Text="排列方式" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Margin="2,0,0,6" />
                              <ComboBox SelectedValuePath="Value" Style="{StaticResource PreviewSortComboBox}" AutomationProperties.Name="照片排列方式" ItemsSource="{Binding PreviewSortChoices}" SelectedValue="{Binding PreviewSortMode, Mode=TwoWay}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type vm:PreviewSortChoice}">
                                    <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Body}" Text="{Binding Label}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ComboBox>
                            </StackPanel>
                          </WrapPanel>
                          <DockPanel LastChildFill="True" Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Center">
                              <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding PhotoAnalysis.ProgressValue, Mode=OneWay}" />
                              <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" Text="{Binding PhotoAnalysis.StatusText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
