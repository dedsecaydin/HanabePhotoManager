                                        </Rectangle>
                                        <Rectangle Fill="{DynamicResource Brush.Accent.Subtle}" />
                                        <Rectangle>
                                          <Shape.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
