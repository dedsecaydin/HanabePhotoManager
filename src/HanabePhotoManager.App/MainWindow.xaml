                      </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" Text="例：找上周婚礼里新娘的照片 · 打开 10.26 · 哪些拍摄日还没修图 · 把 11.04 的备注改成婚礼。改文件前会先问你。" />
