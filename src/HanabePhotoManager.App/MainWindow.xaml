                      </ScrollViewer>
                      <Border Grid.Column="1" Padding="16" CornerRadius="22" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedDeviceTitle}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.84" Margin="0,4,0,0" Text="{Binding SelectedDeviceSummary}" />
