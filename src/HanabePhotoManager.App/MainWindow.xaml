                          <TextBlock Text="素材" FontWeight="SemiBold" />
                          <TextBlock Text="项目素材" FontSize="12" Opacity="0.84" />
                        </StackPanel>
                      </Border>
                    </UniformGrid>
                  </StackPanel>
                </Border>
