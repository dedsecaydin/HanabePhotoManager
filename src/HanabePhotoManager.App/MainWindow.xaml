                          <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="66" Text="分辨率" Style="{StaticResource Inspector.FieldLabel}" /><TextBlock Text="{Binding SelectedFileMetadata.Dimensions}" Style="{StaticResource Inspector.FieldValue}" /></DockPanel>
