<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HanabePhotoManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:HanabePhotoManager.App.ViewModels" xmlns:navigation="clr-namespace:HanabePhotoManager.App.Navigation" xmlns:albums="clr-namespace:HanabePhotoManager.App.Albums" xmlns:map="clr-namespace:HanabePhotoManager.App.Map" xmlns:compress="clr-namespace:HanabePhotoManager.App.Compression" xmlns:watermark="clr-namespace:HanabePhotoManager.App.Watermark" xmlns:treemap="clr-namespace:HanabePhotoManager.App.Browsing.Treemap" xmlns:grid="clr-namespace:HanabePhotoManager.App.Browsing.Grid" xmlns:local="clr-namespace:HanabePhotoManager.App" xmlns:controls="clr-namespace:HanabePhotoManager.App.Controls" Title="照片管理器" Icon="Assets/HanabeApp.ico" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource Brush.Background.Canvas}" FontFamily="{StaticResource Typography.FontFamily.UI}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Width="{Binding WindowWidth, Mode=TwoWay}" Height="{Binding WindowHeight, Mode=TwoWay}" KeyDown="MainWindow_KeyDown" KeyUp="MainWindow_KeyUp" SizeChanged="MainWindow_SizeChanged">
  <!-- 一体化标题栏（Memory Diary 风格，2026-08-14）：无边框纯客户区 + 自定义窗口控制按钮，
       无应用名文字（Title 保留仅用于进程识别）；CaptionHeight=0 隐藏系统标题栏文字；
       ResizeBorderThickness=8 保留拖边缩放；GlassFrameThickness=-1 去 DWM resize frame 白条。
       拖拽移动 = 顶栏/侧栏 logo 区 PreviewMouseLeftButtonDown → DragMove（code-behind）。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <local:CategoryEqualsConverter x:Key="CategoryEqualsConverter" />
      <local:CategoryEqualityMultiConverter x:Key="CategoryEqualityMultiConverter" />
      <local:ExtensionBadgeConverter x:Key="ExtensionBadgeConverter" />
      <local:NullToVisibilityConverter x:Key="NullToVis" />
      <local:PathThumbnailConverter x:Key="PathThumb" />
      <DataTemplate x:Key="SidebarFooterContentTemplate">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Viewbox x:Name="FooterNavigationIcon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Viewbox>
          <TextBlock x:Name="FooterNavigationLabel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding}" />
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Text">
            <Setter TargetName="FooterNavigationIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="FooterNavigationLabel" Property="Grid.Column" Value="0" /><Setter TargetName="FooterNavigationLabel" Property="Grid.ColumnSpan" Value="2" /><Setter TargetName="FooterNavigationLabel" Property="Margin" Value="0" />
          </DataTrigger>
          <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Icon">
            <Setter TargetName="FooterNavigationIcon" Property="Grid.ColumnSpan" Value="2" /><Setter TargetName="FooterNavigationIcon" Property="HorizontalAlignment" Value="Center" /><Setter TargetName="FooterNavigationLabel" Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" CornerRadius="{StaticResource Radius.Control}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="{DynamicResource Brush.Surface.Interactive}" />
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="{DynamicResource Brush.Surface.Selected}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                  <Setter TargetName="Chrome" Property="Border.BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                  <Setter TargetName="Chrome" Property="Border.Background" Value="{DynamicResource Brush.Surface.Disabled}" />
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="{DynamicResource Brush.Border.Disabled}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- 一体化标题栏窗口控制按钮（Memory Diary 风格）：无应用名文字，仅最小化/最大化/关闭；
           悬停用 Surface 状态层，关闭键悬停 Danger 色调；颜色全取语义 Token -->
      <Style x:Key="Window.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
            <Setter Property="BorderThickness" Value="2" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Window.CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource Window.CaptionButton}">
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.Status.DangerSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
          </Trigger>
        </Style.Triggers>
      </Style>
