                            <Button Content="3★" Padding="7,4" Margin="0,0,5,0" Command="{Binding PhotoViewer.SetRatingCommand}" CommandParameter="3" />
                            <Button Content="4★" Padding="7,4" Margin="0,0,5,0" Command="{Binding PhotoViewer.SetRatingCommand}" CommandParameter="4" />
                            <Button Content="5★" Padding="7,4" Command="{Binding PhotoViewer.SetRatingCommand}" CommandParameter="5" />
                          </StackPanel>
                          <TextBlock Text="{Binding PhotoViewer.Rating, StringFormat=当前评分　{0} / 5}" Margin="0,0,0,12" />
                          <Button Content="移入回收站　Delete" Command="{Binding PhotoViewer.DeleteCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                          <TextBlock Text="{Binding PhotoViewer.ErrorText}" Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" Margin="0,0,0,12" />
                          <TextBlock Text="文件信息" FontSize="{StaticResource Typography.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.FileSize, StringFormat=大小　{0}}" Margin="0,5" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.Dimensions, StringFormat=分辨率　{0}}" Margin="0,5" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.TakenAt, StringFormat=拍摄时间　{0}}" Margin="0,5" TextWrapping="Wrap" />
                          <Separator Margin="0,15" />
                          <TextBlock Text="拍摄参数" FontSize="{StaticResource Typography.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.Iso, StringFormat=ISO　{0}}" Margin="0,5" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.Aperture, StringFormat=光圈　{0}}" Margin="0,5" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.Shutter, StringFormat=快门　{0}}" Margin="0,5" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.FocalLength, StringFormat=焦距　{0}}" Margin="0,5" />
                          <Separator Margin="0,15" />
                          <TextBlock Text="设备与位置" FontSize="{StaticResource Typography.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.Camera, StringFormat=相机　{0}}" Margin="0,5" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.Lens, StringFormat=镜头　{0}}" Margin="0,5" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding PhotoViewer.Metadata.Location, StringFormat=位置　{0}}" Margin="0,5" TextWrapping="Wrap" />
                          <TextBlock Margin="0,20,0,0" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}" Text="方向键 ← ↑ 上一张　→ ↓ 下一张" />
                        </StackPanel>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </Grid>
                </Border>
                </Grid>
                </DockPanel>
              </Border>
            </Grid>
            <Grid Name="FaceSearchPage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource PageSurface}" Visibility="{Binding IsFaceSearchPage, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource Layout.PagePanel}" Padding="0">
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="Familiar faces" Style="{DynamicResource Layout.Eyebrow}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Layout.PageTitle}" Text="{Binding PageTitle}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" Text="{Binding PageSubtitle}" />
                  </StackPanel>
                <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- 分段切换：人物相册 / 按脸查找 -->
              <Border Grid.Row="0" Style="{StaticResource Navigation.Segment}" HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="PeopleTabGroupsButton" Content="人物相册" GroupName="PeopleMainTab" Style="{StaticResource Navigation.SegmentItem}" IsChecked="True" Checked="PeopleMainTab_Checked" AutomationProperties.Name="人物相册标签页" />
                  <RadioButton x:Name="PeopleTabSearchButton" Content="按脸查找" GroupName="PeopleMainTab" Style="{StaticResource Navigation.SegmentItem}" Checked="PeopleMainTab_Checked" AutomationProperties.Name="按脸查找标签页" />
                </StackPanel>
              </Border>

              <!-- Tab 1：人物相册 -->
              <Grid Grid.Row="1">
                <!-- 人物总览：状态条 / 工具条（搜索 · 排序 · 隐藏照片很少的人物）/ 虚拟化头像网格（只解码屏幕上的头像） -->
                <DockPanel x:Name="PeopleGroupsPanel" LastChildFill="True">
                  <!-- 扫描状态条：模型徽章 / 汇总 / 进度 -->
                  <Border DockPanel.Dock="Top" Margin="0,0,0,14" Padding="16,14" Style="{DynamicResource Layout.GlassPanel}" controls:Motion.RevealOrder="0">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="取消扫描" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Command="{Binding PeopleAlbums.CancelScanCommand}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}" />
                        <Button Content="扫描人物" Style="{StaticResource Button.Primary}" Command="{Binding PeopleAlbums.ScanCommand}" AutomationProperties.Name="在本机扫描人物相册" ToolTip="增量扫描：已识别过的照片会直接复用结果" />
                      </StackPanel>
                      <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.PrimaryContainer}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.FaceSearch}" Stroke="{DynamicResource Brush.OnPrimaryContainer}" StrokeThickness="1.7" Width="22" Height="22" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Border>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding PeopleAlbums.SummaryText}" FontSize="{StaticResource Typography.BodySmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding PeopleAlbums.StatusText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PeopleAlbums.RecognitionEngineText, Mode=OneWay}" /><Run Text=" · 全部在本机完成" />
                        </TextBlock>
                        <ProgressBar Height="5" Minimum="0" Maximum="100" Margin="0,8,0,0" Value="{Binding PeopleAlbums.ScanProgressValue, Mode=OneWay}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <!-- 工具条 -->
                  <Grid DockPanel.Dock="Top" Margin="2,0,2,10" controls:Motion.RevealOrder="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="人物相册" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding PeopleAlbums.OverviewSummaryText}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="12,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="220" Height="36" Margin="0,0,10,0" VerticalContentAlignment="Center" Style="{DynamicResource Input.TextBox}" Text="{Binding PeopleAlbums.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名字搜索人物（搜索时会包含照片很少的人物）" AutomationProperties.Name="搜索人物" />
                    <ComboBox Grid.Column="3" Width="132" Height="36" Margin="0,0,12,0" Style="{StaticResource Input.ComboBox}" ItemsSource="{x:Static vms:PeopleAlbumViewModel.SortModes}" SelectedItem="{Binding PeopleAlbums.SortMode}" AutomationProperties.Name="人物排序" ToolTip="排序方式" />
                    <CheckBox Grid.Column="4" Content="隐藏照片很少的人物" Style="{StaticResource Input.Switch}" VerticalAlignment="Center" IsChecked="{Binding PeopleAlbums.HideSmallAlbums}" ToolTip="只出现 1–2 次的人物多是路人或背景里的脸" AutomationProperties.Name="隐藏照片很少的人物" />
                  </Grid>

                  <!-- 提示：已收起的路人 -->
                  <Border DockPanel.Dock="Top" Margin="2,0,2,12" Padding="12,8" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerHigh}" Visibility="{Binding PeopleAlbums.HasHiddenSmallAlbums, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="全部显示" Style="{StaticResource Button.Ghost}" Padding="10,4" Command="{Binding PeopleAlbums.ShowSmallAlbumsCommand}" />
                      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" TextWrapping="Wrap">
                        <Run Text="已收起" /><Run Text="{Binding PeopleAlbums.HiddenSmallAlbumCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 个只出现 1–2 次的人物（多是路人）。常拍的人点头像进去起个名字，以后按名字就能找到。" />
                      </TextBlock>
                    </DockPanel>
                  </Border>

                  <!-- 空状态 -->
                  <Border DockPanel.Dock="Top" Margin="2,24,2,0" Padding="28" HorizontalAlignment="Left" MaxWidth="560">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Layout.GlassPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding PeopleAlbums.Albums.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock Text="还没有人物相册" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" />
                      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" LineHeight="22" Text="1. 点右上角「扫描人物」，在本机识别 JPG 里的人脸（RAW 继承同名 JPG 的结果）。&#x0a;2. 同一个人会自动归到一组；点头像可以改名、合并、移出误识别。&#x0a;3. 「按脸查找」放一张参考照片，在整个图库里找相似的人。" />
                    </StackPanel>
                  </Border>
                  <TextBlock DockPanel.Dock="Top" Margin="4,8,0,0" Text="没有找到这个名字的人物。" Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="{Binding PeopleAlbums.HasNoSearchResults, Converter={StaticResource BoolToVis}}" />

                  <!-- 头像网格：圆形头像、悬停轻浮起；虚拟化，几百个人物也只解码可见部分 -->
                  <ListBox x:Name="PeopleAlbumsGrid" ItemsSource="{Binding PeopleAlbums.VisibleAlbums}" Style="{StaticResource List.Default}"
                           VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                           AutomationProperties.Name="人物相册" controls:Motion.RevealOrder="2">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="168" ItemHeight="206" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type vms:PersonAlbumItemViewModel}">
                        <Button Margin="4,4,4,8" Padding="8,12" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" Command="{Binding SelectCommand}" ToolTip="查看此人物的照片，可改名 / 合并" Cursor="Hand" AutomationProperties.Name="{Binding Name}" controls:Motion.HoverLift="True">
                          <StackPanel>
                            <Grid Width="116" Height="116" HorizontalAlignment="Center">
                              <Ellipse Fill="{DynamicResource Brush.Surface.Container}" Stroke="{DynamicResource Brush.OutlineVariant}" StrokeThickness="1" />
                              <Path Data="{StaticResource Icon.FaceSearch}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.6" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                              <Ellipse Margin="3">
                                <Ellipse.Fill><ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource PathThumb}}" Stretch="UniformToFill" /></Ellipse.Fill>
                              </Ellipse>
                              <Ellipse x:Name="NamedRing" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="2.5" Visibility="Collapsed" />
                              <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Padding="7,2" CornerRadius="10" Background="{DynamicResource Brush.Overlay.Scrim}">
                                <TextBlock Text="{Binding PhotoCount}" Foreground="{DynamicResource Brush.Viewer.Text}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                              </Border>
                            </Grid>
                            <TextBlock x:Name="PersonName" Text="{Binding Name}" FontSize="{StaticResource Typography.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,10,0,0" MaxWidth="140" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding PhotoCount, StringFormat={}{0} 张照片}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                          </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                          <!-- 已命名的人物：粉色描边 + 主色名字，一眼区分“认识的人” -->
                          <DataTrigger Binding="{Binding IsNamed}" Value="True">
                            <Setter TargetName="NamedRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PersonName" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
                <!-- 人物详情：头部 / 照片网格（独立滚动）/ 底部整理按钮。以前按钮没有指定行，会叠在头部上 -->
                <Grid x:Name="PeopleGroupsDetail" Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0">
                    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="12,7" Content="← 全部人物" Command="{Binding PeopleAlbums.ClearSelectionCommand}" AutomationProperties.Name="返回全部人物" />
                    <Border Margin="0,0,0,16" Padding="20,22" Background="Transparent" BorderThickness="0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="112" Height="112" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.Container}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                          <Grid>
                            <Path Data="{StaticResource Icon.FaceSearch}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.6" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Rectangle>
                              <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding PeopleAlbums.SelectedAlbum.CoverPath}" Stretch="UniformToFill" />
                              </Rectangle.Fill>
                            </Rectangle>
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,18,0">
                          <TextBlock Text="{Binding PeopleAlbums.SelectedAlbum.Name}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding PeopleAlbums.SelectedAlbum.PhotoCount, StringFormat={}{0} 张照片}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}" Margin="0,4,0,0" />
                          <DockPanel Margin="0,12,0,0" MaxWidth="680" HorizontalAlignment="Left">
                            <Button DockPanel.Dock="Right" Content="保存姓名" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding PeopleAlbums.SelectedAlbum.SaveNameCommand}" ToolTip="保存该人物姓名" />
                            <Button DockPanel.Dock="Right" Content="合并到…" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding PeopleAlbums.MergeCommand}" ToolTip="将当前人物并入另一个人物，并删除当前人物" />
                            <Button DockPanel.Dock="Right" Content="复核这个人物" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Command="{Binding PeopleAlbums.ReviewSelectedAlbumCommand}" ToolTip="重新比对每张照片：不太像的移到「待确认」，不删除照片，可撤销" AutomationProperties.Name="复核这个人物" />
                            <TextBox Width="220" Text="{Binding PeopleAlbums.SelectedAlbum.Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="可自定义人物姓名" AutomationProperties.Name="人物姓名" />
                          </DockPanel>
                          <!-- 复核 / 整理的进度与结果 -->
                          <TextBlock Margin="0,10,0,0" Text="{Binding PeopleAlbums.StatusText}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" />
                          <ProgressBar Margin="0,6,0,0" Height="5" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="{Binding PeopleAlbums.ScanProgressValue, Mode=OneWay}" Visibility="{Binding PeopleAlbums.IsEditing, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding PeopleAlbums.SelectedAlbum.PhotoCount}" FontSize="{StaticResource Typography.Display}" FontWeight="Bold" HorizontalAlignment="Center" />
                          <TextBlock Text="张照片" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <!-- 照片标题行：左边“照片 · N 张”，右边是针对选中照片的整理操作（原来放在列表下方一行，会和标题叠在一起） -->
                    <DockPanel Margin="2,0,2,12" LastChildFill="False">
                      <TextBlock DockPanel.Dock="Left" Text="照片" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="点选一张照片后可以移出或拆分，照片文件不会被修改" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" />
                        <Button Content="移出误识别" Style="{StaticResource Button.Secondary}" Padding="12,5" Margin="0,0,8,0" Command="{Binding PeopleAlbums.RemovePhotoCommand}" ToolTip="把选中的照片从这个人物里移出（不是他/她）" />
                        <Button Content="拆分为新人物" Style="{StaticResource Button.Secondary}" Padding="12,5" Margin="0,0,8,0" Command="{Binding PeopleAlbums.SplitPhotoCommand}" ToolTip="选中的照片其实是另一个人：单独建一个人物" />
                        <Button Content="撤销最近整理" Style="{StaticResource Button.Ghost}" Padding="10,5" Command="{Binding PeopleAlbums.UndoCommand}" />
                      </StackPanel>
                      <Border DockPanel.Dock="Left" Margin="10,0,0,0" Padding="10,3" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHigh}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeopleAlbums.SelectedAlbum.PhotoCount, StringFormat={}{0} 张}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                      </Border>
                    </DockPanel>
                  </StackPanel>
                  <ListBox Grid.Row="1"
                            ItemsSource="{Binding PeopleAlbums.SelectedAlbum.Photos}"
                            SelectedItem="{Binding PeopleAlbums.SelectedPhoto, Mode=TwoWay}"
                             Style="{StaticResource List.Default}"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="该人物的照片">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <controls:VirtualizingWrapPanel ItemWidth="142" ItemHeight="142" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="0" />
                          <Setter Property="MinHeight" Value="0" />
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="VerticalContentAlignment" Value="Stretch" />
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderThickness" Value="0" />
                          <Setter Property="Focusable" Value="False" />
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vms:PersonPhotoViewModel}">
                          <Border Width="132" Height="132" Margin="0,0,10,10" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Container}" ClipToBounds="True" Cursor="Hand" ToolTip="双击打开照片" MouseLeftButtonDown="PersonPhoto_MouseLeftButtonDown" Loaded="PersonPhoto_Loaded">
                            <Grid>
                              <Path Data="{StaticResource Icon.Library}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.6" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                              <!-- 显示整张照片而不是正方形中心裁切：横拍时人常站在画面一侧，裁切后会像“没有这个人” -->
                              <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
              </Grid>

              <!-- Tab 2：按脸查找 -->
              <Grid Grid.Row="1" x:Name="PeopleSearchPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="300" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="16" Background="Transparent" BorderThickness="0">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="参考人物" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" />
                      <TextBlock Text="建议使用脸部清晰、角度接近正面的照片。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}" Margin="0,4,0,12" />
                      <Border Height="220" CornerRadius="{StaticResource Radius.Card}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Background="{DynamicResource Brush.Surface.ContainerHigh}" ClipToBounds="True" AllowDrop="True" DragOver="FaceReference_DragOver" Drop="FaceReference_Drop">
                        <Grid x:Name="FaceReferenceClipSurface">
                          <Grid.OpacityMask>
                            <VisualBrush Stretch="Fill">
                              <VisualBrush.Visual>
                                <Border Width="100" Height="100" CornerRadius="21" Background="White"/>
                              </VisualBrush.Visual>
                            </VisualBrush>
                          </Grid.OpacityMask>
                          <Image Stretch="UniformToFill" Source="{Binding FaceSearch.ReferenceImage}" />
                          <Border Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHigh}" IsHitTestVisible="False">
                            <TextBlock Text="仅本机运行" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                          </Border>
                          <StackPanel VerticalAlignment="Bottom" Margin="16" HorizontalAlignment="Center">
                            <TextBlock Text="拖入人脸照片" FontSize="{StaticResource Typography.Label}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="或点击下方选择参考照片" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Button Content="选择参考照片" Style="{StaticResource Button.Secondary}" Margin="0,12,0,0" Command="{Binding FaceSearch.ChooseReferenceCommand}" />
                      <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="2,8,2,14" Text="{Binding FaceSearch.ReferencePath}" ToolTip="{Binding FaceSearch.ReferencePath}" />

                      <TextBlock Text="查找范围" FontSize="{StaticResource Typography.Label}" FontWeight="SemiBold" />
                      <ComboBox Margin="0,8,0,0" ItemsSource="{Binding FaceSearch.SearchScopes}" SelectedItem="{Binding FaceSearch.SelectedSearchScope, Mode=TwoWay}" AutomationProperties.Name="人物查找范围" />
                      <Button Content="选择查找文件夹" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0" Command="{Binding FaceSearch.ChooseSearchFolderCommand}" Visibility="{Binding FaceSearch.IsCustomSearchScope, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="{Binding FaceSearch.SearchScopeSummary}" ToolTip="{Binding FaceSearch.SearchScopeSummary}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="2,8,2,14" />

                      <DockPanel>
                        <TextBlock Text="匹配强度" FontSize="{StaticResource Typography.Label}" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.Primary}" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding FaceSearch.SimilarityLabel}" />
                      </DockPanel>
                      <Slider Margin="0,6,0,4" Minimum="0.30" Maximum="0.72" TickFrequency="0.02" Value="{Binding FaceSearch.MinimumSimilarity}" />
                      <TextBlock Text="越高越严格；找不到时可稍微向左调。" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="0,0,0,14" />

                      <Button Content="开始查找" Height="44" Style="{StaticResource Button.Primary}" Command="{Binding FaceSearch.StartSearchCommand}" />
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="停止" Style="{StaticResource Button.Ghost}" Command="{Binding FaceSearch.CancelCommand}" />
                        <Button Grid.Column="1" Content="清除参考图" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding FaceSearch.ClearCommand}" />
                      </Grid>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
                <Border Grid.Column="2" Padding="16" Background="Transparent" BorderThickness="0">
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                      <DockPanel>
                        <TextBlock FontSize="{StaticResource Typography.Title}" FontWeight="Bold" Text="{Binding FaceSearch.ResultSummary}" />
                        <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHigh}" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0"><Path Data="{StaticResource Icon.Lock}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                            <TextBlock Text="仅在本机运行" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                      </DockPanel>
                      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}" Margin="0,6,0,10" Text="{Binding FaceSearch.StatusText}" />
                      <ProgressBar Minimum="0" Maximum="100" Height="6" Value="{Binding FaceSearch.ProgressValue, Mode=OneWay}" />
                      <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="0,6,0,0" Text="{Binding FaceSearch.ProgressText}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding FaceSearch.Results}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vms:FaceSearchResultViewModel}">
                            <Border Width="196" Margin="0,0,12,12" Padding="8" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" Cursor="Hand" ToolTip="双击打开照片" MouseLeftButtonDown="FaceResult_MouseLeftButtonDown">
                              <StackPanel>
                                <Border Height="148" CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True" Background="{DynamicResource Brush.Surface.Container}">
                                  <Grid>
                                    <Image Stretch="UniformToFill" Source="{Binding Thumbnail}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Primary}">
                                      <TextBlock Foreground="{DynamicResource Brush.OnPrimary}" FontWeight="Bold" FontSize="{StaticResource Typography.Caption}" Text="{Binding SimilarityText}" />
                                    </Border>
                                  </Grid>
                                </Border>
                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,8,4,0" Text="{Binding Name}" />
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" TextTrimming="CharacterEllipsis" Margin="4,3,4,2" Text="{Binding Folder}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Grid>
                </Grid>
                </DockPanel>
              </Border>
            </Grid>
            <map:MapPage x:Name="MapPageHost" Style="{StaticResource PageSurface}" DataContext="{Binding MapPhotos}" Visibility="{Binding DataContext.IsMapPhotosPage, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}" />
            <albums:CustomAlbumsPage x:Name="CustomAlbumsPageHost" Style="{StaticResource PageSurface}" DataContext="{Binding CustomAlbums}" Visibility="{Binding DataContext.IsCustomAlbumsPage, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}" />
            <compress:CompressionPage x:Name="CompressionPageHost" Style="{StaticResource PageSurface}" DataContext="{Binding Compression}" Visibility="{Binding DataContext.IsCompressionPage, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}" />
            <recovery:RecoveryPage x:Name="RecoveryPageHost" Style="{StaticResource PageSurface}" DataContext="{Binding Recovery}" Visibility="{Binding DataContext.IsRecoveryPage, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}" />
            <watermark:WatermarkPage x:Name="WatermarkPageHost" Style="{StaticResource PageSurface}" DataContext="{Binding Watermark}" Visibility="{Binding DataContext.IsWatermarkPage, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}" />
            <datefolders:DateFolderManagementPage x:Name="DateFolderManagementPageHost" Style="{StaticResource PageSurface}" DataContext="{Binding DateFolders}" Visibility="{Binding DataContext.IsDateFoldersPage, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}" />
            <local:SettingsCenterPage x:Name="SettingsCenterPageHost" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />
            <ScrollViewer Name="SettingsPage" Style="{StaticResource PageSurface}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{DynamicResource Card.Default}" Padding="18" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="智能识别与浏览默认值" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                    <TextBlock Text="这些选项设置一次即可，之后仍可回来调整。模型和照片数据始终保存在本机。" Margin="0,6,0,14" Opacity="0.70" />
                    <TextBlock Text="默认智能识别引擎" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding PhotoAnalysis.Engines}" SelectedItem="{Binding PhotoAnalysis.SelectedEngine, Mode=TwoWay}" />
                    <TextBlock Text="推理设备" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding InferenceDevices}" SelectedItem="{Binding InferenceDevice, Mode=TwoWay}" />
                    <TextBlock Text="GPU 运行环境不可用时会自动回退 CPU，不影响已有识别进度。" Margin="0,6,0,0" FontSize="{StaticResource Typography.Caption}" Opacity="0.62" />
                    <TextBlock Text="每张照片最多返回标签数" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding SemanticLabelCounts}" SelectedItem="{Binding SemanticMaxLabels, Mode=TwoWay}" />
                    <TextBlock Text="标签相似度范围（越小越严格）" Margin="0,14,0,6" />
                    <Slider Minimum="0.02" Maximum="0.30" TickFrequency="0.02" IsSnapToTickEnabled="True" Value="{Binding SemanticSimilarityWindow, Mode=TwoWay}" />
                    <TextBlock Text="浏览页默认评分筛选" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding RatingFilters}" SelectedItem="{Binding RatingFilter, Mode=TwoWay}" />
                    <TextBlock Text="浏览页默认排序" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding PreviewSortChoices}" SelectedValuePath="Value" SelectedValue="{Binding PreviewSortMode, Mode=TwoWay}">
                      <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:PreviewSortChoice}"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card.Default}" Padding="18" Margin="0,0,0,14">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                      <TextBlock Text="版本与更新日志" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                      <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="10" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                        <TextBlock Text="{Binding ReleaseNotes.CurrentVersionLabel}" FontSize="{StaticResource Typography.BodySmall}" FontWeight="SemiBold" />
                      </Border>
                    </DockPanel>
                    <Grid MinHeight="260">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ListBox x:Name="ReleaseVersionTree" BorderThickness="0" Background="Transparent" ItemsSource="{Binding ReleaseNotes.Versions}" SelectedItem="{Binding ReleaseNotes.SelectedVersion, Mode=TwoWay}" AutomationProperties.Name="版本更新树">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="4,5">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding BranchGlyph}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DateText}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                              </StackPanel>
                              <Border Grid.Column="2" Padding="7,2" CornerRadius="8" Background="{DynamicResource Brush.Surface.Subtle}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <Border Grid.Column="1" Background="{DynamicResource Brush.Border.Subtle}" />
                      <DockPanel Grid.Column="2" Margin="18,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ReleaseNotes.SelectedReleaseTitle}" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ScrollViewer x:Name="ReleaseNotesScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                          <TextBlock Text="{Binding ReleaseNotes.SelectedReleaseNotes}" TextWrapping="Wrap" LineHeight="24" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </ScrollViewer>
                      </DockPanel>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card.Default}" Padding="18" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="浏览状态" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                    <TextBlock Text="切换到浏览界面时如何处理上次查看的日期和筛选。" Margin="0,6,0,12" Opacity="0.70" />
                    <ComboBox ItemsSource="{Binding BrowseEntryModes}" SelectedValuePath="Value" SelectedValue="{Binding BrowseEntryModeSetting}">
                      <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:BrowseEntryChoice}"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Margin="0,8,0,0" FontSize="{StaticResource Typography.Caption}" Opacity="0.62" Text="跨启动恢复会保存日期、分类、搜索、排序和缩略图尺寸；目标日期不存在时自动返回全部日期。" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card.Default}" Padding="18" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="外观" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                    <TextBlock Text="玻璃强度" Margin="0,14,0,6" />
                    <Slider Minimum="0.25" Maximum="0.95" TickFrequency="0.05" Value="{Binding GlassIntensity}" />
                    <TextBlock Text="背景来源" Margin="0,14,0,6" />
                    <ComboBox Margin="0,12,0,0" ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding BackgroundMode}" />
                    <TextBlock Text="背景显示方式" Margin="0,14,0,6" />
                    <ComboBox Margin="0,0,0,0" ItemsSource="{Binding BackgroundImageLayouts}" SelectedItem="{Binding BackgroundImageLayout}" />
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox IsReadOnly="True" Text="{Binding CustomBackgroundPath}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="上传背景" Command="{Binding ChooseBackgroundCommand}" />
                        <Button Content="清除" Command="{Binding ClearBackgroundCommand}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="应用头像 / 窗口图标" Margin="0,18,0,8" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="56" Height="56" CornerRadius="20" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1.2" ClipToBounds="True">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource Color.Background.Canvas}" Offset="0" />
                            <GradientStop Color="{DynamicResource Color.Background.Canvas}" Offset="0.55" />
                            <GradientStop Color="{DynamicResource Color.Background.Canvas}" Offset="1" />
                          </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                          <Image Stretch="UniformToFill" Source="{DynamicResource Image.AppLogo}" />
                          <Image Stretch="UniformToFill" Source="{Binding AppIconImage}" Visibility="{Binding HasCustomAppIcon, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                      </Border>
                      <TextBox Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Text="{Binding CustomAppIconPath}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button Content="上传头像" Command="{Binding ChooseAppIconCommand}" />
                        <Button Content="清除" Command="{Binding ClearAppIconCommand}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card.Default}" Padding="18" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="启动与窗口" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                    <CheckBox Content="开机自启动 Hanabe Photo Manager" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,14,0,14" IsChecked="{Binding LaunchAtStartup}" />
                    <TextBlock Text="界面宽度" />
                    <Slider Minimum="1180" Maximum="2600" TickFrequency="20" Value="{Binding WindowWidth}" />
                    <TextBlock Text="界面高度" Margin="0,12,0,0" />
                    <Slider Minimum="760" Maximum="1600" TickFrequency="20" Value="{Binding WindowHeight}" />
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card.Default}" Padding="18">
                  <StackPanel>
                    <TextBlock Text="存储" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                    <TextBlock FontWeight="SemiBold" Margin="0,12,0,0" Text="{Binding SelectedFolderSize}" />
                    <TextBlock Opacity="0.88" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding SelectedFolderPercent}" />
                    <TextBlock Text="当前照片库" Opacity="0.86" Margin="0,14,0,4" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding LibraryRoot}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

        </DockPanel>
      </Border>
      <Border Grid.ColumnSpan="2" Panel.ZIndex="100" Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVis}}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay.Scrim}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsOnboardingLivePageStep}" Value="True"><Setter Property="Background" Value="{x:Null}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border Padding="32" CornerRadius="24" Background="{DynamicResource Brush.Background.Canvas}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Width" Value="640"/>
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnboardingLivePageStep}" Value="True">
                  <Setter Property="Width" Value="500"/>
                  <Setter Property="HorizontalAlignment" Value="Right"/>
                  <Setter Property="VerticalAlignment" Value="Top"/>
                  <Setter Property="Margin" Value="0,24,24,0"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Right" Text="{Binding OnboardingStepText}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
              <TextBlock Text="Hanabe 新手指南" Style="{StaticResource Layout.PageTitle}"/>
            </DockPanel>
            <ProgressBar Minimum="0" Maximum="{Binding OnboardingStepCount}" Value="{Binding OnboardingProgress, Mode=OneWay}" Height="6" Margin="0,14,0,24"/>
            <TextBlock Text="{Binding OnboardingTitle}" Style="{StaticResource Layout.SectionTitle}"/>
            <TextBlock Text="{Binding OnboardingDescription}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,10,0,18" LineHeight="24"/>
            <StackPanel Visibility="{Binding IsOnboardingLibraryStep, Converter={StaticResource BoolToVis}}" Margin="0,0,0,24">
              <TextBlock Text="当前图库根目录" Style="{StaticResource Layout.SettingsFieldLabel}"/>
              <TextBox Text="{Binding LibraryRoot}" IsReadOnly="True" Style="{StaticResource Input.TextBox}" Margin="0,6,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path Data="M 0,0 L 18,12 L 0,24" Stroke="{DynamicResource Brush.Border.Focus}" StrokeThickness="3" Width="20" Height="26" Stretch="Fill" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="选择图库根目录" Command="{Binding BrowseLibraryCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"/>
              </Grid>
            </StackPanel>
            <StackPanel Visibility="{Binding IsOnboardingSourceStep, Converter={StaticResource BoolToVis}}" Margin="0,0,0,24">
              <TextBlock Text="当前来源文件夹" Style="{StaticResource Layout.SettingsFieldLabel}"/>
              <TextBox Text="{Binding SourceFolder}" IsReadOnly="True" Style="{StaticResource Input.TextBox}" Margin="0,6,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path Data="M 0,0 L 18,12 L 0,24" Stroke="{DynamicResource Brush.Border.Focus}" StrokeThickness="3" Width="20" Height="26" Stretch="Fill" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="选文件夹" ToolTip="选择来源文件夹（单个）" Command="{Binding BrowseSourceCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"/>
              </Grid>
            </StackPanel>
            <TextBlock Visibility="{Binding IsOnboardingImportStep, Converter={StaticResource BoolToVis}}" Text="现在直接在导入页操作：点存储卡上的「导入这个设备」，或拖入 / 选择文件夹，会自动分析（只读）；在「检查确认」里看每个日期放到哪个文件夹，再点「开始导入」；完成实际操作后再结束指南。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,20"/>
            <Border Visibility="{Binding IsOnboardingLivePageStep, Converter={StaticResource BoolToVis}}" Style="{StaticResource Layout.SettingsGroup}" Margin="0,0,0,20">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 18,0 L 0,12 L 18,24" Stroke="{DynamicResource Brush.Border.Focus}" StrokeThickness="3" Width="20" Height="26" Stretch="Fill" Margin="0,0,12,0"/>
                <TextBlock Text="箭头所指区域就是当前正在介绍、可以直接操作的功能页面。" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <DockPanel Visibility="{Binding ShowStandardOnboardingNavigation, Converter={StaticResource BoolToVis}}">
              <Button DockPanel.Dock="Left" Content="跳过指南" Command="{Binding DismissOnboardingCommand}" Style="{StaticResource Button.Ghost}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="上一步" Command="{Binding PreviousOnboardingStepCommand}" Style="{StaticResource Button.Secondary}" IsEnabled="{Binding CanGoToPreviousOnboardingStep}"/>
                <Button Content="{Binding OnboardingPrimaryActionText}" Command="{Binding NextOnboardingStepCommand}" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"/>
              </StackPanel>
            </DockPanel>
            <StackPanel Visibility="{Binding IsOnboardingContinuationChoiceStep, Converter={StaticResource BoolToVis}}">
              <Button Content="暂时不用介绍了" Command="{Binding StopOnboardingCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
              <Button Content="请继续给我介绍" Command="{Binding ContinueOnboardingCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Grid>
  </AdornerDecorator>
</Window>


