                                          <Shape.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                              <GradientStop Color="{DynamicResource Color.Background.Canvas}" Offset="0" />
                                              <GradientStop Color="{DynamicResource Color.Background.Canvas}" Offset="1" />
                                            </LinearGradientBrush>
                                          </Shape.Fill>
