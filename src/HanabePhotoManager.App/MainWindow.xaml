                                      <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding Extension}" Value="MP4"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                          <DataTrigger Binding="{Binding Extension}" Value="MOV"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Grid.Style>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.Overlay.Scrim}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                      <Path Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.Viewer.Text}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Padding="5,2" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource Brush.Overlay.Scrim}" IsHitTestVisible="False">
                                      <TextBlock FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Viewer.Text}" Text="{Binding Extension}" />
                                    </Border>
                                  </Grid>
                                </Grid>
                              </Border>
                              <TextBlock FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" Text="{Binding Name}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Layout.HomeSection}">
