                                                  <TextBlock TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Viewer.Text}" Text="{Binding Name}" ToolTip="{Binding Name}" />
