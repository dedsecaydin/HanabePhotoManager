                  </Border>
                  <TextBlock Text="说明会随当前页面自动切换，可在右下角再次打开。" FontSize="{StaticResource Typography.Caption}"
                             Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,14,0,0" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Popup>
          <Popup x:Name="TaskCenterPopup" Placement="Bottom" HorizontalOffset="-340" PlacementTarget="{Binding ElementName=TaskCenterButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="380" Padding="20" Margin="8" Style="{DynamicResource Layout.GlassPanel}" Background="{DynamicResource Brush.Surface.Overlay}">
              <StackPanel>
                <DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource Button.Ghost}" Click="ToggleTaskCenter_Click"/><TextBlock Text="通知" Style="{StaticResource Layout.SectionTitle}"/></DockPanel>
                <TextBlock Text="后台任务与索引状态" Style="{DynamicResource Status.Description}" Margin="0,6,0,14"/>
                <Border Style="{DynamicResource Layout.Section}"><StackPanel><TextBlock Text="{Binding ProgressLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,6,0,8"/><ProgressBar Height="6" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/><Button Content="停止当前任务" Command="{Binding CancelCurrentTaskCommand}" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Margin="0,12,0,0" Style="{DynamicResource Layout.Section}"><StackPanel><TextBlock Text="人物索引" FontWeight="SemiBold"/><TextBlock Text="{Binding PeopleAlbums.StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,6,0,8"/><ProgressBar Height="6" Maximum="100" Value="{Binding PeopleAlbums.ScanProgressValue, Mode=OneWay}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}"/><Button Content="停止扫描" Command="{Binding PeopleAlbums.CancelScanCommand}" Style="{StaticResource Button.Ghost}"/></StackPanel></Border>
              </StackPanel>
            </Border>
          </Popup>
          <Grid Margin="24,8,24,8">
            <Border Name="HomePage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource PageSurface}" Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource Layout.PagePanel}" Padding="0">
              <!-- 主页（单屏仪表盘，不滚动）：头部 / Hero+统计 / 中断导入 / 拍摄频率+最近文件夹 | 快速操作+设备 -->
              <Grid x:Name="HomeDashboard" Margin="0,0,0,4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择库根目录" Command="{Binding BrowseLibraryCommand}" />
                    <Button Content="刷新" Command="{Binding RefreshLibraryCommand}" />
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Your photo story" Style="{DynamicResource Layout.Eyebrow}" />
                    <TextBlock Style="{StaticResource Layout.PageTitle}" Text="{Binding PageTitle}" />
                  </StackPanel>
                </DockPanel>
                <!-- 上下两行右栏宽度一致（0.42*，340–460），窗口变宽时左右按比例一起伸展 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.42*" MinWidth="340" MaxWidth="460" /></Grid.ColumnDefinitions>
                  <!-- 主页 Hero（樱粉镜面）：看板娘 + 主操作；Ctrl K 直达图库搜索 -->
                  <Grid x:Name="HomeHeroCard" controls:Motion.RevealOrder="0">
                    <Border CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Glass.Surface}" />
                    <Border CornerRadius="{StaticResource Radius.Dialog}" BorderBrush="{DynamicResource Brush.Glass.Stroke}" BorderThickness="1" Padding="26,0,16,0" ClipToBounds="True">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,18">
                          <TextBlock Text="Keep Your Memories" Style="{DynamicResource Layout.Eyebrow}" Margin="0,0,0,4" />
                          <!-- 按时间问候 + 最近拍摄 / 下一个日程（原 Hanabe 角色小板块的内容并入这里，不再重复放一张看板娘） -->
                          <TextBlock FontSize="{StaticResource Typography.Display}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"><Run Text="{Binding HanabeGreeting, Mode=OneWay}" /><Run Text="，记录生活的每一帧" FontSize="{StaticResource Typography.TitleSmall}" Foreground="{DynamicResource Brush.Text.Secondary}" /></TextBlock>
                          <TextBlock Margin="0,6,0,0" Text="{Binding HanabeDailyMessage}" TextWrapping="Wrap" LineHeight="20" MaxHeight="42" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Primary}" Opacity="0.86" FontSize="{StaticResource Typography.BodySmall}" />
                          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}" TextTrimming="CharacterEllipsis"><Run Text="{Binding LibraryHealthText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LibraryRoot, Mode=OneWay}" /></TextBlock>
                          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="导入照片" Style="{StaticResource Button.Primary}" Command="{Binding ShowImportCommand}" Padding="18,8" Margin="0,0,10,0" />
                            <Button Content="打开图库" Style="{StaticResource Button.Subtle}" Command="{Binding ShowPreviewCommand}" Padding="16,8" Margin="0,0,10,0" />
                            <Button Content="搜索照片  Ctrl K" Style="{StaticResource Button.Ghost}" Click="HomeSearch_Click" Padding="14,8" Margin="0,0,14,0" ToolTip="跳到图库并聚焦搜索框，可用文字描述找照片" />
                            <CheckBox Content="桌面助手" Style="{StaticResource Input.Switch}" VerticalAlignment="Center" IsChecked="{Binding ShowHanabeAssistant, Mode=TwoWay}" FontSize="{StaticResource Typography.Caption}" AutomationProperties.Name="显示桌面助手" ToolTip="在桌面上显示 Hanabe 小助手；形象可在设置里更换" />
                          </StackPanel>
                        </StackPanel>
                        <Image Grid.Column="1" Source="Assets/Hanabe/workspace-hero.png" Height="176" Stretch="Uniform" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Hanabe 看板娘" />
                      </Grid>
                    </Border>
                  </Grid>
                  <!-- 概览统计卡：媒体文件 / 拍摄日期 / 自定义相册 / 人物 -->
                  <UniformGrid x:Name="HomeStatCards" Grid.Column="2" Rows="2" Columns="2" Margin="0,0,-12,-12" controls:Motion.RevealOrder="1">
                    <UniformGrid.Resources>
                      <Style x:Key="HomeStatCard" TargetType="Border">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="16,10" />
                        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Stroke}" />
                        <Setter Property="BorderThickness" Value="1" />
                      </Style>
                      <Style x:Key="HomeStatValue" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="{StaticResource Typography.Display}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                      </Style>
                      <Style x:Key="HomeStatLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="{StaticResource Typography.Caption}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                      </Style>
                    </UniformGrid.Resources>
                    <Border Style="{StaticResource HomeStatCard}"><StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource HomeStatValue}" Text="{Binding PreviewFiles.Count, StringFormat={}{0:N0}}" /><TextBlock Style="{StaticResource HomeStatLabel}" Text="照片与视频" /></StackPanel></Border>
                    <Border Style="{StaticResource HomeStatCard}"><StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource HomeStatValue}" Text="{Binding DiscoveredDateCount, StringFormat={}{0:N0}}" /><TextBlock Style="{StaticResource HomeStatLabel}" Text="拍摄日期" /></StackPanel></Border>
                    <Border Style="{StaticResource HomeStatCard}"><StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource HomeStatValue}" Text="{Binding CustomAlbums.Albums.Count, StringFormat={}{0:N0}}" /><TextBlock Style="{StaticResource HomeStatLabel}" Text="自定义相册" /></StackPanel></Border>
                    <Border Style="{StaticResource HomeStatCard}"><StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource HomeStatValue}" Text="{Binding PeopleAlbums.Albums.Count, StringFormat={}{0:N0}}" /><TextBlock Style="{StaticResource HomeStatLabel}" Text="已识别人物" /></StackPanel></Border>
                  </UniformGrid>
                </Grid>
                <!-- 中断的导入：卡片代替启动弹窗之外的入口；放弃需二次确认，已导入文件保留 -->
                <Border x:Name="HomeResumeImportCard" Grid.Row="2" Margin="0,0,0,12" Padding="16,10" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Default}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1" Visibility="{Binding HasPendingImportResume, Converter={StaticResource BoolToVis}}">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="继续导入" Style="{StaticResource Button.Primary}" Click="HomeResumeContinue_Click" Padding="16,6" Margin="0,0,8,0" />
                      <Button Content="放弃恢复记录" Style="{StaticResource Button.Subtle}" Click="HomeResumeDiscard_Click" Padding="14,6" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="有一次导入没有完成" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding PendingImportResumeSummary, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" /></TextBlock>
                  </DockPanel>
                </Border>
                <Grid Grid.Row="3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.42*" MinWidth="340" MaxWidth="460" /></Grid.ColumnDefinitions>
                  <!-- 主页独立小板块（2×2，随窗口高度铺满）：拍摄频率 / 最近文件夹 / 日程安排 / 交付进度 -->
                  <UniformGrid x:Name="HomeTiles" Rows="2" Columns="2" VerticalAlignment="Stretch" Margin="0,0,-12,-12">
                    <UniformGrid.Resources>
                      <Style x:Key="HomeTile" TargetType="Border">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="MinHeight" Value="196" />
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Stroke}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="ClipToBounds" Value="True" />
                      </Style>
                      <Style x:Key="HomeTileTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="{StaticResource Typography.TitleSmall}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                      </Style>
                      <Style x:Key="HomeTileCaption" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="{StaticResource Typography.Caption}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                      </Style>
                    </UniformGrid.Resources>
                    <!-- 拍摄频率：悬停放大显示日期与数量；右上角可调条形间距 -->
                    <Border x:Name="HomeShootingFrequencyCard" Style="{StaticResource HomeTile}" controls:Motion.RevealOrder="2">
                      <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" ToolTip="拖动调整条形之间的间距，自动保存">
                            <TextBlock Text="间距" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource HomeTileCaption}" />
                            <Slider x:Name="ShootingBarGapSlider" Width="70" VerticalAlignment="Center" Minimum="0" Maximum="16" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding ShootingBarGap, Mode=TwoWay}" AutomationProperties.Name="拍摄频率条形间距" />
                          </StackPanel>
                          <StackPanel>
                            <TextBlock Text="拍摄频率" Style="{StaticResource HomeTileTitle}" />
                            <TextBlock Text="{Binding ShootingFrequencySummary}" Style="{StaticResource HomeTileCaption}" Margin="0,2,0,0" />
                          </StackPanel>
                        </DockPanel>
                        <ItemsControl x:Name="ShootingFrequencyBarsHost" SizeChanged="ShootingBars_SizeChanged" ItemsSource="{Binding ShootingFrequencyBars}" MouseMove="ShootingBars_MouseMove" MouseLeave="ShootingBars_MouseLeave" Background="Transparent" AutomationProperties.Name="每日拍摄数量条形图">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ShootingDayBar}">
                              <Grid x:Name="BarCell" Margin="{Binding DataContext.ShootingBarMargin, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Background="Transparent" Panel.ZIndex="0">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Bottom">
                                  <Border x:Name="CountBubble" HorizontalAlignment="Center" Margin="-30,0,-30,4" Padding="6,1" CornerRadius="{StaticResource Radius.Full}" Background="{DynamicResource Brush.Surface.Elevated}" BorderBrush="{DynamicResource Brush.Glass.Stroke}" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding ToolTipText}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                  </Border>
                                  <Border x:Name="Bar" Height="{Binding BarHeight}" MaxWidth="40" CornerRadius="5,5,2,2" Background="{DynamicResource Brush.Primary}" Opacity="0.42" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform><ScaleTransform x:Name="BarScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                                  </Border>
                                </StackPanel>
                                <TextBlock x:Name="DayText" Grid.Row="1" Text="{Binding DayLabel}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Opacity="0" />
                              </Grid>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowMonth}" Value="True">
                                  <Setter TargetName="DayText" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                  <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Primary.Fill}" />
                                  <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                  <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                                  <Setter TargetName="DayText" Property="FontWeight" Value="SemiBold" />
                                  <Setter TargetName="DayText" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <Trigger SourceName="BarCell" Property="IsMouseOver" Value="True">
                                  <Setter TargetName="BarCell" Property="Panel.ZIndex" Value="10" />
                                  <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Primary.Fill}" />
                                  <Setter TargetName="DayText" Property="Opacity" Value="1" />
                                  <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                                  <Trigger.EnterActions>
                                    <BeginStoryboard>
                                      <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CountBubble" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </Trigger.EnterActions>
                                  <Trigger.ExitActions>
                                    <BeginStoryboard>
                                      <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="CountBubble" Storyboard.TargetProperty="Opacity" Duration="0:0:0.12" />
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </Trigger.ExitActions>
                                </Trigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>
                    </Border>
                    <!-- 最近文件夹：2×2 封面，点击直接打开该日期 -->
                    <Border Style="{StaticResource HomeTile}" controls:Motion.RevealOrder="3">
                      <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource HomeTileCaption}" Text="{Binding HomeRecentFolders.Count, StringFormat={}{0} 个日期}" />
                          <TextBlock Text="最近文件夹" Style="{StaticResource HomeTileTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding HomeRecentFolders}" ClipToBounds="True">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="2" Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HomeRecentFolderViewModel}">
                              <Button Margin="0,0,6,6" Padding="0" Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Command="{Binding DataContext.OpenHomeRecentFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <Button.ToolTip><TextBlock><Run Text="{Binding FolderName, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak /><Run Text="{Binding Subtitle, Mode=OneWay}" /></TextBlock></Button.ToolTip>
                                <Border CornerRadius="{StaticResource Radius.Control}" ClipToBounds="True" Background="{DynamicResource Brush.Surface.Container}">
                                  <Grid>
                                    <Grid>
                                      <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                      <Rectangle Margin="0,0,1,0"><Rectangle.Fill><ImageBrush ImageSource="{Binding Cover1.Thumbnail}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                                      <Grid Grid.Column="1">
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <Rectangle Margin="1,0,0,1"><Rectangle.Fill><ImageBrush ImageSource="{Binding Cover2.Thumbnail}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                                        <Rectangle Grid.Row="1" Margin="1,1,0,0"><Rectangle.Fill><ImageBrush ImageSource="{Binding Cover3.Thumbnail}" Stretch="UniformToFill" /></Rectangle.Fill></Rectangle>
                                      </Grid>
                                    </Grid>
                                    <Border VerticalAlignment="Bottom" Padding="8,10,8,5" CornerRadius="0,0,8,8">
                                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="{DynamicResource Color.Shell.GlowClear}" /><GradientStop Offset="1" Color="{DynamicResource Color.Overlay.Scrim}" /></LinearGradientBrush></Border.Background>
                                      <TextBlock Text="{Binding DateText}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Viewer.Text}" />
                                    </Border>
                                  </Grid>
                                </Border>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>
                    </Border>
                    <!-- 日程安排：输入“11.2 漫展外拍”“明天 棚拍”回车添加，点圆圈完成 -->
                    <Border x:Name="HomeScheduleCard" Style="{StaticResource HomeTile}" controls:Motion.RevealOrder="4">
                      <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource HomeTileCaption}" Text="{Binding ScheduleSummary}" />
                          <TextBlock Text="日程安排" Style="{StaticResource HomeTileTitle}" />
                        </DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                          <TextBox x:Name="HomeScheduleInput" Style="{DynamicResource Input.TextBox}" Height="32" VerticalContentAlignment="Center" Text="{Binding NewScheduleText, UpdateSourceTrigger=PropertyChanged}" KeyDown="HomeScheduleInput_KeyDown" AutomationProperties.Name="添加日程" ToolTip="例如：11.2 漫展外拍 / 明天 棚拍，回车添加" />
                          <TextBlock Text="添加：11.2 漫展外拍 / 明天 棚拍" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.7">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource HomeTileCaption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Text, ElementName=HomeScheduleInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                        <Grid>
                          <TextBlock Text="还没有日程，在下面写一条拍摄计划吧" Style="{StaticResource HomeTileCaption}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoSchedule, Converter={StaticResource BoolToVis}}" />
                          <ItemsControl ItemsSource="{Binding UpcomingSchedule}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:ScheduleItemViewModel}">
                                <Grid x:Name="ScheduleRow" Margin="0,0,0,4" Background="Transparent">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                  <Button Style="{StaticResource Button.Ghost}" Padding="2" Width="24" Height="24" Command="{Binding DataContext.ToggleScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="标记完成 / 取消完成">
                                    <Grid Width="14" Height="14">
                                      <Ellipse Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.6" />
                                      <Ellipse x:Name="DoneDot" Margin="3" Fill="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
                                    </Grid>
                                  </Button>
                                  <TextBlock x:Name="ScheduleDate" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding DateText}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                  <TextBlock x:Name="ScheduleTitle" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Primary}" />
                                  <Button x:Name="ScheduleRemove" Grid.Column="3" Content="×" Style="{StaticResource Button.Ghost}" Padding="6,0" Opacity="0" Command="{Binding DataContext.RemoveScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="删除" />
                                </Grid>
                                <DataTemplate.Triggers>
                                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="DoneDot" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ScheduleTitle" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                    <Setter TargetName="ScheduleTitle" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="ScheduleDate" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter TargetName="ScheduleDate" Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                                  </DataTrigger>
                                  <Trigger SourceName="ScheduleRow" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ScheduleRemove" Property="Opacity" Value="1" />
                                  </Trigger>
                                </DataTemplate.Triggers>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </DockPanel>
                    </Border>
                    <!-- 交付进度：最近几个拍摄日有没有出“修后”成片；点一行直接在图库打开该日期 -->
                    <Border x:Name="HomeDeliveryCard" Style="{StaticResource HomeTile}" controls:Motion.RevealOrder="5">
                      <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource HomeTileCaption}" Text="{Binding HomeDeliverySummary}" />
                          <TextBlock Text="交付进度" Style="{StaticResource HomeTileTitle}" />
                        </DockPanel>
                        <Grid>
                          <TextBlock Text="导入照片后，这里会显示每个拍摄日的修图进度" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource HomeTileCaption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasHomeDelivery}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <ItemsControl ItemsSource="{Binding HomeDeliveryItems}" ClipToBounds="True">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:HomeDeliveryItemViewModel}">
                                <Button Style="{StaticResource Button.Ghost}" Padding="8,5" Margin="0,0,0,3" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenHomeDeliveryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding DateText}">
                                  <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding DateText}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Remark}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}" />
                                    <Border x:Name="StatusChip" Grid.Column="3" Margin="8,0,0,0" Padding="8,2" CornerRadius="{StaticResource Radius.Full}" Background="{DynamicResource Brush.Surface.ContainerHigh}">
                                      <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </Border>
                                  </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                  <DataTrigger Binding="{Binding IsDelivered}" Value="True">
                                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                    <Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.OnPrimaryContainer}" />
                                  </DataTrigger>
                                </DataTemplate.Triggers>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </DockPanel>
                    </Border>
                  </UniformGrid>
                  <!-- 右栏：快速操作 / 存储空间 / 当前连接设备（设备列表吃掉剩余高度） -->
                  <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <!-- 存储空间：照片库所在磁盘（含网络共享）剩余容量；不足 10% 或 50 GB 时变成提醒色 -->
                    <Border x:Name="HomeStorageCard" Grid.Row="1" Style="{StaticResource Layout.HomeSection}" Margin="0,0,0,12" Padding="16,12" controls:Motion.RevealOrder="4">
                      <StackPanel>
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource Button.Ghost}" Padding="8,2" Click="HomeStorageRefresh_Click" ToolTip="重新读取磁盘容量" />
                          <TextBlock Text="存储空间" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding LibraryStorageText}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding LibraryStorageFraction, Mode=OneWay}" AutomationProperties.Name="照片库磁盘已用比例" />

                        <TextBlock Text="{Binding LibraryStorageDetail}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Typography.Caption}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLibraryStorageLow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Layout.HomeSection}" Margin="0,0,0,12" Padding="16,12,16,6" controls:Motion.RevealOrder="3">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="快速操作" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding QuickActions}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickActionItemViewModel}">
                          <Button Style="{StaticResource Button.Toolbar}" Margin="0,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding Command}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                            <StackPanel Orientation="Horizontal">
                              <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                <Path x:Name="QuickActionIcon" Stroke="{DynamicResource Brush.Accent.Default}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                              </Viewbox>
                              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="Import"><Setter TargetName="QuickActionIcon" Property="Data" Value="{StaticResource Icon.Import}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Preview"><Setter TargetName="QuickActionIcon" Property="Data" Value="{StaticResource Icon.Library}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="CustomAlbums"><Setter TargetName="QuickActionIcon" Property="Data" Value="{StaticResource Icon.Album}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Key}" Value="DateFolders"><Setter TargetName="QuickActionIcon" Property="Data" Value="{StaticResource Icon.Calendar}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="FaceSearch"><Setter TargetName="QuickActionIcon" Property="Data" Value="{StaticResource Icon.FaceSearch}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="MapPhotos"><Setter TargetName="QuickActionIcon" Property="Data" Value="{StaticResource Icon.Map}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Compression"><Setter TargetName="QuickActionIcon" Property="Data" Value="{StaticResource Icon.Compress}" /></DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Layout.HomeSection}" Margin="0" Padding="16,12" VerticalAlignment="Stretch" controls:Motion.RevealOrder="5">
                      <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                          <Button DockPanel.Dock="Right" Content="重新检测" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource Button.Ghost}" Padding="10,4" />
                          <StackPanel>
                            <TextBlock Text="当前连接设备" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" />
                            <TextBlock Text="U 盘、存储卡、相机与网络设备" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                          </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"><Run Text="{Binding SelectedDeviceTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" /><Run Text="  " /><Run Text="{Binding SelectedDeviceSummary, Mode=OneWay}" /></TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding DeviceGroups}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceGroupViewModel}">
                              <Expander IsExpanded="True" Margin="0,0,12,10" Foreground="{DynamicResource Brush.Text.Primary}" Background="Transparent">
                                <HeaderedContentControl.Header>
                                  <DockPanel>
                                    <TextBlock FontSize="{StaticResource Typography.TitleSmall}" Margin="0,0,8,0" Text="{Binding Icon}" />
                                    <StackPanel>
                                      <TextBlock FontWeight="SemiBold" FontSize="{StaticResource Typography.TitleSmall}" Text="{Binding Name}" />
                                      <TextBlock Opacity="0.78" FontSize="{StaticResource Typography.BodySmall}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                  </DockPanel>
                                </HeaderedContentControl.Header>
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Devices}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ConnectedDeviceViewModel}">
                                      <Button Style="{StaticResource DeviceCardButton}" Margin="0,0,0,8" Command="{Binding DataContext.InspectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <Border Padding="14" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                          <Grid>
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="46" />
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Subtle}">
                                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource Typography.TitleSmall}" Text="{Binding Icon}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                              <DockPanel>
                                                <TextBlock FontWeight="SemiBold" FontSize="{StaticResource Typography.Label}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="7,2" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                                  <TextBlock FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Text="{Binding BadgeText}" />
                                                </Border>
                                              </DockPanel>
                                              <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" Opacity="0.95" Margin="0,2,0,0" Text="{Binding Brand}" />
                                              <TextBlock TextWrapping="Wrap" Opacity="0.78" FontSize="{StaticResource Typography.BodySmall}" Margin="0,3,0,0" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="选择" Margin="10,0,0,0" Padding="12,7" VerticalAlignment="Center" Background="{DynamicResource Brush.Surface.Subtle}" Command="{Binding DataContext.ImportFromDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                          </Grid>
                                        </Border>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Expander>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </DockPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Grid>
              </Border>
            </Border>
            <!--
              导入页（重设计）：三步，每一刻只显示当前这一步需要的东西。
              1 选择来源：设备卡片 + 拖入/选择文件夹，选好即分析（只读）
              2 检查确认：素材队列 + 每个日期的目标文件夹在同一屏，底栏一个“开始导入”
              3 导入与完成：进度卡片 → 结果卡片（打开图库 / 整理场次 / 继续导入）
              导入设置（转移方式、命名、查重、人物识别）收进右上角弹出面板；分类与场次在检查页按需打开。
            -->
            <Grid Background="Transparent" Name="ImportPage" Style="{StaticResource PageSurface}" Visibility="{Binding IsImportPage, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource Layout.PagePanel}" Background="Transparent" Padding="16">
                <DockPanel LastChildFill="True">
                  <!-- 标题 + 导入设置 -->
                  <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Bring memories home" Style="{DynamicResource Layout.Eyebrow}" Margin="0,0,0,4"/>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Layout.PageTitle}" Text="{Binding PageTitle}" VerticalAlignment="Center" />
                      <!-- 三步步骤条：与按钮 / 侧栏同一套语言——一个分段容器，圆角 Radius.Control；当前步用侧栏选中同款的粉色渐变。只有“回到选择来源”可以点 -->
                      <Border Margin="20,0,0,0" VerticalAlignment="Center" Padding="3" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Default}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                        <ItemsControl x:Name="ImportWizardStepper" ItemsSource="{Binding ImportWizardSteps}" AutomationProperties.Name="导入步骤" Focusable="False">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal">
                                <Path x:Name="StepChevron" Data="M0,0 L4,4 L0,8" Width="5" Height="9" Stretch="Uniform" Margin="6,0" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Border x:Name="StepChrome" Height="32" Padding="8,0,14,0" CornerRadius="{StaticResource Radius.Small}" Background="Transparent" MouseLeftButtonUp="ImportWizardStep_MouseLeftButtonUp" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Hint}">
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="StepDot" Width="20" Height="20" CornerRadius="10" Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1.5">
                                      <TextBlock x:Name="StepMarker" Text="{Binding Marker}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </Border>
                                    <TextBlock x:Name="StepTitle" Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Number}" Value="1">
                                  <Setter TargetName="StepChevron" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="active">
                                  <Setter TargetName="StepChrome" Property="Background" Value="{DynamicResource Brush.Primary.Fill}" />
                                  <Setter TargetName="StepDot" Property="BorderBrush" Value="{DynamicResource Brush.OnPrimary}" />
                                  <Setter TargetName="StepMarker" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                                  <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="done">
                                  <Setter TargetName="StepDot" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                  <Setter TargetName="StepDot" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                  <Setter TargetName="StepMarker" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                                  <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsClickable}" Value="True">
                                  <Setter TargetName="StepChrome" Property="Cursor" Value="Hand" />
                                  <Setter TargetName="StepChrome" Property="ToolTip" Value="回到选择来源（清空本次队列，不删除任何文件）" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsClickable}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=StepChrome}" Value="True" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter TargetName="StepChrome" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" />
                                </MultiDataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                      <Button x:Name="ImportSettingsButton" Style="{StaticResource Button.Secondary}" Padding="14,7" Click="ImportSettingsButton_Click" AutomationProperties.Name="导入设置" ToolTip="转移方式、命名、查重与人物识别">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource Icon.Settings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,8,0" />
                          <TextBlock Text="导入设置" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Popup PlacementTarget="{Binding ElementName=ImportSettingsButton}" Placement="Bottom" HorizontalOffset="-290" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsImportSettingsOpen, Mode=TwoWay}">
                        <Border Width="420" Margin="4,0,14,14" Padding="18,16" CornerRadius="14" Background="{DynamicResource Brush.Surface.Overlay}" BorderBrush="{DynamicResource Brush.Glass.Stroke}" BorderThickness="1" Effect="{DynamicResource Shadow.Dialog}">
                          <StackPanel>
                            <TextBlock Text="导入设置" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid Margin="0,4">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                              <StackPanel VerticalAlignment="Center"><TextBlock Text="转移方式" FontWeight="SemiBold" /><TextBlock Text="复制，或校验后移动" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                              <ComboBox Grid.Column="1" SelectedValuePath="Mode" DisplayMemberPath="Display" ItemsSource="{Binding TransferModes}" SelectedValue="{Binding SelectedTransferMode}" IsEnabled="{Binding CanEditImportOrganization}" />
                            </Grid>
                            <Grid Margin="0,8">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                              <StackPanel VerticalAlignment="Center"><TextBlock Text="命名方式" FontWeight="SemiBold" /><TextBlock Text="导入后的文件名" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                              <ComboBox Grid.Column="1" ItemsSource="{Binding ImportNamingPresets}" SelectedItem="{Binding SelectedImportNamingPreset}" AutomationProperties.Name="导入文件命名方式" IsEnabled="{Binding CanEditImportOrganization}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,8" />
                            <DockPanel Margin="0,4">
                              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Input.Switch}" VerticalAlignment="Center" IsChecked="{Binding CheckDuplicatesOnImport, Mode=TwoWay}" IsEnabled="{Binding CanEditImportOrganization}" AutomationProperties.Name="导入精确查重开关" />
                              <StackPanel Margin="0,0,12,0"><TextBlock Text="精确查重" FontWeight="SemiBold" /><TextBlock Text="和同一天的已有文件夹、本批来源比对（SHA-256），检查页会提前显示结果" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            </DockPanel>
                            <StackPanel Margin="0,6,0,4">
                              <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding CheckDuplicatesOnImport}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                              <TextBlock Text="重复的文件" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                              <WrapPanel>
                                <RadioButton Content="跳过（推荐）" GroupName="ImportDuplicateHandling" IsChecked="{Binding SkipImportDuplicates, Mode=TwoWay}" Margin="0,0,14,0" />
                                <RadioButton Content="仍然导入" GroupName="ImportDuplicateHandling" IsChecked="{Binding KeepImportDuplicates, Mode=TwoWay}" Margin="0,0,14,0" />
                                <RadioButton Content="逐个询问" GroupName="ImportDuplicateHandling" IsChecked="{Binding ReviewImportDuplicates, Mode=TwoWay}" />
                              </WrapPanel>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,8" />
                            <DockPanel Margin="0,4">
                              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Input.Switch}" VerticalAlignment="Center" IsChecked="{Binding AutoSplitImportDays, Mode=TwoWay}" IsEnabled="{Binding CanEditImportOrganization}" AutomationProperties.Name="同一天有间隔时自动分文件夹" />
                              <StackPanel Margin="0,0,12,0"><TextBlock Text="同一天分段放文件夹" FontWeight="SemiBold" /><TextBlock Text="同一天里隔了很久（比如上午一场、晚上一场）就分成几个日期文件夹；检查页可改回一个" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            </DockPanel>
                            <Grid Margin="0,4,0,4" IsEnabled="{Binding AutoSplitImportDays}">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                              <TextBlock Text="相隔多久算另一段" VerticalAlignment="Center" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding ImportDaySplitHourOptions}" SelectedItem="{Binding ImportDaySplitHours}" AutomationProperties.Name="分段间隔小时数">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Mode=OneWay}" /><Run Text=" 小时" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,8" />
                            <DockPanel Margin="0,4">
                              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Input.Switch}" VerticalAlignment="Center" IsChecked="{Binding EnablePersonRecognition}" IsEnabled="{Binding CanEditImportOrganization}" AutomationProperties.Name="导入时识别人物" />
                              <StackPanel Margin="0,0,12,0"><TextBlock Text="导入时识别人物" FontWeight="SemiBold" /><TextBlock Text="在本机识别 JPG，同名 RAW 继承结果，视频跳过" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" Opacity="0.75">
                              <TextBlock DockPanel.Dock="Right" Text="始终开启" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" />
                              <StackPanel Margin="0,0,12,0"><TextBlock Text="修后目录只读保护" FontWeight="SemiBold" /><TextBlock Text="「修后」文件夹永不写入、不会被覆盖" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            </DockPanel>
                          </StackPanel>
                        </Border>
                      </Popup>
                    </StackPanel>
                  </Grid>


                  <!-- 当前提示（一句话）：只在有内容时出现 -->
                  <TextBlock DockPanel.Dock="Top" Margin="2,0,0,14" Text="{Binding ImportActionHint}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.BodySmall}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ImportActionHint}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                          <DataTrigger Binding="{Binding IsImportRunningStage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <Grid>
                    <!-- ===== 1 选择来源 ===== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsImportSourceStage, Converter={StaticResource BoolToVis}}" controls:Motion.RevealOrder="1">
                      <StackPanel HorizontalAlignment="Stretch">
                        <!-- 上次没导完 -->
                        <Border Margin="0,0,0,16" Padding="18,14" CornerRadius="14" Background="{DynamicResource Brush.PrimaryContainer}" Visibility="{Binding HasPendingImportResume, Converter={StaticResource BoolToVis}}">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Content="放弃恢复记录" Style="{StaticResource Button.Ghost}" Padding="12,6" Command="{Binding DiscardImportCommand}" ToolTip="仅移除恢复记录，不删除已导入文件或源文件。" />
                              <Button Content="继续导入" Style="{StaticResource Button.Primary}" Padding="16,7" Margin="8,0,0,0" Command="{Binding ContinueImportCommand}" AutomationProperties.Name="继续未完成导入" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                              <TextBlock Text="上次导入还没完成" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnPrimaryContainer}" />
                              <TextBlock Text="{Binding PendingImportResumeSummary}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource Brush.OnPrimaryContainer}" FontSize="{StaticResource Typography.BodySmall}" />
                            </StackPanel>
                          </DockPanel>
                        </Border>

                        <!-- 正在分析（只读） -->
                        <Border Margin="0,0,0,16" Padding="18,14" CornerRadius="14" Background="{DynamicResource Brush.Surface.ContainerHigh}" Visibility="{Binding IsImportAnalyzing, Converter={StaticResource BoolToVis}}">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="停止" Style="{StaticResource Button.Ghost}" Padding="12,6" VerticalAlignment="Center" Command="{Binding CancelCurrentTaskCommand}" />
                            <StackPanel Margin="0,0,16,0">
                              <TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                              <TextBlock Text="正在读取拍摄时间并分类，只读，不会复制任何文件。" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                            </StackPanel>
                          </DockPanel>
                        </Border>

                        <!-- 设备 -->
                        <DockPanel Margin="2,0,2,10">
                          <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource Button.Ghost}" Padding="10,4" Command="{Binding RefreshImportDevicesCommand}" ToolTip="重新检测存储卡、U 盘和相机" />
                          <TextBlock Text="存储卡与设备" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Margin="2,0,0,14" Text="没有检测到存储卡。插卡后点「刷新」，或者直接在下面选择文件夹。" Foreground="{DynamicResource Brush.Text.Secondary}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers><DataTrigger Binding="{Binding ImportDeviceChoices.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding ImportDeviceChoices}" Margin="0,0,-12,6" IsEnabled="{Binding CanEditImportOrganization}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="280" Margin="0,0,12,12" Padding="16,14" CornerRadius="14" Style="{DynamicResource Layout.GlassPanel}" controls:Motion.HoverLift="True">
                                <DockPanel>
                                  <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" Content="导入这个设备" Style="{StaticResource Button.Primary}" Padding="12,7" Command="{Binding DataContext.ImportFromDevicePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Path}" AutomationProperties.Name="{Binding Name}" />
                                  <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Brush.PrimaryContainer}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource Icon.Import}" Stroke="{DynamicResource Brush.OnPrimaryContainer}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                  </Border>
                                  <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 文件夹：拖入或选择 -->
                        <Border AllowDrop="True" DragOver="SourceAutoImportDropTarget_DragOver" Drop="SourceAutoImportDropTarget_Drop" Padding="24,26" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Border.Strong}" Background="{DynamicResource Brush.Surface.ContainerLow}" Margin="0,0,0,14" IsEnabled="{Binding CanEditImportOrganization}">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Content="选文件夹" Style="{StaticResource Button.Secondary}" Padding="14,7" Command="{Binding BrowseSourceCommand}" ToolTip="选择一个来源文件夹，选好后自动分析" />
                              <Button Content="多选文件夹" Style="{StaticResource Button.Secondary}" Padding="14,7" Margin="8,0,0,0" Command="{Binding BrowseSourceFoldersCommand}" />
                            </StackPanel>
                            <Viewbox DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,16,0" VerticalAlignment="Center">
                              <Path Data="{StaticResource Icon.Import}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="把相机文件夹拖到这里" FontWeight="SemiBold" FontSize="{StaticResource Typography.Label}" />
                              <TextBlock Text="可以一次拖多个 · 选好就自动按日期和类型分析，不会复制任何文件 · HEIF 保留原件并生成 JPG" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                            </StackPanel>
                          </DockPanel>
                        </Border>

                        <!-- 修后 / 素材：直接拖到对应格子归类 -->
                        <Grid Margin="0,0,0,16" IsEnabled="{Binding CanEditImportOrganization}">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                          <Border Grid.Column="0" AllowDrop="True" Drop="EditedDropTarget_Drop" Padding="16,12" CornerRadius="12" Background="{DynamicResource Brush.Surface.ContainerHigh}">
                            <StackPanel><TextBlock Text="修后成片拖到这里" FontWeight="SemiBold" /><TextBlock Text="直接归入当天的「修后」，不做分类判断" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                          </Border>
                          <Border Grid.Column="2" AllowDrop="True" Drop="MaterialDropTarget_Drop" Padding="16,12" CornerRadius="12" Background="{DynamicResource Brush.Surface.ContainerHigh}">
                            <StackPanel><TextBlock Text="项目素材拖到这里" FontWeight="SemiBold" /><TextBlock Text="直接归入「素材」" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                          </Border>
                        </Grid>

                        <Border x:Name="ImportTipCard" Height="72" Padding="14" CornerRadius="{StaticResource Radius.Dialog}" Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                          <TextBlock x:Name="ImportTipText" Text="💡 遇到不认识的 RAW / 视频格式？到 设置 → 照片库与导入 → 自定义导入格式 里添加后缀（如 R3D、BRAW），保存后会自动记住。" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}">
                            <TextBlock.RenderTransform>
                              <TranslateTransform x:Name="ImportTipTextTransform" />
                            </TextBlock.RenderTransform>
                          </TextBlock>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>

                    <!-- ===== 2 检查确认（图形化）=====
                         默认只看“按日期汇总”的卡片：缩略图条、分类比例条、目标文件夹；
                         需要逐张核对 / 改分类 / 建场次时，再点“查看全部素材”展开完整网格。 -->
                    <Grid Visibility="{Binding IsImportReviewStage, Converter={StaticResource BoolToVis}}" controls:Motion.RevealOrder="1">
                      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                          <!-- 一眼看完：组数 / 大小 / 日期 / 重复 -->
                          <WrapPanel Margin="0,0,0,14">
                            <Border Margin="0,0,10,10" Padding="18,12" MinWidth="150" CornerRadius="14" Style="{DynamicResource Layout.GlassPanel}">
                              <StackPanel><TextBlock Text="{Binding ImportSelectedCount, StringFormat={}{0:N0}}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" /><TextBlock Text="组待导入" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            </Border>
                            <Border Margin="0,0,10,10" Padding="18,12" MinWidth="150" CornerRadius="14" Style="{DynamicResource Layout.GlassPanel}">
                              <StackPanel><TextBlock Text="{Binding ImportReviewTotalSize}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" /><TextBlock Text="总大小" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            </Border>
                            <Border Margin="0,0,10,10" Padding="18,12" MinWidth="150" CornerRadius="14" Style="{DynamicResource Layout.GlassPanel}">
                              <StackPanel><TextBlock Text="{Binding ImportShootDayCount}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" /><TextBlock Text="个拍摄日" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            </Border>
                            <Border Margin="0,0,10,10" Padding="18,12" MinWidth="150" CornerRadius="14" Style="{DynamicResource Layout.GlassPanel}" ToolTip="{Binding ImportDuplicatePreviewText}">
                              <StackPanel><TextBlock Text="{Binding ImportDuplicateCountText}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" /><TextBlock Text="个重复（SHA-256）" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /></StackPanel>
                            </Border>
                          </WrapPanel>

                          <!-- 有读不到日期 / 分类的：一句话 + 去处理 -->
                          <Border Margin="0,0,0,14" Padding="16,12" CornerRadius="14" Background="{DynamicResource Brush.PrimaryContainer}" Visibility="{Binding HasImportUnresolved, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="去处理" Style="{StaticResource Button.Primary}" Padding="14,6" Click="ShowUnresolvedImportItems_Click" />
                              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnPrimaryContainer}" TextWrapping="Wrap"><Run Text="{Binding ImportUnresolvedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 组读不到拍摄日期或无法判断分类：改一下分类，或取消勾选后就能开始导入。" /></TextBlock>
                            </DockPanel>
                          </Border>

                          <!-- 日期卡片 -->
                          <ItemsControl ItemsSource="{Binding ImportDateCards}" Margin="0,0,-14,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vms:ImportDateGraphGroupViewModel}">
                                <Border Width="384" Margin="0,0,14,14" Padding="18,16" CornerRadius="16" Style="{DynamicResource Layout.GlassPanel}">
                                  <StackPanel>
                                    <!-- 日期 + 数量 + 重复 -->
                                    <DockPanel>
                                      <Border DockPanel.Dock="Right" Padding="9,3" CornerRadius="{StaticResource Radius.Full}" Background="{DynamicResource Brush.Surface.ContainerHigh}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Decision.DuplicateSummary}" Foreground="{DynamicResource Brush.Primary}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                                      </Border>
                                      <StackPanel>
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}"><Run Text="{Binding Decision.DateText, Mode=OneWay}" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding WeekdayText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /></TextBlock>
                                        <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                                      </StackPanel>
                                    </DockPanel>

                                    <!-- 同一天分段（HANABE-IMPORT-DAY-SPLIT）：第几段、时间、与上一段间隔；可合并或整天放一起 -->
                                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="10" Background="{DynamicResource Brush.Surface.ContainerHigh}" Visibility="{Binding Decision.IsSegmented, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="同一天分段">
                                      <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                          <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding Decision.SegmentBrush}" />
                                          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}"><Run Text="{Binding Decision.SegmentLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Decision.SegmentTimeText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" /></TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Decision.SegmentGapText}" Margin="18,2,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" />
                                        <WrapPanel Margin="18,6,0,0">
                                          <Button Content="和上一段放一起" Style="{StaticResource Button.Secondary}" Padding="10,4" Margin="0,0,8,0" FontSize="{StaticResource Typography.Caption}"
                                                  Visibility="{Binding Decision.CanMergeWithPrevious, Converter={StaticResource BoolToVis}}"
                                                  Command="{Binding DataContext.MergeImportSegmentWithPreviousCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Decision}" AutomationProperties.Name="这两段放一起" />
                                          <Button Content="这一天都放进一个文件夹" Style="{StaticResource Button.Secondary}" Padding="10,4" FontSize="{StaticResource Typography.Caption}"
                                                  Command="{Binding DataContext.KeepImportDayTogetherCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Decision}" AutomationProperties.Name="都放进一个文件夹" />
                                        </WrapPanel>
                                      </StackPanel>
                                    </Border>
                                    <DockPanel Margin="0,10,0,0" Visibility="{Binding Decision.IsDayKeptTogether, Converter={StaticResource BoolToVis}}">
                                      <Button DockPanel.Dock="Right" Content="分开放" Style="{StaticResource Button.Secondary}" Padding="10,4" FontSize="{StaticResource Typography.Caption}"
                                              Visibility="{Binding Decision.IsDayKeptTogether, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding DataContext.SplitImportDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Decision}" AutomationProperties.Name="按拍摄间隔分开放" />
                                      <TextBlock Text="{Binding Decision.DaySplitHint}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Visibility="{Binding Decision.IsDayKeptTogether, Converter={StaticResource BoolToVis}}" />
                                    </DockPanel>

                                    <!-- 缩略图条 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                      <ItemsControl ItemsSource="{Binding Strip}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate DataType="{x:Type vms:ImportPreviewItemViewModel}">
                                            <Border Width="50" Height="50" Margin="0,0,6,0" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource Brush.Surface.ContainerHigh}" ToolTip="{Binding Name}">
                                              <Grid>
                                                <TextBlock Text="{Binding ExtensionBadge}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource Typography.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}" />
                                                <Border CornerRadius="10"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" /></Border.Background></Border>
                                              </Grid>
                                            </Border>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                      <Border Width="50" Height="50" CornerRadius="10" Background="{DynamicResource Brush.Surface.ContainerHigh}" Visibility="{Binding HasStripOverflow, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding StripOverflowText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                                      </Border>
                                    </StackPanel>

                                    <!-- 分类比例条 + 图例 -->
                                    <Border Margin="0,14,0,0" Height="8" CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Left" Width="{x:Static vms:ImportDateGraphGroupViewModel.BreakdownBarWidth}" Background="{DynamicResource Brush.Surface.ContainerHigh}">
                                      <ItemsControl ItemsSource="{Binding Breakdown}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Width="{Binding BarWidth}" Height="8" Background="{Binding Brush}" Margin="0,0,1,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Breakdown}" Margin="0,8,0,0">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                                          </StackPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 放到哪里 -->
                                    <Border Height="1" Margin="0,12" Background="{DynamicResource Brush.Border.Subtle}" />
                                    <TextBlock Text="放到" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" />
                                    <TextBlock Text="{Binding Decision.FinalDirectoryName}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" ToolTip="{Binding Decision.FinalDirectoryPath}" />
                                    <ComboBox ItemsSource="{Binding Decision.AvailableStrategies}" Style="{StaticResource Input.ComboBox}" SelectedValuePath="Value" SelectedValue="{Binding Decision.Strategy}" AutomationProperties.Name="日期文件夹处理方式">
                                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Decision.ExistingFolders}" Style="{StaticResource Input.ComboBox}" SelectedItem="{Binding Decision.SelectedExistingFolder}" AutomationProperties.Name="选择已有日期文件夹" Visibility="{Binding Decision.HasExistingFolders, Converter={StaticResource BoolToVis}}" ToolTip="这一天已经有的文件夹">
                                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Margin="0,8,0,0">
                                      <TextBox x:Name="RemarkBox" Height="34" VerticalContentAlignment="Center" Style="{StaticResource Input.TextBox}" Text="{Binding Decision.Remark, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="日期文件夹备注" />
                                      <TextBlock Text="备注（可选），例如 婚礼、漫展外拍" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.BodySmall}">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RemarkBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                      </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding Decision.ValidationMessage}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Status.Warning}" FontSize="{StaticResource Typography.Caption}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- 展开全部素材（必要时才看） -->
                          <DockPanel Margin="0,4,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsImportQueueExpanded, Converter={StaticResource BoolToVis}}">
                              <TextBox Width="220" Height="34" VerticalContentAlignment="Center" Style="{DynamicResource Input.TextBox}" Text="{Binding ImportSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按文件名、来源路径或场次筛选" AutomationProperties.Name="搜索导入素材" IsEnabled="{Binding CanEditImportOrganization}" />
                              <Button Content="分类与场次" Margin="8,0,0,0" Padding="12,6" Style="{StaticResource Button.Secondary}" Click="ImportOrganizeToggle_Click" ToolTip="改分类、建场次：选中缩略图后拖到分类或场次上" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Content="{Binding ImportQueueToggleText}" Style="{StaticResource Button.Secondary}" Padding="16,7" Click="ToggleImportQueue_Click" AutomationProperties.Name="查看全部素材" />
                          </DockPanel>
                          <!-- 全部素材（逐张核对 / 改分类时才展开） -->
                          <Grid Visibility="{Binding IsImportQueueExpanded, Converter={StaticResource BoolToVis}}">
                          <!-- 素材（按类型分组） -->
                          <ItemsControl ItemsSource="{Binding ImportSections}" IsEnabled="{Binding CanEditImportOrganization}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:ImportCategorySectionViewModel}">
                                <StackPanel Margin="0,0,0,16">
                                  <DockPanel Margin="2,0,0,10">
                                    <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,10,0" Background="{Binding AccentBrush}">
                                      <TextBlock FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                      <TextBlock Foreground="{DynamicResource Brush.Text.Primary}"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="{StaticResource Typography.Label}" /><Run Text="  " /><Run Text="{Binding Items.Count, Mode=OneWay, StringFormat={}{0} 项}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /><Run Text="  " /><Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" /></TextBlock>
                                      <TextBlock Foreground="{DynamicResource Brush.Primary}" FontSize="{StaticResource Typography.Caption}" TextWrapping="Wrap" Text="{Binding RenderHint}" />
                                    </StackPanel>
                                  </DockPanel>
                                  <ItemsControl ItemsSource="{Binding VisibleItems}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="{x:Type vms:ImportPreviewItemViewModel}">
                                        <Border x:Name="QueueCard" Width="176" Margin="0,0,10,10" CornerRadius="12" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Background="{DynamicResource Brush.Surface.ContainerLowest}">
                                          <StackPanel>
                                            <Grid Height="104" Background="{DynamicResource Brush.Surface.ContainerHigh}" PreviewMouseLeftButtonDown="ImportThumbnail_MouseDown" PreviewMouseMove="ImportThumbnail_MouseMove" ToolTip="点击选中，Ctrl 多选，拖到右侧分类或场次">
                                              <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsOrganizeSelected}" Value="True"><Setter Property="Opacity" Value="0.55" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                              <Grid Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Foreground="{DynamicResource Brush.Primary}" FontSize="{StaticResource Typography.Title}" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ExtensionBadge}" />
                                              </Grid>
                                              <Rectangle>
                                                <Shape.Fill><ImageBrush Stretch="UniformToFill" ImageSource="{Binding Thumbnail}" /></Shape.Fill>
                                              </Rectangle>
                                              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Padding="6,2" CornerRadius="8" Background="{DynamicResource Brush.Overlay.Scrim}">
                                                <TextBlock Foreground="{DynamicResource Brush.Viewer.Text}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Text="{Binding CategoryBadge}" />
                                              </Border>
                                              <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="6,2" CornerRadius="8" Background="{DynamicResource Brush.PrimaryContainer}" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Foreground="{DynamicResource Brush.OnPrimaryContainer}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Text="需要确认" />
                                              </Border>
                                            </Grid>
                                            <StackPanel Margin="10,8,10,10">
                                              <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Style="{DynamicResource Selection.CheckBox}" IsChecked="{Binding IsSelected}" Margin="0,0,6,0" ToolTip="是否导入这一组" />
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding PrimaryPath}" Foreground="{DynamicResource Brush.Text.Primary}" />
                                              </DockPanel>
                                              <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding TargetDateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" /></TextBlock>
                                              <TextBlock Text="{Binding ImportSessionName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Primary}" FontSize="{StaticResource Typography.Caption}" />
                                              <ComboBox DisplayMemberPath="Display" Margin="0,6,0,0" Height="30" ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding SelectedCategory}" ToolTip="分类" />
                                            </StackPanel>
                                          </StackPanel>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <Button HorizontalAlignment="Left" Padding="14,6" Content="{Binding HiddenCount, StringFormat=显示更多（还有 {0:N0} 组）}" Command="{Binding ShowMoreCommand}" Visibility="{Binding HasHiddenItems, Converter={StaticResource BoolToVis}}" Style="{StaticResource Button.Ghost}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          </Grid>
                        </StackPanel>
                      </ScrollViewer>

                      <!-- 分类与场次（展开全部素材后按需打开，拖缩略图到这里） -->
                      <Border Grid.Row="0" Grid.Column="1" Width="320" Margin="14,0,0,0" Padding="16" CornerRadius="14" Style="{DynamicResource Layout.GlassPanel}" Visibility="{Binding IsImportOrganizePanelOpen, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="收起" Style="{StaticResource Button.Ghost}" Padding="8,3" Click="CloseImportOrganizePanel_Click" />
                            <TextBlock Text="分类与场次" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </DockPanel>
                          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding CanEditImportOrganization}">
                            <Button Content="全选当前" ToolTip="选中当前筛选结果，再拖到分类或场次" Command="{Binding MarkVisibleImportItemsCommand}" Style="{DynamicResource Button.Ghost}" Padding="8,3" Margin="0,0,6,0" />
                            <Button Content="取消选择" Command="{Binding ClearImportMarksCommand}" Style="{DynamicResource Button.Ghost}" Padding="8,3" />
                          </WrapPanel>
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <imports:ImportOrganizationPanel />
                          </ScrollViewer>
                        </DockPanel>
                      </Border>

                      <!-- 底栏：来源 + 开始导入 -->
                      <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="14" Style="{DynamicResource Layout.GlassPanel}">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="重新选择来源" Style="{StaticResource Button.Ghost}" Padding="12,7" Command="{Binding StartNewImportCommand}" ToolTip="清空本次队列，回到选择来源（不删除任何文件）" />
                            <Button Content="开始导入  →" Style="{StaticResource Button.Primary}" Padding="22,8" Margin="8,0,0,0" Command="{Binding StartImportFromReviewCommand}" AutomationProperties.Name="确认并开始导入" ToolTip="按每个日期卡片上的“放到”开始复制；可以随时安全停止" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="来源" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ItemsControl ItemsSource="{Binding ImportSourceCards}" VerticalAlignment="Center">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Margin="0,0,8,0" Padding="10,4" CornerRadius="{StaticResource Radius.Full}" Background="{DynamicResource Brush.Surface.ContainerHigh}" ToolTip="{Binding Path}">
                                    <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" /><Run Text=" 个文件" Foreground="{DynamicResource Brush.Text.Secondary}" /></TextBlock>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </Grid>

                    <!-- ===== 3 导入中 ===== -->
                    <StackPanel MaxWidth="760" VerticalAlignment="Center" Visibility="{Binding IsImportRunningStage, Converter={StaticResource BoolToVis}}" controls:Motion.RevealOrder="1">
                      <Border Padding="28,24" CornerRadius="18" Style="{DynamicResource Layout.GlassPanel}">
                        <StackPanel>
                          <TextBlock Text="正在导入" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ProgressLabel}" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                          <ProgressBar Height="8" Margin="0,16,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                          <TextBlock Text="{Binding ImportWorkspaceSummary}" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                          <DockPanel Margin="0,20,0,0">
                            <Button DockPanel.Dock="Right" Content="安全停止 · 保留进度" Style="{StaticResource Button.Secondary}" Padding="16,7" Command="{Binding CancelCurrentTaskCommand}" ToolTip="停止当前传输并保留恢复记录，之后可以继续未完成项目。" />
                            <TextBlock Text="可以切到别的页面，导入会在后台继续；中途断开也能从断点接着导。" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" Margin="0,0,16,0" />
                          </DockPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- ===== 3 完成 ===== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsImportDoneStage, Converter={StaticResource BoolToVis}}" controls:Motion.RevealOrder="1">
                      <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Border Padding="28,24" CornerRadius="18" Style="{DynamicResource Layout.GlassPanel}">
                          <StackPanel>
                            <TextBlock Text="导入完成" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ImportReportHeadline}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                              <StackPanel Margin="0,0,44,0">
                                <TextBlock x:Name="ImportSuccessText" FontSize="{StaticResource Typography.Display}" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" Text="{Binding ImportSuccessCount}" RenderTransformOrigin="0.5,0.5">
                                  <TextBlock.RenderTransform><ScaleTransform x:Name="ImportSuccessScale" ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="成功" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                              </StackPanel>
                              <StackPanel Margin="0,0,44,0">
                                <TextBlock x:Name="ImportSkippedText" FontSize="{StaticResource Typography.Display}" FontWeight="Bold" Foreground="{DynamicResource Brush.Tertiary}" Text="{Binding ImportSkippedCount}" RenderTransformOrigin="0.5,0.5">
                                  <TextBlock.RenderTransform><ScaleTransform x:Name="ImportSkippedScale" ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="跳过（重复）" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock x:Name="ImportFailedText" FontSize="{StaticResource Typography.Display}" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Danger}" Text="{Binding ImportFailedCount}" RenderTransformOrigin="0.5,0.5">
                                  <TextBlock.RenderTransform><ScaleTransform x:Name="ImportFailedScale" ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="失败" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" />
                              </StackPanel>
                            </StackPanel>
                            <WrapPanel Margin="0,22,0,0">
                              <Button Content="继续导入其它素材" Style="{StaticResource Button.Primary}" Padding="18,8" Margin="0,0,8,8" Command="{Binding StartNewImportCommand}" AutomationProperties.Name="继续导入其它素材" />
                              <Button Content="在图库中查看" Style="{StaticResource Button.Secondary}" Padding="16,8" Margin="0,0,8,8" Command="{Binding ShowPreviewCommand}" />
                              <Button Content="整理场次" Tag="ImportLast" Click="OpenSessions_Click" IsEnabled="{Binding CanOrganizeImportedSessions}" Style="{StaticResource Button.Secondary}" Padding="16,8" Margin="0,0,8,8" ToolTip="按拍摄时间预览分组；只创建虚拟场次，不移动原图。" />
                              <Button Content="管理日期文件夹备注" Style="{StaticResource Button.Ghost}" Padding="14,8" Margin="0,0,8,8" Command="{Binding ShowDateFoldersCommand}" AutomationProperties.Name="管理日期文件夹备注" Visibility="{Binding HasCompletedImport, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>
                            <Expander Margin="0,10,0,0" IsExpanded="False" Header="{Binding ImportReportDetailsHeader}" Visibility="{Binding HasImportReportDetails, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="导入详细记录">
                              <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding ImportReportDetails}" />
                              </ScrollViewer>
                            </Expander>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </DockPanel>
              </Border>
            </Grid>
            <Grid Name="PreviewPage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource PageSurface}" Visibility="{Binding IsPreviewPage, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource Layout.PagePanel}" Padding="0">
                <DockPanel LastChildFill="True">
                <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                  <!-- 左侧日期列表的一行：与侧栏、按钮同一套圆角；当前日期用粉色容器色 -->
                  <Style x:Key="GalleryDateRow" TargetType="{x:Type Button}">
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border x:Name="RowSurface" CornerRadius="{StaticResource Radius.Small}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" /></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Value="True">
                        <DataTrigger.Binding>
                          <MultiBinding Converter="{StaticResource CategoryEqualityMultiConverter}">
                            <Binding Path="DataContext.GalleryCurrentDatePath" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                          </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimaryContainer}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                  <!-- 类型分段（全部 / RAW / JPG …）：与“修图状态”分段同一外观，当前项用次强调容器色 -->
                  <Style x:Key="PreviewCategoryChipButton" TargetType="{x:Type Button}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinWidth" Value="44" />
                    <Setter Property="Padding" Value="11,0" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="{StaticResource Typography.BodySmall}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border x:Name="ChipSurface" CornerRadius="{StaticResource Radius.Small}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentTemplate="{StaticResource Button.PrimaryTextTemplate}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChipSurface" Property="Background" Value="{DynamicResource Brush.Surface.ContainerHigh}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChipSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" /></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Value="True">
                        <DataTrigger.Binding>
                          <MultiBinding Converter="{StaticResource CategoryEqualityMultiConverter}">
                            <Binding Path="DataContext.CurrentPreviewCategory" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                          </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="{DynamicResource Brush.SecondaryContainer}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Secondary}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSecondaryContainer}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                  <!-- 日期树：年 / 月是小标题，日是可点的一行（数量靠右） -->
                  <DataTemplate DataType="{x:Type vm:LibraryDateNode}">
                    <StackPanel>
                      <TextBlock x:Name="DateGroupTitle" Text="{Binding Title}" Margin="10,12,0,4" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                      <Button x:Name="DateRow" Style="{StaticResource GalleryDateRow}" Tag="{Binding SelectionKey}" Visibility="Collapsed"
                              Command="{Binding DataContext.SelectLibraryDateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Title}" ToolTip="{Binding FullPath}">
                        <DockPanel>
                          <TextBlock x:Name="DateRowCount" DockPanel.Dock="Right" Text="{Binding TotalFiles, StringFormat={}{0:N0}}" Margin="8,0,0,0" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding ShortTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="{StaticResource Typography.BodySmall}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </DockPanel>
                      </Button>
                      <!-- 场次子级（按拍摄间隔虚拟分组）：点一下跳到那一场；可一键拆成文件夹 -->
                      <StackPanel x:Name="DateSessions" Margin="14,0,0,4" Visibility="Visible">
                        <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Style="{StaticResource GalleryDateRow}" Tag="{Binding SectionKey}" MinHeight="28"
                                      Command="{Binding DataContext.ScrollToDaySessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                      ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Title}">
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Margin="8,0,0,0" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                                  <Border Width="2" Height="14" Margin="0,0,8,0" CornerRadius="1" Background="{DynamicResource Brush.Border.Strong}" VerticalAlignment="Center" />
                                  <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Typography.Caption}">
                                    <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                  </TextBlock>
                                </DockPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" MinHeight="26" Padding="8,0" Margin="2,2,0,0" FontSize="{StaticResource Typography.Caption}"
                                Content="按场次拆成文件夹…" ToolTip="预览后把第 2 场起的照片移到新的日期文件夹（如 11.07_晚上）"
                                Command="{Binding DataContext.SplitDayFolderBySessionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="按场次拆成文件夹" />
                      </StackPanel>
                      <ItemsControl x:Name="DateChildren" ItemsSource="{Binding Children}" Focusable="False" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                        <Setter TargetName="DateSessions" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsDayGroup}" Value="True">
                        <Setter TargetName="DateChildren" Property="Margin" Value="14,0,0,0" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSelectable}" Value="True">
                        <Setter TargetName="DateGroupTitle" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="DateRow" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding TotalFiles}" Value="0">
                        <Setter TargetName="DateRowCount" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </Grid.Resources>
                <!-- 左栏：全部日期 + 按年 / 月分组的拍摄日（点一天只看这一天）；底部是人物筛选 -->
                <Border x:Name="GalleryDateNavigator" Grid.Column="0" Width="224" Margin="0,0,16,0" Padding="8,10" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" AutomationProperties.Name="拍摄日期列表">
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="2,10,2,0">
                      <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,0,0,10" />
                      <DockPanel Margin="8,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" MinHeight="28" Padding="10,2" FontSize="{StaticResource Typography.Caption}" Content="扫描" Command="{Binding PeopleAlbums.ScanCommand}" AutomationProperties.Name="在本机扫描人物相册" />
                        <TextBlock Text="人物" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                      </DockPanel>
                      <TextBlock Text="{Binding PeopleAlbums.SummaryText}" Margin="8,0,8,6" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                      <ProgressBar Height="4" Margin="8,0,8,6" Minimum="0" Maximum="100" Value="{Binding PeopleAlbums.ScanProgressValue, Mode=OneWay}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}" />
                      <Button Margin="0,0,0,6" Style="{StaticResource Button.Ghost}" MinHeight="28" Content="取消扫描" Command="{Binding PeopleAlbums.CancelScanCommand}" Visibility="{Binding PeopleAlbums.IsScanning, Converter={StaticResource BoolToVis}}" />
                      <Button x:Name="PeopleBubbleButton" Style="{StaticResource Button.Secondary}" MinHeight="32" Padding="10,0" Content="按人物筛选…" Command="{Binding PeopleAlbums.ToggleBubblesCommand}" />
                      <Button Content="清除人物筛选" Style="{StaticResource Button.Ghost}" MinHeight="28" Margin="0,6,0,0" Command="{Binding PeopleAlbums.ClearSelectionCommand}" Visibility="{Binding PeopleAlbums.SelectedAlbum, Converter={StaticResource NullToVis}}" />
                      <Popup PlacementTarget="{Binding ElementName=PeopleBubbleButton}" Placement="Right" HorizontalOffset="10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding PeopleAlbums.AreBubblesOpen, Mode=TwoWay}">
                        <Border Width="420" MaxHeight="460" Margin="4" Padding="14" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Overlay}" BorderBrush="{DynamicResource Brush.Glass.Stroke}" BorderThickness="1" Effect="{DynamicResource Shadow.Dialog}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="点一个人，只看有他的照片" Margin="2,0,0,10" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                              <ItemsControl ItemsSource="{Binding PeopleAlbums.Albums}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type vms:PersonAlbumItemViewModel}">
                                    <StackPanel Width="88" Margin="0,0,8,12">
                                      <Button Width="64" Height="64" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Command="{Binding SelectCommand}" ToolTip="点击只看此人物">
                                        <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1.5">
                                          <Border.Background><ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource PathThumb}}" Stretch="UniformToFill" /></Border.Background>
                                        </Border>
                                      </Button>
                                      <TextBlock HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="{StaticResource Typography.Caption}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                      <TextBlock HorizontalAlignment="Center" Margin="0,1,0,0" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{Binding PhotoCount, StringFormat={}{0} 张}" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </DockPanel>
                        </Border>
                      </Popup>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel>
                        <Button Style="{StaticResource GalleryDateRow}" Tag="" Command="{Binding ShowAllDatesCommand}" AutomationProperties.Name="返回全部日期">
                          <TextBlock Text="全部日期" VerticalAlignment="Center" FontSize="{StaticResource Typography.BodySmall}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <ItemsControl ItemsSource="{Binding LibraryDates}" Focusable="False" />
                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
                <Border x:Name="BrowseUnifiedWorkspace" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="16">
                  <Grid>
                  <DockPanel LastChildFill="True">
                    <!-- 照片墙上方的工具栏：常驻，不再藏在“浏览条件”里。第一行搜索；第二行类型 / 修图 / 评分 / 排序 / 多选，右侧缩放 -->
                    <StackPanel x:Name="GalleryToolbar" DockPanel.Dock="Top" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 页标题与当前范围：和搜索框同一行，不再单独占三层 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                          <TextBlock Text="{Binding PageTitle}" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding GalleryScopeText}" Margin="10,2,0,0" VerticalAlignment="Center" FontSize="{StaticResource Typography.BodySmall}" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding BrowseConditionsSummary}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                          <TextBox x:Name="BrowseSmartSearchBox"
                                   Style="{StaticResource Input.TextBox}"
                                   Height="36"
                                   VerticalContentAlignment="Center"
                                   Text="{Binding UnifiedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="智能搜索照片"
                                   ToolTip="输入文件名或路径直接匹配；输入自然描述进行语义搜索。Ctrl+K 跳到这里" />
                          <TextBlock Text="搜文件名，或描述画面：海边日落、多人合照…  Ctrl+K" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.BodySmall}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Text, ElementName=BrowseSmartSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                        <ComboBox Grid.Column="2" Width="116" Height="36" Margin="8,0,0,0"
                                  ItemsSource="{Binding BrowseSearchModeChoices}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding BrowseSearchMode, Mode=TwoWay}"
                                  AutomationProperties.Name="智能搜索模式">
                          <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="3" Style="{DynamicResource Button.Ghost}" Height="36" Margin="8,0,0,0" Content="取消"
                                Command="{Binding SemanticSearch.CancelCommand}"
                                Visibility="{Binding SemanticSearch.IsBusy, Converter={StaticResource BoolToVis}}" />
                        <Button Grid.Column="4" Style="{StaticResource Button.Secondary}" Height="36" Margin="8,0,0,0" Padding="12,0" Command="{Binding ToggleBrowseInspectorCommand}" AutomationProperties.Name="显示或隐藏信息面板" ToolTip="显示 / 隐藏右侧信息面板（Ctrl+I）">
                          <TextBlock>
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="显示信息" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsBrowseInspectorOpen}" Value="True"><Setter Property="Text" Value="隐藏信息" /></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Button>
                        <!-- ⋯：不常用的图库维护操作（扫描重复内容 / 安全隔离区）；扫描进行中在按钮左侧显示进度 -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                          <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsDuplicateScanRunning, Converter={StaticResource BoolToVis}}" ToolTip="正在扫描重复内容">
                            <ProgressBar Width="56" Height="4" IsIndeterminate="True" />
                          </StackPanel>
                          <Button x:Name="GalleryMoreButton" Style="{StaticResource Button.Secondary}" Width="36" Height="36" MinHeight="36" Padding="0" Click="GalleryMoreButton_Click" AutomationProperties.Name="更多图库操作" ToolTip="更多：扫描重复内容、安全隔离区">
                            <TextBlock Text="⋯" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Button.ContextMenu>
                              <ContextMenu Style="{DynamicResource Menu.Context}" FontFamily="{StaticResource Typography.FontFamily.UI}" FontSize="{StaticResource Typography.Body}">
                                <MenuItem Style="{DynamicResource Menu.Item}" Header="扫描重复内容" Command="{Binding ScanLibraryDuplicatesCommand}" AutomationProperties.Name="扫描图库重复内容" />
                                <MenuItem Style="{DynamicResource Menu.Item}" Header="安全隔离区" Command="{Binding OpenQuarantineCommand}" AutomationProperties.Name="打开安全隔离区" />
                              </ContextMenu>
                            </Button.ContextMenu>
                          </Button>
                        </StackPanel>
                      </Grid>
                      <StackPanel Margin="0,8,0,0" Visibility="{Binding SemanticSearch.HasActiveQuery, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Minimum="0" Maximum="100" Height="{StaticResource Spacing.6}"
                                     Value="{Binding SemanticSearch.ProgressValue, Mode=OneWay}"
                                     Visibility="{Binding SemanticSearch.IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SemanticSearch.StatusText}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" TextWrapping="Wrap" />
                      </StackPanel>

                      <DockPanel Margin="0,10,0,0" LastChildFill="True">
                        <WrapPanel VerticalAlignment="Center">
                          <!-- 类型 -->
                          <Border Padding="2" Margin="0,0,8,6" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" AutomationProperties.Name="按类型筛选">
                            <ItemsControl ItemsSource="{Binding PreviewCategoryChips}" Focusable="False">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Style="{StaticResource PreviewCategoryChipButton}" Content="{Binding Label}" Tag="{Binding Value}"
                                          Command="{Binding DataContext.SetPreviewCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Value}"
                                          AutomationProperties.Name="{Binding Label}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                          <!-- 修图状态 -->
                          <Border Padding="2" Margin="0,0,8,6" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.ContainerHigh}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" AutomationProperties.Name="按修图状态筛选">
                            <StackPanel Orientation="Horizontal">
                              <Button Content="全部" Tag="全部" CommandParameter="全部" Height="32" Style="{StaticResource PreviewSegmentButton}" ContentTemplate="{StaticResource Button.PrimaryTextTemplate}" AutomationProperties.Name="显示全部照片" Command="{Binding SetPreviewRetouchFilterCommand}" />
                              <Button Content="已修" Tag="已修" CommandParameter="已修" Height="32" Style="{StaticResource PreviewSegmentButton}" ContentTemplate="{StaticResource Button.PrimaryTextTemplate}" AutomationProperties.Name="仅显示已修照片" Command="{Binding SetPreviewRetouchFilterCommand}" />
                              <Button Content="未修" Tag="未修" CommandParameter="未修" Height="32" Style="{StaticResource PreviewSegmentButton}" ContentTemplate="{StaticResource Button.PrimaryTextTemplate}" AutomationProperties.Name="仅显示未修照片" Command="{Binding SetPreviewRetouchFilterCommand}" />
                            </StackPanel>
                          </Border>
                          <ComboBox MinWidth="108" Height="36" Margin="0,0,8,6" ItemsSource="{Binding RatingFilters}" SelectedItem="{Binding RatingFilter, Mode=TwoWay}" AutomationProperties.Name="按照片评分筛选" ToolTip="评分" />
                          <ComboBox SelectedValuePath="Value" Margin="0,0,8,6" Style="{StaticResource PreviewSortComboBox}" AutomationProperties.Name="照片排列方式" ToolTip="排列方式" ItemsSource="{Binding PreviewSortChoices}" SelectedValue="{Binding PreviewSortMode, Mode=TwoWay}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:PreviewSortChoice}">
                                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Body}" Text="{Binding Label}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ComboBox>
                          <CheckBox Content="多选" Height="36" Margin="4,0,12,6" VerticalContentAlignment="Center"
                                    IsChecked="{Binding IsMultiSelectMode, Mode=TwoWay}"
                                    AutomationProperties.Name="多选模式"
                                    ToolTip="多选模式：开启后单击可勾选多张照片" />
                          <Button Height="36" Margin="0,0,8,6" Style="{StaticResource Button.Disclosure}" Command="{Binding ToggleAdvancedFiltersCommand}" AutomationProperties.Name="展开或收起更多筛选">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="智能识别" VerticalAlignment="Center" />
                              <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" FontSize="{StaticResource Typography.Caption}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▸" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsAdvancedFiltersExpanded}" Value="True"><Setter Property="Text" Value="▾" /></DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </Button>
                          <Button Content="清除筛选" Height="36" Margin="0,0,8,6" Style="{StaticResource Button.Ghost}" Foreground="{DynamicResource Brush.Primary}" Command="{Binding ResetBrowseConditionsCommand}" Visibility="{Binding HasActiveBrowseFilters, Converter={StaticResource BoolToVis}}" ToolTip="{Binding BrowseConditionsSummary}" AutomationProperties.Name="清除全部筛选" />
                        </WrapPanel>
                      </DockPanel>

                      <!-- 智能识别（默认收起，180ms 缓动）：识别引擎、智能类别、识别所选 / 当前范围；以及拍摄场次入口 -->
                      <Border ClipToBounds="True">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="MaxHeight" Value="0" />
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsAdvancedFiltersExpanded}" Value="True">
                                <DataTrigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="200" Duration="{StaticResource Motion.Duration.Normal}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Duration.Normal}" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="{StaticResource Motion.Duration.Normal}">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Duration.Normal}" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </DataTrigger.ExitActions>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" IsEnabled="{Binding IsAdvancedFiltersExpanded}">
                          <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Width="200" Margin="14,0,0,0" VerticalAlignment="Center">
                              <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding PhotoAnalysis.ProgressValue, Mode=OneWay}" />
                              <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" Text="{Binding PhotoAnalysis.StatusText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                              <ComboBox Height="36" MinWidth="120" Margin="0,0,8,4" ItemsSource="{Binding PhotoAnalysis.Engines}" SelectedItem="{Binding PhotoAnalysis.SelectedEngine, Mode=TwoWay}" AutomationProperties.Name="智能识别引擎" ToolTip="识别引擎" />
                              <ComboBox Height="36" MinWidth="120" Margin="0,0,8,4" ItemsSource="{Binding SmartCategoryFilters}" SelectedItem="{Binding SmartCategoryFilter, Mode=TwoWay}" AutomationProperties.Name="按智能类别筛选" ToolTip="按智能类别筛选" />
                              <Button Margin="0,0,8,4" Padding="14,0" Style="{StaticResource Button.Secondary}" Content="识别所选" Command="{Binding AnalyzeSelectedPhotosCommand}" AutomationProperties.Name="智能识别所选照片" />
                              <Button Margin="0,0,8,4" Padding="14,0" Style="{StaticResource Button.Secondary}" Content="识别当前范围" Command="{Binding AnalyzeCurrentScopeCommand}" AutomationProperties.Name="智能识别当前日期或全部照片" />
                              <Button Margin="0,0,8,4" Padding="12,0" Style="{StaticResource Button.Ghost}" Content="停止" Command="{Binding PhotoAnalysis.CancelCommand}" />
                              <Button Margin="0,0,8,4" Padding="12,0" Style="{StaticResource Button.Ghost}" Content="拍摄场次…" Click="OpenSessions_Click" ToolTip="素材管理 · 拍摄场次" />
                            </WrapPanel>
                          </DockPanel>
                        </Border>
                      </Border>
                    </StackPanel>
                    <!-- 底栏：左边数量，右边缩略图大小（离照片墙最近，不占筛选行） -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="2,8,0,0" LastChildFill="True">
                            <!-- 缩略图大小：Ctrl + 滚轮以指针位置缩放 -->
                            <StackPanel x:Name="BrowseSidebarThumbnailControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding IsGridBrowseMode, Converter={StaticResource BoolToVis}}" ToolTip="缩略图大小（Ctrl + 滚轮：以指针位置缩放）">
                              <Button Content="−" Style="{StaticResource Button.Icon}" Width="32" Height="32" MinHeight="32" Padding="0" Click="GalleryZoomOut_Click" ToolTip="缩小缩略图" />
                              <Slider x:Name="GalleryZoomSlider" Width="120" Margin="4,0" VerticalAlignment="Center" Minimum="48" Maximum="512" Value="{Binding ZoomableGridTileSize, Mode=OneWay}" ValueChanged="GalleryZoomSlider_ValueChanged" ToolTip="调整缩略图大小" />
                              <Button Content="+" Style="{StaticResource Button.Icon}" Width="32" Height="32" MinHeight="32" Padding="0" Click="GalleryZoomIn_Click" ToolTip="放大缩略图" />
                              <Button Content="还原" Style="{StaticResource Button.Ghost}" MinHeight="32" Padding="8,0" FontSize="{StaticResource Typography.Caption}" Click="GalleryZoomReset_Click" ToolTip="缩略图恢复默认大小" />
                            </StackPanel>
                      <TextBlock VerticalAlignment="Center" FontSize="{StaticResource Typography.BodySmall}" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding CurrentViewItemCount, Mode=OneWay, StringFormat=共 {0} 项}" AutomationProperties.HelpText="{Binding FilteredPreviewCount, Mode=OneWay, StringFormat=共 {0} 项}" />
                    </DockPanel>
                    <Grid Name="PreviewSelectionSurface" Background="Transparent" Visibility="{Binding IsGridBrowseMode, Converter={StaticResource BoolToVis}}" PreviewMouseLeftButtonDown="PreviewSelectionSurface_MouseLeftButtonDown" PreviewMouseMove="PreviewSelectionSurface_MouseMove" PreviewMouseLeftButtonUp="PreviewSelectionSurface_MouseLeftButtonUp">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <ItemsControl Grid.Row="0" Margin="0,0,0,14" ItemsSource="{Binding GridBreadcrumbs}" Visibility="{Binding HasGridBreadcrumb, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Padding="10,4" Margin="0,0,6,0" Content="{Binding Label}" Command="{Binding DataContext.NavigateGridCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ScrollViewer Grid.Row="1" Name="PreviewPhotoScrollViewer" CanContentScroll="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel" PreviewMouseDown="PreviewScrollViewer_PreviewMouseDown" PreviewMouseMove="PreviewScrollViewer_PreviewMouseMove" PreviewMouseUp="PreviewScrollViewer_PreviewMouseUp">
                      <ItemsControl x:Name="PreviewWallItemsControl" ItemsSource="{Binding PreviewWallItems}" ItemContainerStyle="{StaticResource PreviewWallItemContainer}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <controls:VirtualizingWrapPanel ItemWidth="{Binding DataContext.ZoomableGridTileStride, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           ItemHeight="{Binding DataContext.ZoomableGridTileStride, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           HeaderHeight="64"
                                                           SectionPadding="{StaticResource Spacing.8}"
                                                           SectionSpacing="{StaticResource Spacing.12}"
                                                           SectionCornerRadius="{StaticResource Radius.Dialog}"
                                                           SectionBackground="{DynamicResource Brush.Surface.Subtle}"
                                                           SectionBorderBrush="{DynamicResource Brush.Border.Subtle}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                          <DataTemplate DataType="{x:Type vm:PreviewDateSectionViewModel}">
                            <Button Height="64" Style="{StaticResource PreviewDateHeaderButton}" Command="{Binding ToggleCommand}" ToolTip="{Binding ToggleLabel}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="6" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                  <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" Text="{Binding Title}" />
                                  <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Body}" FontWeight="Medium" Margin="12,0">
                                  <Run Text="{Binding Count, Mode=OneWay}" />
                                  <Run Text=" 张" />
                                </TextBlock>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ToggleGlyph}" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                          <DataTemplate DataType="{x:Type vms:PreviewFileViewModel}">
                            <Grid x:Name="PreviewTileRoot" Tag="PreviewCard" Margin="0,0,12,12" ClipToBounds="True" Cursor="Hand" Loaded="PreviewWallTile_Loaded" SizeChanged="PreviewWallTile_SizeChanged" MouseLeftButtonDown="PreviewThumbnail_MouseLeftButtonDown" MouseMove="PreviewThumbnail_MouseMove" ContextMenuOpening="PreviewThumbnail_ContextMenuOpening">
                                          <FrameworkElement.ContextMenu>
                                            <ContextMenu Style="{DynamicResource Menu.Context}" FontFamily="{StaticResource Typography.FontFamily.UI}" FontSize="{StaticResource Typography.Body}">
                                              <MenuItem Style="{DynamicResource Menu.Item}" Click="PreviewContextMenu_Open">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.Image}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Header>打开</MenuItem.Header>
                                              </MenuItem>
                                              <Separator Style="{DynamicResource Separator.Menu}" />
                                              <MenuItem Style="{DynamicResource Menu.Item}">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.Star}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Header>评分</MenuItem.Header>
                                                <MenuItem Header="★★★★★  5" Click="PreviewContextMenu_Rate5" />
                                                <MenuItem Header="★★★★  4" Click="PreviewContextMenu_Rate4" />
                                                <MenuItem Header="★★★  3" Click="PreviewContextMenu_Rate3" />
                                                <MenuItem Header="★★  2" Click="PreviewContextMenu_Rate2" />
                                                <MenuItem Header="★  1" Click="PreviewContextMenu_Rate1" />
                                                <Separator />
                                                <MenuItem Click="PreviewContextMenu_Rate0">
                                                  <MenuItem.Icon>
                                                    <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.X}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                  </MenuItem.Icon>
                                                  <MenuItem.Header>删除标记 (0)</MenuItem.Header>
                                                </MenuItem>
                                              </MenuItem>
                                              <MenuItem Style="{DynamicResource Menu.Item}">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.Tag}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Header>标签</MenuItem.Header>
                                                <MenuItem Header="人像" Click="PreviewContextMenu_TagPortrait" />
                                                <MenuItem Header="风光" Click="PreviewContextMenu_TagLandscape" />
                                                <MenuItem Header="废片" Click="PreviewContextMenu_TagWaste" />
                                                <Separator />
                                                <MenuItem Header="清除标签" Click="PreviewContextMenu_ClearTag" />
                                              </MenuItem>
                                              <Separator Style="{DynamicResource Separator.Menu}" />
                                              <MenuItem Style="{DynamicResource Menu.Item}" Click="PreviewContextMenu_OpenFolder">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.FolderOpen}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Header>在文件资源管理器中打开</MenuItem.Header>
                                              </MenuItem>
                                              <MenuItem Style="{DynamicResource Menu.Item}" Click="PreviewContextMenu_CopyPath">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.Copy}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Header>复制路径</MenuItem.Header>
                                              </MenuItem>
                                              <Separator Style="{DynamicResource Separator.Menu}" />
                                              <MenuItem Style="{DynamicResource Menu.Item}" Foreground="{DynamicResource Brush.Text.Primary}" Click="PreviewContextMenu_Delete">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Header>移入回收站</MenuItem.Header>
                                              </MenuItem>
                                              <Separator Style="{DynamicResource Separator.Menu}" />
                                              <MenuItem Style="{DynamicResource Menu.Item}" Click="PreviewContextMenu_BatchCopy">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.Copy}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Header>批量复制到...</MenuItem.Header>
                                              </MenuItem>
                                              <MenuItem Style="{DynamicResource Menu.Item}" Click="PreviewContextMenu_BatchMove">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.Folder}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Header>批量移动到...</MenuItem.Header>
                                              </MenuItem>
                                              <MenuItem Style="{DynamicResource Menu.Item}" Foreground="{DynamicResource Brush.Text.Primary}" Click="PreviewContextMenu_BatchDelete">
                                                <MenuItem.Icon>
                                                  <Viewbox Width="15" Height="15"><Path Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" /></Viewbox>
