                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="DeviceCardInteractionSurface" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                  <Setter TargetName="DeviceCardInteractionSurface" Property="Background" Value="{DynamicResource Brush.Surface.Disabled}" />
                  <Setter TargetName="DeviceCardInteractionSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}" />
                </Trigger>
              </ControlTemplate.Triggers>
