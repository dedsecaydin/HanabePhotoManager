                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <!-- 高频筛选（分类 / 修图状态 / 评分分类）+ 高级筛选折叠入口 -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,10">
                            <TextBlock Text="分类" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold" />
