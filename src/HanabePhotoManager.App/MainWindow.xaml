                                          </Border>
                                          <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="16" FontWeight="Black" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Text="{Binding Name}" />
                                          <Border HorizontalAlignment="Left" Padding="8,3" CornerRadius="10" Background="{DynamicResource Brush.Surface.Subtle}" Margin="0,5,0,0" Visibility="{Binding HasPersonLabel, Converter={StaticResource BoolToVis}}">
