                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <TextBlock FontSize="18" VerticalAlignment="Center" Text="{Binding Icon}" />
                                      <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="12" Text="{Binding Kind}" />
                                        <TextBlock Opacity="0.78" FontSize="12" TextWrapping="Wrap" Text="{Binding Detail}" />
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
