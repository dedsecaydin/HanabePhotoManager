                                          </Border>
                                          <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" Margin="0,3,0,0" Text="{Binding SizeText}" />
                                          <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" Opacity="0.92" FontSize="12" Margin="0,2,0,0" Text="{Binding TargetDateText}" />
                                          <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Text="{Binding SourceFileName}" />
                                          <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" Opacity="0.82" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="30" Text="{Binding PrimaryPath}" />
                                          <ComboBox DisplayMemberPath="Display" Margin="0,10,0,0" ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding SelectedCategory}" />
                                          <TextBlock Text="需要人工确认" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,6,0,0" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Button HorizontalAlignment="Left" Padding="16,8" Margin="0,4,0,0" Content="{Binding HiddenCount, StringFormat=继续显示更多（剩余 {0:N0} 张）}" Command="{Binding ShowMoreCommand}" Visibility="{Binding HasHiddenItems, Converter={StaticResource BoolToVis}}" />
