<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HanabePhotoManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:HanabePhotoManager.App.ViewModels" xmlns:navigation="clr-namespace:HanabePhotoManager.App.Navigation" xmlns:albums="clr-namespace:HanabePhotoManager.App.Albums" xmlns:cloud="clr-namespace:HanabePhotoManager.App.Cloud" xmlns:contest="clr-namespace:HanabePhotoManager.App.Contest" xmlns:map="clr-namespace:HanabePhotoManager.App.Map" xmlns:compress="clr-namespace:HanabePhotoManager.App.Compression" xmlns:watermark="clr-namespace:HanabePhotoManager.App.Watermark" xmlns:treemap="clr-namespace:HanabePhotoManager.App.Browsing.Treemap" xmlns:grid="clr-namespace:HanabePhotoManager.App.Browsing.Grid" xmlns:local="clr-namespace:HanabePhotoManager.App" xmlns:controls="clr-namespace:HanabePhotoManager.App.Controls" Title="Hanabe Photo Manager Alpha" Icon="Assets/HanabeApp.ico" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Background.Canvas}" FontFamily="{StaticResource Typography.FontFamily.UI}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Width="{Binding WindowWidth, Mode=TwoWay}" Height="{Binding WindowHeight, Mode=TwoWay}" KeyDown="MainWindow_KeyDown" KeyUp="MainWindow_KeyUp" SizeChanged="MainWindow_SizeChanged">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <local:CategoryEqualsConverter x:Key="CategoryEqualsConverter" />
      <local:CategoryEqualityMultiConverter x:Key="CategoryEqualityMultiConverter" />
      <local:ExtensionBadgeConverter x:Key="ExtensionBadgeConverter" />
      <local:NullToVisibilityConverter x:Key="NullToVis" />
      <local:PathThumbnailConverter x:Key="PathThumb" />
      <DataTemplate x:Key="SidebarFooterContentTemplate">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Viewbox x:Name="FooterNavigationIcon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Viewbox>
          <TextBlock x:Name="FooterNavigationLabel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding}" />
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Text">
            <Setter TargetName="FooterNavigationIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="FooterNavigationLabel" Property="Grid.Column" Value="0" /><Setter TargetName="FooterNavigationLabel" Property="Grid.ColumnSpan" Value="2" /><Setter TargetName="FooterNavigationLabel" Property="Margin" Value="0" />
          </DataTrigger>
          <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Icon">
            <Setter TargetName="FooterNavigationIcon" Property="Grid.ColumnSpan" Value="2" /><Setter TargetName="FooterNavigationIcon" Property="HorizontalAlignment" Value="Center" /><Setter TargetName="FooterNavigationLabel" Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" CornerRadius="{StaticResource Radius.Control}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="{DynamicResource Brush.Surface.Interactive}" />
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="{DynamicResource Brush.Surface.Selected}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                  <Setter TargetName="Chrome" Property="Border.BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DeviceCardButton" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="DeviceCardInteractionSurface"
                      CornerRadius="{StaticResource Radius.Card}"
                      Padding="{TemplateBinding Control.Padding}"
                      Background="{TemplateBinding Control.Background}"
                      BorderBrush="{TemplateBinding Control.BorderBrush}"
                      BorderThickness="{TemplateBinding Control.BorderThickness}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="DeviceCardInteractionSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                  <Setter TargetName="DeviceCardInteractionSurface" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="DeviceCardInteractionSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                  <Setter TargetName="DeviceCardInteractionSurface" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="DeviceCardInteractionSurface" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="13.6" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="Padding" Value="12,8" />
      </Style>
      <Style x:Key="PreviewSegmentButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="SegmentSurface" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource Brush.Surface.ContainerHigh}" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource Brush.Surface.Container}" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="SegmentSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                  <Setter TargetName="SegmentSurface" Property="BorderThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="True">
            <DataTrigger.Binding>
              <MultiBinding Converter="{StaticResource CategoryEqualityMultiConverter}">
                <Binding Path="PreviewRetouchFilter" />
                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
              </MultiBinding>
            </DataTrigger.Binding>
            <Setter Property="Background" Value="{DynamicResource Brush.SecondaryContainer}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Secondary}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSecondaryContainer}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PreviewSortItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
              <Border Name="ItemSurface" CornerRadius="10" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PreviewSortComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PreviewSortItem}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <Border Name="ComboSurface" CornerRadius="12" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
                <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Grid Background="Transparent">
                        <ContentPresenter Margin="13,0,38,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <Path Data="M1,1 L5,5 L9,1" Stroke="{DynamicResource Brush.Border.Strong}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                      </Grid>
                    </ControlTemplate>
                  </Control.Template>
                </ToggleButton>
                <Popup Name="PART_Popup" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                  <Border MinWidth="190" Margin="0,6,0,0" Padding="4" CornerRadius="14" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <UIElement.Effect>
                      <DropShadowEffect BlurRadius="24" ShadowDepth="8" Color="{DynamicResource Color.Background.Canvas}" Opacity="0.55" />
                    </UIElement.Effect>
                    <ScrollViewer MaxHeight="320" CanContentScroll="True">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ComboSurface" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                  <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                  <Setter TargetName="ComboSurface" Property="Border.BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.46" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="13.6" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="{x:Type TreeView}" TargetType="{x:Type TreeView}">
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="13.6" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="{x:Type TreeViewItem}" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="13.6" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="{x:Type Expander}" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="PreviewDateHeaderButton" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="DateSurface" CornerRadius="8" Padding="10,8" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="DateSurface" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="DateSurface" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PreviewItemContainer" TargetType="{x:Type ContentPresenter}">
        <Setter Property="UIElement.Opacity" Value="0" />
        <Setter Property="RenderTransform">
          <Setter.Value>
            <TranslateTransform Y="8" />
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Duration.Normal}" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="{StaticResource Motion.Duration.Normal}">
                  <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PageSurface" TargetType="{x:Type FrameworkElement}">
        <Setter Property="UIElement.Opacity" Value="1" />
        <Setter Property="RenderTransform">
          <Setter.Value>
            <TranslateTransform Y="0" />
          </Setter.Value>
        </Setter>
      </Style>
      <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type vm:LibraryDateNode}}" DataType="{x:Type vm:LibraryDateNode}" ItemsSource="{Binding Children}">
        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
      </HierarchicalDataTemplate>
      </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Style="{StaticResource Layout.Shell}">
    <Image Opacity="0.92" Source="{Binding EffectiveBackgroundImage}" Stretch="{Binding BackgroundImageStretch}" HorizontalAlignment="{Binding BackgroundImageHorizontalAlignment}" VerticalAlignment="{Binding BackgroundImageVerticalAlignment}" Visibility="{Binding HasEffectiveBackground, Converter={StaticResource BoolToVis}}" />
    <Rectangle Fill="{DynamicResource Brush.Background.Canvas}" Opacity="{Binding BackgroundOverlayOpacity}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Sidebar.Container}">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <Border Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center" CornerRadius="16" Background="{DynamicResource Brush.PrimaryContainer}" ClipToBounds="True">
              <Grid>
                <TextBlock Text="H" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.OnPrimaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Stretch="UniformToFill" Source="{Binding AppIconImage}" Visibility="{Binding HasCustomAppIcon, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </Border>
            <ItemsControl x:Name="PrimaryNavigationList"
                          ItemsSource="{Binding NavigationItems}"
                          AllowDrop="True"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Once"
                          Drop="PrimaryNavigationList_Drop">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type navigation:NavigationItemViewModel}">
                  <Button Tag="{Binding Key}"
                          Style="{StaticResource Navigation.RailItem}"
                          Command="{Binding Command}"
                          ToolTip="{Binding Label}"
                          AutomationProperties.Name="{Binding Label}"
                          PreviewMouseLeftButtonDown="PrimaryNavigationItem_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PrimaryNavigationItem_PreviewMouseMove">
                    <Grid>
                      <Border x:Name="NavSelectionSurface" CornerRadius="16" Background="{DynamicResource Brush.SecondaryContainer}" Opacity="0" IsHitTestVisible="False" />
                      <StackPanel>
                        <Border x:Name="NavIconSurface" Width="32" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                          <Viewbox x:Name="NavigationIcon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="NavigationIconPath" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                          </Viewbox>
                        </Border>
                        <TextBlock x:Name="NavigationLabel" Text="{Binding Label}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="72" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Text">
                        <Setter TargetName="NavigationIcon" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Icon">
                        <Setter TargetName="NavigationLabel" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Home"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Home}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Import"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Import}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Preview"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Library}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="CustomAlbums"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Library}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="FaceSearch"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.FaceSearch}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="MapPhotos"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Map}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Compression"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Compress}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Watermark"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Watermark}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Cloud"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Cloud}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="ContestOpen"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Import}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="ContestJudged"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Library}" /></DataTrigger>
                      <DataTrigger Value="True">
                        <DataTrigger.Binding>
                          <MultiBinding Converter="{StaticResource CategoryEqualityMultiConverter}">
                            <Binding Path="Key" />
                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}" />
                          </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter TargetName="NavIconSurface" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}" />
                        <Setter TargetName="NavigationIconPath" Property="Stroke" Value="{DynamicResource Brush.OnPrimaryContainer}" />
                        <Setter TargetName="NavigationLabel" Property="Foreground" Value="{DynamicResource Brush.OnSecondaryContainer}" />
                        <DataTrigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="NavSelectionSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Duration.Normal}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="NavSelectionSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Duration.Fast}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.ExitActions>
                      </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="ThemeToggleButton" AutomationProperties.Name="切换主题" Style="{StaticResource Navigation.RailItem}" Click="ToggleTheme_Click" ToolTip="切换明暗主题">
              <StackPanel>
