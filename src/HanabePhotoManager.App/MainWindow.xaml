                      <StackPanel>
                        <DockPanel>
                          <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource Brush.Surface.Subtle}" DockPanel.Dock="Left" Margin="0,0,12,0">
                            <TextBlock Text="夸" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="夸克网盘（主备份）" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.80" FontSize="12" Margin="0,2,0,0" Text="{Binding QuarkStatus}" />
                          </StackPanel>
                        </DockPanel>
                        <TextBlock Text="夸克网盘目前没有公开的官方网盘 API。本应用永远不会做截取 Cookie、扫码、验证码自动化、私有 API 反编译这类操作。请在夸克官方客户端或网页登录后手动上传/下载。" Opacity="0.78" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                          <Button Content="🌐 打开夸克网盘官网" Command="{Binding OpenQuarkOfficialCommand}" />
                        </StackPanel>
                        <TextBlock Text="💡 提示：你说你桌面上有一个夸克文件 —— 选下面按钮，定位到它（或夸克客户端 exe）" Opacity="0.80" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,6" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox VerticalAlignment="Center" FontSize="12" Text="{Binding QuarkClientPath}" />
                          <Button Grid.Column="1" Content="📁 选择…" Margin="6,0,0,0" Click="BrowseQuarkClient_Click" />
                          <Button Grid.Column="2" Content="🚀 启动夸克" Margin="6,0,0,0" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" Click="LaunchQuarkClient_Click" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border CornerRadius="14" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
                      <StackPanel>
                        <DockPanel>
                          <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource Brush.Surface.Subtle}" DockPanel.Dock="Left" Margin="0,0,12,0">
                            <TextBlock Text="百" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                              <TextBlock Text="百度网盘（OAuth 授权）" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding IsBaiduAuthorized}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                      <Setter Property="Text" Value="未连接" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding IsBaiduAuthorized}">
                                          <Setter Property="Text" Value="已连接" />
                                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                </TextBlock>
                              </Border>
                            </DockPanel>
                            <TextBlock Opacity="0.80" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding BaiduStatus}" />
                          </StackPanel>
                        </DockPanel>
                        <TextBlock Text="AppKey" Opacity="0.86" Margin="0,14,0,4" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox ToolTip="在 https://pan.baidu.com/union/console 创建一个网盘应用即可获得" Text="{Binding BaiduAppKey, UpdateSourceTrigger=PropertyChanged}" />
                          <Button Grid.Column="1" Content="开发者控制台" Margin="10,0,0,0" Command="{Binding OpenBaiduConsoleCommand}" />
                        </Grid>
                        <TextBlock Text="AppSecret" Opacity="0.86" Margin="0,12,0,4" />
                        <PasswordBox Name="BaiduAppSecretBox" ToolTip="凭据使用 Windows DPAPI 加密后保存" PasswordChanged="BaiduAppSecretBox_PasswordChanged" />
                        <TextBlock Text="⚠ AppSecret 仅本机加密保存；不写入日志、不上传服务器。" Opacity="0.66" FontSize="11" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                          <Button Content="保存凭据" Command="{Binding SaveBaiduCredentialsCommand}" />
                          <Button Content="🔑 打开授权页" Margin="8,0,0,0" Command="{Binding StartBaiduAuthorizationCommand}" />
                        </StackPanel>
                        <TextBlock Text="授权码（从百度授权页复制）" Opacity="0.86" Margin="0,14,0,4" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox Text="{Binding BaiduAuthCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsBaiduAuthorized, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                          <Button Grid.Column="1" Content="完成授权" Margin="10,0,0,0" Command="{Binding CompleteBaiduAuthorizationCommand}" />
                        </Grid>
                        <TextBlock Text="授权码是一次性的；如过期只需再次点「打开授权页」即可。刷新令牌由 Hanabe 加密保存，过期前自动续期。" Opacity="0.66" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Button Content="退出登录并清除本机会话" Margin="0,14,0,0" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" Command="{Binding DisconnectBaiduCommand}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card.Default}" Padding="18">
                  <StackPanel>
                    <TextBlock Text="存储" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock FontWeight="SemiBold" Margin="0,12,0,0" Text="{Binding SelectedFolderSize}" />
                    <TextBlock Opacity="0.88" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding SelectedFolderPercent}" />
                    <TextBlock Text="当前照片库" Opacity="0.86" Margin="0,14,0,4" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding LibraryRoot}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
