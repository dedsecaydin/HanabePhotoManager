                <Button x:Name="AgentAskButton" HorizontalAlignment="Right" Width="34" Height="30" Margin="0,0,5,0" Padding="0" Style="{StaticResource Button.Ghost}" Click="AgentAsk_Click" ToolTip="问 AI 助手（Ctrl+Enter）" AutomationProperties.Name="问 AI 助手">
