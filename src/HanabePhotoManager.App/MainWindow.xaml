                    <TextBlock FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding SelectedDateTitle}" />
                    <Border Margin="14,0,0,0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Padding="10,5" VerticalAlignment="Center">
                      <TextBlock Opacity="0.88" FontSize="{StaticResource Typography.Caption}" Text="{Binding PreviewSummaryText}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              </Expander>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" LastChildFill="True">
                  <StackPanel x:Name="BrowseSidebarThumbnailControls" DockPanel.Dock="Bottom" Width="250" Margin="0,10,14,4">
