      <Style x:Key="{x:Type TreeView}" TargetType="{x:Type TreeView}">
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body}" />
