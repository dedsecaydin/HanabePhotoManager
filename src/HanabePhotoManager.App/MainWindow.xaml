                                <Border Width="92" Height="92" CornerRadius="13" Background="{DynamicResource Brush.Surface.Subtle}" ClipToBounds="True">
                                  <Grid>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Opacity="0.88" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Extension}" />
                                    <Rectangle RadiusX="13" RadiusY="13">
