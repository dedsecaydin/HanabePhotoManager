                                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.Surface.ContainerHigh}" />
                                <Setter TargetName="BubbleText" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
