              <StackPanel>
                <Border Width="32" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                  <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Theme}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                </Border>
                <TextBlock x:Name="ThemeToggleLabel" Text="深色" FontSize="{StaticResource Typography.Caption}" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
              </StackPanel>
            </Button>
            <Button AutomationProperties.Name="设置" Command="{Binding ShowSettingsCommand}" ToolTip="设置">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Navigation.RailItem}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                      <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel>
                <Border Width="32" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                  <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Settings}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                </Border>
                <TextBlock Text="设置" FontSize="{StaticResource Typography.Caption}" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
              </StackPanel>
            </Button>
            <TextBlock Text="●" FontSize="{StaticResource Typography.BodySmall}" HorizontalAlignment="Center" Margin="0,8,0,4">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsBusy}">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </StackPanel>
          <ScrollViewer Style="{StaticResource Sidebar.NavigationScroller}" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
            <Grid x:Name="PrimaryNavigationHost" SizeChanged="PrimaryNavigationHost_SizeChanged">
              <Border x:Name="PrimaryNavigationSelectionIndicator"
                      Width="84"
                      Height="52"
                      CornerRadius="16"
                      Background="{DynamicResource Brush.Surface.Selected}"
                      BorderThickness="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Opacity="0"
                      IsHitTestVisible="False">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="PrimaryNavigationSelectionTransform" />
                </Border.RenderTransform>
              </Border>
            <ItemsControl x:Name="PrimaryNavigationList"
                          ItemsSource="{Binding NavigationItems}"
                          AllowDrop="True"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          KeyboardNavigation.TabNavigation="Once"
                          Drop="PrimaryNavigationList_Drop">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type navigation:NavigationItemViewModel}">
                  <Button Tag="{Binding Key}"
                          Style="{StaticResource Navigation.RailItem}"
                          Command="{Binding Command}"
                          ToolTip="{Binding Label}"
                          AutomationProperties.Name="{Binding Label}"
                          PreviewMouseLeftButtonDown="PrimaryNavigationItem_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PrimaryNavigationItem_PreviewMouseMove">
                    <Grid>
                      <StackPanel>
                        <Border x:Name="NavIconSurface" Width="32" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                          <Viewbox x:Name="NavigationIcon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="NavigationIconPath" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                          </Viewbox>
                        </Border>
                        <TextBlock x:Name="NavigationLabel" Text="{Binding Label}" FontSize="{StaticResource Typography.Caption}" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="88" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Text">
                        <Setter TargetName="NavigationIcon" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding DataContext.NavigationDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Icon">
                        <Setter TargetName="NavigationLabel" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Home"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Home}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Import"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Import}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Preview"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Library}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="CustomAlbums"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Album}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="FaceSearch"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.FaceSearch}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="MapPhotos"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Map}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Compression"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Compress}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Key}" Value="Watermark"><Setter TargetName="NavigationIconPath" Property="Data" Value="{StaticResource Icon.Watermark}" /></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="1">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Layout.Workspace}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                <Setter Property="Padding" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Background="Transparent" x:Name="TopBarSurface" PreviewMouseLeftButtonDown="TopBarSurface_PreviewMouseLeftButtonDown" Margin="4,8,8,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <!-- 一体化标题栏窗口控制按钮（Memory Diary 风格）：最小化/最大化/关闭 -->
              <Button Style="{StaticResource Window.CaptionButton}" Click="WindowMinimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                <Path Data="{StaticResource Icon.WindowMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
              </Button>
              <Button x:Name="WindowMaximizeButton" Style="{StaticResource Window.CaptionButton}" Click="WindowMaximize_Click" ToolTip="最大化" AutomationProperties.Name="最大化">
                <Grid>
                  <Path x:Name="WindowMaximizeGlyph" Data="{StaticResource Icon.WindowMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
                  <Path x:Name="WindowRestoreGlyph" Data="{StaticResource Icon.WindowRestore}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed" />
                </Grid>
              </Button>
              <Button Style="{StaticResource Window.CaptionCloseButton}" Click="WindowClose_Click" ToolTip="关闭" AutomationProperties.Name="关闭">
                <Path Data="{StaticResource Icon.X}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
              </Button>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Style="{StaticResource Layout.StatusBar}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center"
                         Text="{Binding StatusMessage}"
                         Foreground="{DynamicResource Brush.Text.Secondary}"
                         FontSize="{StaticResource Typography.Caption}"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProgressLabel}" Margin="0,0,10,0"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontSize="{StaticResource Typography.Caption}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Width="160" Height="{StaticResource Spacing.6}" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
                <TextBlock Margin="10,0,0,0" Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontSize="{StaticResource Typography.Caption}" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid Margin="24,8,24,8">
            <Border Name="HomePage" Style="{StaticResource PageSurface}" Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource Layout.PagePanel}" Padding="24,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                <DockPanel Margin="0,0,0,20">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择库根目录" Command="{Binding BrowseLibraryCommand}" />
                    <Button Content="刷新" Command="{Binding RefreshLibraryCommand}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Layout.PageTitle}" Text="{Binding PageTitle}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" Text="{Binding PageSubtitle}" />
                  </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Layout.HomeSummary}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" Text="{Binding LibraryRoot}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding LibraryHealthText}" FontWeight="SemiBold" />
                      <TextBlock Margin="14,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding DiscoveredDateCount, StringFormat={}{0} 个日期}" />
                      <TextBlock Margin="14,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding PreviewFiles.Count, StringFormat={}{0} 个媒体文件}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource Layout.HomeSection}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                      <TextBlock Text="最近照片" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" />
                      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Text="{Binding HomePreviewFiles.Count, StringFormat={}{0} 张}" />
                    </DockPanel>
                    <ItemsControl ItemContainerStyle="{StaticResource PreviewItemContainer}" ItemsSource="{Binding HomePreviewFiles}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PreviewFileViewModel}">
                          <Border Width="140" Height="134" Margin="0,0,12,12" Padding="6" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <StackPanel>
                              <Border Width="128" Height="96" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Subtle}" ClipToBounds="True">
