                            <ItemsControl ItemsSource="{Binding SelectedDeviceContents}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceContentItemViewModel}">
                                  <Border Margin="0,0,0,8" Padding="12" CornerRadius="16" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
