                  <Ellipse x:Name="TaskCenterBadge" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource Brush.Primary}" Stroke="{DynamicResource Brush.Surface.Default}" StrokeThickness="1.5" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
