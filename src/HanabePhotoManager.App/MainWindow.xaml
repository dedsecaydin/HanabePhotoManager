                        <Button Content="扫描重复" Padding="10,5" Margin="6,0,0,0" Command="{Binding DataContext.ScanLibraryDuplicatesCommand, RelativeSource={RelativeSource AncestorType=Expander}}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding DataContext.IsDuplicateScanRunning, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BoolToVis}}">
                          <ProgressBar Width="100" Height="6" IsIndeterminate="True" />
                          <TextBlock Text="{Binding DataContext.ProgressLabel, RelativeSource={RelativeSource AncestorType=Expander}}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="浏览条件" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DataContext.BrowseConditionsSummary, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{StaticResource Typography.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
