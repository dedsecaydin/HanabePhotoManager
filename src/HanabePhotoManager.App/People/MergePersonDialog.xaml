<Window x:Class="HanabePhotoManager.App.People.MergePersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HanabePhotoManager.App.ViewModels"
        Title="合并到人物"
        Width="480"
        Height="540"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource Dialog.Window}">
  <Border Margin="16" Style="{StaticResource Dialog.Surface}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="合并到人物" Style="{StaticResource Dialog.Title}" Margin="0,0,0,8" />
      <TextBlock Grid.Row="1"
                 Text="当前人物的照片与脸谱将并入所选人物，当前人物随后被删除。"
                 Style="{StaticResource Dialog.Body}"
                 Margin="0,0,0,16" />

      <ListBox Name="TargetList"
               Grid.Row="2"
               SelectionMode="Single"
               Padding="0"
               Style="{StaticResource List.Default}"
               ItemContainerStyle="{StaticResource ListItem.Default}"
               MouseDoubleClick="TargetList_MouseDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PersonAlbumItemViewModel}">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PhotoCount, StringFormat={}{0} 张照片}"
                         Foreground="{DynamicResource Brush.Text.Secondary}"
                         FontSize="{StaticResource Typography.Caption}"
                         Margin="0,3,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="取消" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" />
        <Button Content="合并" Style="{StaticResource Button.Primary}" Click="Ok_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
