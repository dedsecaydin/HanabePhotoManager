<Window x:Class="HanabePhotoManager.App.PhotoViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="照片查看器" Width="1500" Height="920" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Viewer.Canvas}" FontFamily="{StaticResource Typography.FontFamily.UI}" ResizeMode="CanResizeWithGrip" PreviewKeyDown="Window_PreviewKeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
    <Grid Background="{DynamicResource Brush.Viewer.Canvas}">
      <ScrollViewer x:Name="PhotoViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Cursor="Hand" PreviewMouseWheel="PhotoViewport_PreviewMouseWheel" PreviewMouseLeftButtonDown="PhotoViewport_PreviewMouseLeftButtonDown" PreviewMouseMove="PhotoViewport_PreviewMouseMove" PreviewMouseLeftButtonUp="PhotoViewport_PreviewMouseLeftButtonUp" LostMouseCapture="PhotoViewport_LostMouseCapture">
        <Image Source="{Binding Image}" Stretch="Uniform" Margin="28" Width="{Binding ActualWidth, ElementName=PhotoViewport}" Height="{Binding ActualHeight, ElementName=PhotoViewport}"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/></Image.LayoutTransform></Image>
      </ScrollViewer>
      <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18" Width="44" Height="44" Content="‹" Style="{StaticResource Button.Secondary}" Command="{Binding PreviousCommand}"/>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18" Width="44" Height="44" Content="›" Style="{StaticResource Button.Secondary}" Command="{Binding NextCommand}"/>
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20" Padding="12,6" CornerRadius="8" Background="{DynamicResource Brush.Surface.Elevated}"><TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource Brush.Text.Primary}"/></Border>
    </Grid>
    <Border Grid.Column="1" Padding="24" Background="{DynamicResource Brush.Surface.Default}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1,0,0,0">
      <DockPanel><Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="关闭  Esc" Style="{StaticResource Button.Toolbar}" Click="Close_Click"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"><StackPanel>
          <TextBlock Text="{Binding Metadata.Name}" FontSize="{StaticResource Typography.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Metadata.Extension}" Margin="0,5,0,18" Foreground="{DynamicResource Brush.Text.Secondary}"/>
          <TextBlock Text="评分" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="1" Style="{StaticResource Button.Toolbar}" Command="{Binding SetRatingCommand}" CommandParameter="1"/><Button Content="2" Style="{StaticResource Button.Toolbar}" Command="{Binding SetRatingCommand}" CommandParameter="2"/><Button Content="3" Style="{StaticResource Button.Toolbar}" Command="{Binding SetRatingCommand}" CommandParameter="3"/><Button Content="4" Style="{StaticResource Button.Toolbar}" Command="{Binding SetRatingCommand}" CommandParameter="4"/><Button Content="5" Style="{StaticResource Button.Toolbar}" Command="{Binding SetRatingCommand}" CommandParameter="5"/></StackPanel>
          <TextBlock Text="{Binding Rating, StringFormat=当前评分 {0} / 5}" Margin="0,0,0,12"/><Button Content="移入回收站  Delete" Style="{StaticResource Button.Danger}" Click="Delete_Click" Margin="0,0,0,12"/><TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="文件信息" Style="{StaticResource Layout.SectionTitle}" Margin="0,0,0,8"/><TextBlock Text="{Binding Metadata.FileSize, StringFormat=大小  {0}}" Margin="0,5"/><TextBlock Text="{Binding Metadata.Dimensions, StringFormat=分辨率  {0}}" Margin="0,5"/><TextBlock Text="{Binding Metadata.TakenAt, StringFormat=拍摄时间  {0}}" Margin="0,5" TextWrapping="Wrap"/><Separator Margin="0,15"/>
          <TextBlock Text="拍摄参数" Style="{StaticResource Layout.SectionTitle}" Margin="0,0,0,8"/><TextBlock Text="{Binding Metadata.Iso, StringFormat=ISO  {0}}" Margin="0,5"/><TextBlock Text="{Binding Metadata.Aperture, StringFormat=光圈  {0}}" Margin="0,5"/><TextBlock Text="{Binding Metadata.Shutter, StringFormat=快门  {0}}" Margin="0,5"/><TextBlock Text="{Binding Metadata.FocalLength, StringFormat=焦距  {0}}" Margin="0,5"/><Separator Margin="0,15"/>
          <TextBlock Text="设备与位置" Style="{StaticResource Layout.SectionTitle}" Margin="0,0,0,8"/><TextBlock Text="{Binding Metadata.Camera, StringFormat=相机  {0}}" Margin="0,5" TextWrapping="Wrap"/><TextBlock Text="{Binding Metadata.Lens, StringFormat=镜头  {0}}" Margin="0,5" TextWrapping="Wrap"/><TextBlock Text="{Binding Metadata.Location, StringFormat=位置  {0}}" Margin="0,5" TextWrapping="Wrap"/>
          <TextBlock Margin="0,20,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" Text="方向键切换照片 · Delete 移入回收站" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
