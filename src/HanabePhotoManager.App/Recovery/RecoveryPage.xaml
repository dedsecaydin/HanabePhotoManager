<UserControl x:Class="HanabePhotoManager.App.Recovery.RecoveryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:recovery="clr-namespace:HanabePhotoManager.Core.Recovery;assembly=HanabePhotoManager.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="RecoveryVisibility" />
    <Style TargetType="{x:Type DatePickerTextBox}" BasedOn="{StaticResource Input.TextBox}" />
  </UserControl.Resources>
  <Border Style="{StaticResource Layout.PagePanel}" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="相机照片与视频恢复助手" Style="{StaticResource Layout.PageTitle}"/><TextBlock Text="选择镜像，按写入时间查找照片与视频，再检查证据并导出。" Style="{StaticResource Status.Description}" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Row="1">
      <Border Style="{StaticResource Card.Subtle}" Margin="0,16,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="01  镜像来源" Style="{StaticResource Layout.SectionTitle}"/><TextBlock Text="照片 JPG / ARW / CR2 / CR3 / NEF / DNG · 视频 MP4 · 打开 .img / .raw 镜像" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,5,0,0"/><TextBlock Text="{Binding ImagePath}" ToolTip="{Binding ImagePath}" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" FontFamily="{StaticResource Typography.FontFamily.Mono}"/></StackPanel>
          <Button Grid.Column="1" Content="打开镜像" Command="{Binding ChooseImageCommand}" VerticalAlignment="Center" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0"/>
        </Grid>
      </Border>
      <StackPanel IsEnabled="{Binding CanEditScanOptions}" Margin="0,0,0,16">
        <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="开始扫描" Command="{Binding ScanCommand}" Style="{StaticResource Button.Primary}"/><StackPanel><TextBlock Text="02  查找范围" Style="{StaticResource Layout.SectionTitle}"/><CheckBox Content="按写入日期时间快速扫描" IsChecked="{Binding UseWriteTimeRange}" Margin="0,8,0,0"/></StackPanel></DockPanel>
        <Grid Visibility="{Binding UseWriteTimeRange, Converter={StaticResource RecoveryVisibility}}" Margin="0,12,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="开始时间" Style="{StaticResource Status.Description}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <DatePicker SelectedDate="{Binding WrittenFromDate}" SelectedDateFormat="Short" Width="174" Height="40" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource Brush.Surface.Default}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" ToolTip="选择开始日期"/>
            <TextBox Text="{Binding WrittenFromClock, UpdateSourceTrigger=PropertyChanged}" Width="128" Height="40" Margin="8,0,0,0" Style="{StaticResource Input.TextBox}" HorizontalContentAlignment="Center" ToolTip="时:分:秒，例如 09:30:00"/>
          </StackPanel></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="结束时间" Style="{StaticResource Status.Description}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <DatePicker SelectedDate="{Binding WrittenToDate}" SelectedDateFormat="Short" Width="174" Height="40" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource Brush.Surface.Default}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" ToolTip="选择结束日期"/>
            <TextBox Text="{Binding WrittenToClock, UpdateSourceTrigger=PropertyChanged}" Width="128" Height="40" Margin="8,0,0,0" Style="{StaticResource Input.TextBox}" HorizontalContentAlignment="Center" ToolTip="时:分:秒，例如 18:00:00"/>
          </StackPanel></StackPanel>
          <CheckBox Grid.Column="4" Content="保留时间未知的文件" IsChecked="{Binding IncludeUnknownTime}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </Grid>
        <TextBlock Text="开启后按卡内最后写入时间定位；关闭后完整扫描。目录记录已丢失的文件需要完整扫描。" Style="{StaticResource Status.Description}" TextWrapping="Wrap" />
        <TextBlock Text="原卡与镜像只读 · 实验候选不会自动恢复" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,0" />
      </StackPanel>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card.Default}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="停止任务" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource RecoveryVisibility}}" Style="{StaticResource Button.Ghost}"/><StackPanel><TextBlock Text="恢复候选" Style="{StaticResource Layout.SectionTitle}"/><TextBlock Text="{Binding CandidateSummary}" Style="{StaticResource Status.Description}" /></StackPanel></DockPanel>
          <StackPanel Grid.Row="1" Margin="0,10,0,12"><ProgressBar Visibility="{Binding IsBusy, Converter={StaticResource RecoveryVisibility}}" Height="6" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"/><TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Row="2" Visibility="{Binding ShowEmptyState, Converter={StaticResource RecoveryVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"><TextBlock Text="在这里查看找到的照片与视频" Style="{StaticResource Layout.SectionTitle}" TextAlignment="Center"/><TextBlock Text="{Binding EmptyStateText}" Margin="0,16,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
          <ListBox Grid.Row="2" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type recovery:RecoveryCandidate}">
                <Border Style="{StaticResource Card.Subtle}" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding ExpectedFileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding TimeDescription}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}">
                        <Run Text="{Binding SizeDescription}"/>
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding StatusDescription}" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Right"/>
                      <TextBlock Margin="16,5,0,0" Foreground="{DynamicResource Brush.Text.Secondary}">
                        <Run Text="选中查看结构证据"/>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid></Border>
        <Border Grid.Column="2" Style="{StaticResource Inspector.Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="候选证据与导出" Style="{StaticResource Inspector.Header}"/>
          <TextBlock Text="{Binding FileSystemSummary}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
          <TextBlock Text="{Binding SelectedCandidate.ExpectedFileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <Image Source="{Binding PreviewImage}" MaxHeight="240" Stretch="Uniform"/>
          <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Status.Description}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CandidateEvidence}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,16"/>
          <Button Content="导出所选候选" Command="{Binding RecoverCommand}" Style="{StaticResource Button.Primary}"/>
          <TextBlock Text="输出包括媒体副本、原始候选和 SHA-256 报告，至少需要候选大小两倍的可用空间。请在原存储卡以外的位置保存。" Style="{StaticResource Status.Description}" TextWrapping="Wrap" Margin="0,8,0,16"/>
          <Button Content="打开 / 播放上次恢复文件" Command="{Binding OpenRecoveredFileCommand}" Style="{StaticResource Button.Secondary}"/>
          <Button Content="打开上次输出目录" Command="{Binding OpenOutputCommand}" Style="{StaticResource Button.Secondary}" />
        </StackPanel></ScrollViewer></Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
