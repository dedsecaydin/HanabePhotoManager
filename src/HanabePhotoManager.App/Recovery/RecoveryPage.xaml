<UserControl x:Class="HanabePhotoManager.App.Recovery.RecoveryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:recovery="clr-namespace:HanabePhotoManager.Core.Recovery;assembly=HanabePhotoManager.Core">
  <Border Style="{StaticResource Layout.PagePanel}" Padding="16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="相机视频安全恢复助手" Style="{StaticResource Layout.PageTitle}"/><TextBlock Text="从 Sony 相机卡的只读镜像中寻找并安全导出异常或缺失的 XAVC MP4。" Style="{StaticResource Status.Description}" Margin="0,6,0,0"/></StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card.Subtle}" Margin="0,16,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="安全保证" FontWeight="SemiBold"/><TextBlock Text="原卡与镜像只读 · 不运行 CHKDSK · 不修改 FAT、位图或目录 · 实验候选不会自动恢复" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,5,0,0"/><TextBlock Text="{Binding ImagePath}" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" FontFamily="{StaticResource Typography.FontFamily.Mono}"/></StackPanel>
          <Button Grid.Column="1" Content="打开镜像" Command="{Binding ChooseImageCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0"/>
          <Button Grid.Column="2" Content="开始扫描" Command="{Binding ScanCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"/>
        </Grid>
      </Border>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card.Default}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="恢复候选" Style="{StaticResource Layout.SectionTitle}"/><Button DockPanel.Dock="Right" Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource Button.Ghost}"/></DockPanel>
          <StackPanel Grid.Row="1" Margin="0,10,0,12"><ProgressBar Height="6" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"/><TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/></StackPanel>
          <ListBox Grid.Row="2" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type recovery:RecoveryCandidate}">
                <Border Style="{StaticResource Card.Subtle}" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding ExpectedFileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}">
                        <Run Text="偏移 "/><Run Text="{Binding StartOffset}"/><Run Text=" · "/><Run Text="{Binding Confidence}"/>
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Right"/>
                      <TextBlock Margin="16,5,0,0" Foreground="{DynamicResource Brush.Text.Secondary}">
                        <Run Text="ftyp "/><Run Text="{Binding HasFtyp}"/><Run Text=" · mdat "/><Run Text="{Binding HasMdat}"/>
                        <Run Text=" · moov "/><Run Text="{Binding HasMoov}"/><Run Text=" · 样本表 "/><Run Text="{Binding HasSampleTables}"/>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid></Border>
        <Border Grid.Column="2" Style="{StaticResource Inspector.Panel}"><StackPanel><TextBlock Text="证据" Style="{StaticResource Inspector.Header}"/><TextBlock Text="{Binding FileSystemSummary}" Margin="0,8,0,14" Foreground="{DynamicResource Brush.Text.Secondary}"/><TextBlock Text="{Binding SelectedCandidate.ExpectedFileName}" FontWeight="SemiBold"/><TextBlock Text="只允许 ftyp、mdat、moov 与 sample tables 完整且非碎片候选直接恢复。其他候选标记为 EXPERIMENTAL，仅展示证据。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,16"/><Button Content="安全恢复所选候选" Command="{Binding RecoverCommand}" Style="{StaticResource Button.Primary}"/></StackPanel></Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
