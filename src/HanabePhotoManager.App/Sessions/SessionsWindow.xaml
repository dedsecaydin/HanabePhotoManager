<Window x:Class="HanabePhotoManager.App.Sessions.SessionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="素材管理 · 拍摄场次" Width="1080" Height="720" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Background.Canvas}" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{DynamicResource Typography.FontFamily.UI}">
 <DockPanel Margin="{DynamicResource Spacing.IconButton}">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="拍摄场次" FontSize="{DynamicResource Typography.TitleSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
   <TextBlock Text="读取 EXIF 原始拍摄时间 · 只保存虚拟分组 · 不移动、不改写原片" Margin="{DynamicResource Spacing.Row.Vertical.8}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
   <WrapPanel Margin="{DynamicResource Spacing.Stack.8}">
    <TextBlock Text="间隔阈值（分钟）" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}"/>
    <TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding ThresholdMinutes, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="{DynamicResource Spacing.Inline.8}"/>
    <Button Content="检测当前素材" Command="{Binding DetectCommand}" Style="{DynamicResource Button.Secondary}"/>
    <Button Content="取消读取" Command="{Binding CancelCommand}" Style="{DynamicResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline.8}"/>
    <TextBlock Text="成员排序" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}"/>
    <ComboBox Style="{DynamicResource Input.ComboBox}" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding Sort}" Width="90" Margin="{DynamicResource Spacing.Inline.8}"/>
   </WrapPanel>
   <WrapPanel Margin="{DynamicResource Spacing.Stack.8}"><TextBlock Text="相机时间修正" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}"/><ComboBox Style="{DynamicResource Input.ComboBox}" ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera}" Width="250" Margin="{DynamicResource Spacing.Inline.8}"/><TextBox Style="{DynamicResource Input.TextBox}" Text="{Binding CorrectionMinutes}" Width="65"/><TextBlock Text=" 分钟 " Foreground="{DynamicResource Brush.Text.Primary}"/><Button Content="设置修正" Command="{Binding CorrectCameraCommand}" Style="{DynamicResource Button.Secondary}"/></WrapPanel>
   <ProgressBar Value="{Binding Progress}" Maximum="100" Height="{DynamicResource Spacing.4}"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="{DynamicResource Spacing.Stack.8}">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}" Margin="{DynamicResource Spacing.Stack.8}"/>
   <WrapPanel><Button Content="按拍摄顺序在所选成员前分段" Command="{Binding SplitCommand}" Style="{DynamicResource Button.Secondary}"/><Button Content="合并下一场 / 删除边界" Command="{Binding MergeCommand}" Style="{DynamicResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline.8}"/><Button Content="提交虚拟场次" Command="{Binding CommitCommand}" Style="{DynamicResource Button.Primary}"/><Button Content="撤销最近提交" Command="{Binding UndoCommand}" Style="{DynamicResource Button.Secondary}" Margin="{DynamicResource Spacing.Inline.8}"/></WrapPanel>
  </StackPanel>
  <Grid Margin="{DynamicResource Spacing.Stack.8}"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Background="{DynamicResource Brush.Surface.Default}" Foreground="{DynamicResource Brush.Text.Primary}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="{DynamicResource Spacing.Control}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Range}"/><TextBlock Text="{Binding Count, StringFormat=成员：{0}}"/><TextBlock Text="{Binding NeedsReview, StringFormat=需确认时钟或元数据：{0}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <ListView VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Grid.Column="2" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" Background="{DynamicResource Brush.Surface.Default}" Foreground="{DynamicResource Brush.Text.Primary}"><ListView.View><GridView><GridViewColumn Header="文件" DisplayMemberBinding="{Binding Name}" Width="180"/><GridViewColumn Header="原始拍摄时间" DisplayMemberBinding="{Binding LocalTime}" Width="150"/><GridViewColumn Header="修正后时间" DisplayMemberBinding="{Binding EffectiveTime}" Width="160"/><GridViewColumn Header="时区偏移" DisplayMemberBinding="{Binding UtcOffset}" Width="80"/><GridViewColumn Header="相机 / 问题" DisplayMemberBinding="{Binding Camera}" Width="160"/><GridViewColumn Header="问题" DisplayMemberBinding="{Binding Issue}" Width="200"/></GridView></ListView.View></ListView>
  </Grid>
 </DockPanel>
</Window>
