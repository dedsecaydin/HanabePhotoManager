<UserControl x:Class="HanabePhotoManager.App.SettingsCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:navigation="clr-namespace:HanabePhotoManager.App.Navigation"
    Loaded="SettingsCenterPage_Loaded">
  <Grid Background="{DynamicResource Brush.Background.Canvas}">
    <TabControl TabStripPlacement="Left" Style="{StaticResource Navigation.SettingsTabs}">
      <TabItem Header="常规" Style="{StaticResource Navigation.SettingsTabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="880" Margin="44,20,44,60">
            <TextBlock Text="常规" Style="{StaticResource Layout.PageTitle}"/>
            <TextBlock Text="控制应用启动方式与窗口恢复。修改会即时保存。" Style="{StaticResource Layout.SettingsHint}"/>
            <TextBlock Text="启动与窗口" Style="{StaticResource Layout.SectionTitle}" Margin="0,14,0,8"/>
            <CheckBox Content="开机自启动" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" Margin="0,8"/>
            <TextBlock Text="写入 Windows 当前用户启动项；失败时会回滚并显示错误。" Style="{StaticResource Layout.SettingsHint}"/>
            <CheckBox Content="恢复上次窗口状态" IsChecked="{Binding RestoreWindowState, Mode=TwoWay}" Margin="0,8"/>
            <TextBlock Text="恢复宽度、高度、位置和最大化状态；不可见位置会自动校正到当前屏幕。" Style="{StaticResource Layout.SettingsHint}"/>
            <TextBlock Text="{Binding WindowStateSummary}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="照片库与导入" Style="{StaticResource Navigation.SettingsTabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="880" Margin="44,20,44,60">
            <TextBlock Text="照片库与导入" Style="{StaticResource Layout.PageTitle}"/>
            <TextBlock Text="管理唯一的照片库根目录；导入任务参数仍留在导入页面。" Style="{StaticResource Layout.SettingsHint}"/>
            <TextBlock Text="照片库" Style="{StaticResource Layout.SectionTitle}" Margin="0,14,0,8"/>
            <TextBox Text="{Binding LibraryRoot}" IsReadOnly="True" Style="{StaticResource Input.TextBox}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="更改照片库" Command="{Binding BrowseLibraryCommand}" Style="{StaticResource Button.Secondary}"/><TextBlock Text="{Binding LibraryHealthText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}"/></StackPanel>
            <TextBlock Text="{Binding LibraryCapacityText}" Style="{StaticResource Layout.SettingsHint}"/>
            <Separator Margin="0,10"/>
            <TextBlock Text="扫描与导入" Style="{StaticResource Layout.SectionTitle}"/>
            <TextBlock Text="应用启动时会验证已配置的照片库；有效时后台扫描。当前没有可配置的扫描开关。" Style="{StaticResource Layout.SettingsHint}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="浏览与 AI" Style="{StaticResource Navigation.SettingsTabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="880" Margin="44,20,44,60">
            <TextBlock Text="浏览与 AI" Style="{StaticResource Layout.PageTitle}"/>
            <TextBlock Text="这里的默认值不会被当前浏览会话覆盖。" Style="{StaticResource Layout.SettingsHint}"/>
            <TextBlock Text="浏览默认值" Style="{StaticResource Layout.SectionTitle}" Margin="0,14,0,8"/>
            <TextBlock Text="默认评分筛选" Style="{StaticResource Layout.SettingsFieldLabel}"/><ComboBox Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding RatingFilters}" SelectedItem="{Binding DefaultRatingFilter, Mode=TwoWay}"/>
            <TextBlock Text="默认排序" Style="{StaticResource Layout.SettingsFieldLabel}" Margin="0,14,0,8"/><ComboBox Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding PreviewSortChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding DefaultPreviewSort, Mode=TwoWay}"/>
            <TextBlock Text="浏览进入恢复策略" Style="{StaticResource Layout.SettingsFieldLabel}" Margin="0,14,0,8"/><ComboBox Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding BrowseEntryModes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding BrowseEntryModeSetting, Mode=TwoWay}"/>
            <TextBlock Text="全局默认缩略图尺寸" Style="{StaticResource Layout.SettingsFieldLabel}" Margin="0,14,0,8"/><Slider Minimum="96" Maximum="260" Value="{Binding DefaultThumbnailSize, Mode=TwoWay}"/>
            <Separator Margin="0,22,0,10"/>
            <TextBlock Text="AI 识别" Style="{StaticResource Layout.SectionTitle}"/>
            <TextBlock Text="默认识别引擎" Style="{StaticResource Layout.SettingsFieldLabel}"/><ComboBox Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding PhotoAnalysis.Engines}" SelectedItem="{Binding PhotoAnalysis.SelectedEngine, Mode=TwoWay}"/>
            <TextBlock Text="语义标签数量" Style="{StaticResource Layout.SettingsFieldLabel}" Margin="0,14,0,8"/><ComboBox Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding SemanticLabelCounts}" SelectedItem="{Binding SemanticMaxLabels, Mode=TwoWay}"/>
            <TextBlock Text="相似度窗口" Style="{StaticResource Layout.SettingsFieldLabel}" Margin="0,14,0,8"/><Slider Minimum="0.02" Maximum="0.30" Value="{Binding SemanticSimilarityWindow, Mode=TwoWay}"/>
            <TextBlock Text="语义参数仅对支持语义标签的引擎生效。人物识别继续在人物页面手动触发。" Style="{StaticResource Layout.SettingsHint}" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="云盘与项目" Style="{StaticResource Navigation.SettingsTabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="880" Margin="44,20,44,60">
            <TextBlock Text="云盘与项目" Style="{StaticResource Layout.PageTitle}"/>
            <TextBlock Text="百度凭据使用 Windows 本机加密；夸克仅提供官方客户端入口。" Style="{StaticResource Layout.SettingsHint}"/>
            <TextBlock Text="百度网盘" Style="{StaticResource Layout.SectionTitle}" Margin="0,14,0,8"/>
            <TextBlock Text="AppKey" Style="{StaticResource Layout.SettingsFieldLabel}"/><TextBox Text="{Binding BaiduAppKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
            <TextBlock Text="AppSecret" Style="{StaticResource Layout.SettingsFieldLabel}" Margin="0,14,0,8"/><TextBox Text="{Binding BaiduAppSecret, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="保存凭据" Command="{Binding SaveBaiduCredentialsCommand}" Style="{StaticResource Button.Secondary}"/><Button Content="授权" Command="{Binding StartBaiduAuthorizationCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"/><Button Content="断开连接" Command="{Binding DisconnectBaiduCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"/></StackPanel>
            <TextBlock Text="{Binding BaiduStatus}" Style="{StaticResource Layout.SettingsHint}"/>
            <Separator Margin="0,10"/>
            <TextBlock Text="夸克" Style="{StaticResource Layout.SectionTitle}"/>
            <TextBlock Text="官方客户端位置" Style="{StaticResource Layout.SettingsFieldLabel}"/><TextBox Text="{Binding QuarkClientPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="打开官网" Command="{Binding OpenQuarkOfficialCommand}" Style="{StaticResource Button.Secondary}"/></StackPanel>
            <TextBlock Text="当前没有官方 API 集成，不显示连接或自动备份状态。" Style="{StaticResource Layout.SettingsHint}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="外观" Style="{StaticResource Navigation.SettingsTabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="880" Margin="44,20,44,60">
            <TextBlock Text="外观" Style="{StaticResource Layout.PageTitle}"/>
            <TextBlock Text="主题、导航、背景和材质效果均由统一设计 Token 驱动。" Style="{StaticResource Layout.SettingsHint}"/>
            <Border Style="{StaticResource Layout.SettingsGroup}">
              <StackPanel>
                <TextBlock Text="主题" Style="{StaticResource Layout.SectionTitle}"/>
                <TextBlock Text="立即切换应用的明暗主题。" Style="{StaticResource Layout.SettingsHint}" Margin="0,4,0,12"/>
                <StackPanel Orientation="Horizontal"><Button Content="浅色" Click="LightTheme_Click" Style="{StaticResource Button.Secondary}"/><Button Content="深色" Click="DarkTheme_Click" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"/></StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Layout.SettingsGroup}">
              <StackPanel>
                <TextBlock Text="导航菜单" Style="{StaticResource Layout.SectionTitle}"/>
                <TextBlock Text="选择一级菜单显示文字、图标，或两者同时显示。" Style="{StaticResource Layout.SettingsHint}" Margin="0,4,0,12"/>
                <Border Style="{StaticResource Navigation.Segment}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TextNavigationRadio" Content="文字" Tag="{x:Static navigation:NavigationDisplayMode.Text}" GroupName="NavigationDisplayMode" Checked="NavigationDisplayMode_Checked" Style="{StaticResource Navigation.SegmentItem}" AutomationProperties.Name="文字菜单"/>
                    <RadioButton x:Name="IconNavigationRadio" Content="图标" Tag="{x:Static navigation:NavigationDisplayMode.Icon}" GroupName="NavigationDisplayMode" Checked="NavigationDisplayMode_Checked" Style="{StaticResource Navigation.SegmentItem}" AutomationProperties.Name="图标菜单"/>
                    <RadioButton x:Name="IconAndTextNavigationRadio" Content="图标和文字" Tag="{x:Static navigation:NavigationDisplayMode.IconAndText}" GroupName="NavigationDisplayMode" Checked="NavigationDisplayMode_Checked" Style="{StaticResource Navigation.SegmentItem}" AutomationProperties.Name="图标和文字菜单"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Layout.SettingsGroup}">
              <StackPanel>
                <TextBlock Text="背景与材质" Style="{StaticResource Layout.SectionTitle}"/>
                <TextBlock Text="背景来源、显示方式、玻璃强度和相关操作集中在此处。" Style="{StaticResource Layout.SettingsHint}" Margin="0,4,0,16"/>
                <TextBlock Text="背景来源" Style="{StaticResource Layout.SettingsFieldLabel}"/><ComboBox Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding BackgroundMode, Mode=TwoWay}"/>
                <TextBlock Text="背景显示方式" Style="{StaticResource Layout.SettingsFieldLabel}" Margin="0,12,0,6"/><ComboBox Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding BackgroundImageLayouts}" SelectedItem="{Binding BackgroundImageLayout, Mode=TwoWay}"/>
                <TextBlock Text="玻璃强度" Style="{StaticResource Layout.SettingsFieldLabel}" Margin="0,12,0,6"/><Slider Width="360" HorizontalAlignment="Left" Minimum="0.25" Maximum="0.95" Value="{Binding GlassIntensity, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="选择自定义背景" Command="{Binding ChooseBackgroundCommand}" Style="{StaticResource Button.Secondary}"/><Button Content="清除背景" Command="{Binding ClearBackgroundCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"/></StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Layout.SettingsGroup}">
              <StackPanel>
                <TextBlock Text="应用窗口图标" Style="{StaticResource Layout.SectionTitle}"/>
                <TextBlock Text="仅影响应用窗口当前可用的图标范围，不会替换 exe 的全部品牌资源。" Style="{StaticResource Layout.SettingsHint}" Margin="0,4,0,12"/>
                <StackPanel Orientation="Horizontal"><Button Content="选择图标" Command="{Binding ChooseAppIconCommand}" Style="{StaticResource Button.Secondary}"/><Button Content="清除图标" Command="{Binding ClearAppIconCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"/></StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="高级" Style="{StaticResource Navigation.SettingsTabItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="880" Margin="44,20,44,60">
            <TextBlock Text="高级" Style="{StaticResource Layout.PageTitle}"/>
            <TextBlock Text="性能、存储位置、诊断、安全与快捷键参考。" Style="{StaticResource Layout.SettingsHint}"/>
            <TextBlock Text="性能" Style="{StaticResource Layout.SectionTitle}" Margin="0,14,0,8"/>
            <TextBlock Text="推理设备" Style="{StaticResource Layout.SettingsFieldLabel}"/><ComboBox Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding InferenceDevices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding InferenceDevice, Mode=TwoWay}"/>
            <TextBlock Text="{Binding InferenceProviderStatus}" Style="{StaticResource Layout.SettingsHint}" Margin="0,8,0,0"/>
            <TextBlock Text="存储与诊断" Style="{StaticResource Layout.SectionTitle}" Margin="0,14,0,8"/>
            <TextBlock Text="settings.json、主题、元数据、人物相册、地图缓存与云会话均位于当前 Windows 用户的本机应用数据目录。第一期只读展示，不提供清理、迁移或修改路径。" Style="{StaticResource Layout.SettingsHint}"/>
            <TextBlock Text="快捷键" Style="{StaticResource Layout.SectionTitle}" Margin="0,14,0,8"/>
            <TextBlock Text="Ctrl + 鼠标滚轮：调整当前会话缩略图尺寸&#x0a;Delete：删除所选照片（始终确认并进入 Windows 回收站）&#x0a;Esc：关闭当前浮层或取消操作" Style="{StaticResource Layout.SettingsHint}"/>
            <TextBlock Text="安全与隐私" Style="{StaticResource Layout.SectionTitle}" Margin="0,14,0,8"/>
            <TextBlock Text="云凭据使用本地加密；本地 AI 在设备上运行。删除确认始终启用且不可关闭。" Style="{StaticResource Layout.SettingsHint}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
