<StackPanel x:Name="ImportSection" Visibility="Collapsed"><TextBlock Text="导入" Style="{StaticResource Layout.PageTitle}" /><TextBlock Text="从插卡到落盘之间的规则。本次来源、日期和复制 / 移动方式在导入页确认。" Style="{StaticResource Layout.SettingsHint}" Margin="0,4,0,6" /><TextBlock Text="插卡与提醒" Style="{StaticResource Settings.GroupHeader}" /><Border Style="{StaticResource Settings.Card}"><StackPanel><DockPanel Style="{StaticResource Settings.Row}"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Settings.Toggle}" IsChecked="{Binding PromptOnMediaDevice, Mode=TwoWay}" AutomationProperties.Name="检测存储卡并提示导入" /><StackPanel Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="检测存储卡并提示导入" Style="{StaticResource Settings.RowTitle}" /><TextBlock Text="应用运行时检查可移动磁盘中的照片与视频，同次插入只提醒一次。" Style="{StaticResource Settings.RowDesc}" Margin="0,3,0,0" /></StackPanel></DockPanel><Border Style="{StaticResource Settings.RowDivider}" /><DockPanel Style="{StaticResource Settings.Row}"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Settings.Toggle}" IsChecked="{Binding PromptImportResumeAtStartup, Mode=TwoWay}" AutomationProperties.Name="启动时提示继续未完成导入" /><StackPanel Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="启动时提示继续未完成导入" Style="{StaticResource Settings.RowTitle}" /><TextBlock Text="关闭后不再弹出启动询问，仍可从导入页继续。安全停止会保留已完成文件和恢复点；移动模式始终先校验、保存凭据，再删除来源。" Style="{StaticResource Settings.RowDesc}" Margin="0,3,0,0" /></StackPanel></DockPanel></StackPanel></Border><TextBlock Text="导入时查重" Style="{StaticResource Settings.GroupHeader}" /><Border Style="{StaticResource Settings.Card}"><StackPanel><DockPanel Style="{StaticResource Settings.Row}"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Settings.Toggle}" IsChecked="{Binding CheckDuplicatesOnImport, Mode=TwoWay}" ToolTip="开启后对每个文件只查其目标日期文件夹（LibraryRoot\日期目录）里已有的照片，做 SHA-256 哈希比对，发现重复时弹窗让你决定跳过还是保留；不扫描整个图库。" AutomationProperties.Name="导入时检查重复开关" /><StackPanel Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="导入时检查重复" Style="{StaticResource Settings.RowTitle}" /><TextBlock Text="只查目标日期文件夹里是否已有相同照片（不扫描整个图库），有重复才弹窗确认。关闭后直接导入。" Style="{StaticResource Settings.RowDesc}" Margin="0,3,0,0" /></StackPanel></DockPanel><Border Style="{StaticResource Settings.RowDivider}" /><DockPanel Style="{StaticResource Settings.Row}"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Settings.Toggle}" IsChecked="{Binding RestoreWindowAfterDuplicateDetection, Mode=TwoWay}" AutomationProperties.Name="重复检测完成后唤回主窗口" /><StackPanel Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="重复检测完成后唤回窗口" Style="{StaticResource Settings.RowTitle}" /><TextBlock Text="主窗口最小化时，检测到需要处理的重复项会自动恢复并显示确认窗口。" Style="{StaticResource Settings.RowDesc}" Margin="0,3,0,0" /></StackPanel></DockPanel></StackPanel></Border><TextBlock Text="导入规则" Style="{StaticResource Settings.GroupHeader}" x:Name="ImportRoutingOverviewSection" /><Border Style="{StaticResource Settings.Card}" Padding="20,16">
