<UserControl x:Class="HanabePhotoManager.App.SettingsCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:navigation="clr-namespace:HanabePhotoManager.App.Navigation"
    xmlns:services="clr-namespace:HanabePhotoManager.App.Services"
    Loaded="SettingsCenterPage_Loaded"
    Foreground="{DynamicResource Brush.OnSurface}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="Settings.GroupHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource Typography.Caption}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Settings.Group" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLow}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="Settings.RowTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource Typography.Body}" />
    </Style>
    <Style x:Key="Settings.RowDesc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
      <Setter Property="FontSize" Value="{StaticResource Typography.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Settings.Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
    </Style>
    <Style x:Key="Settings.SectionNavItem" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Radius.Control}" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ThemeCard" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLowest}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="{StaticResource Radius.Dialog}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Brush.Background.Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <!-- 左：设置分区导航 -->
    <Border Grid.Column="0" Style="{StaticResource Inspector.Panel}">
      <ListBox x:Name="SectionNavList" Style="{StaticResource List.Default}" ItemContainerStyle="{StaticResource Settings.SectionNavItem}" SelectionChanged="SectionNav_SelectionChanged">
        <ListBoxItem Tag="appearance"><TextBlock Text="外观" FontWeight="SemiBold" /></ListBoxItem>
        <ListBoxItem Tag="general"><TextBlock Text="常规" FontWeight="SemiBold" /></ListBoxItem>
        <ListBoxItem Tag="library"><TextBlock Text="照片库与导入" FontWeight="SemiBold" /></ListBoxItem>
        <ListBoxItem Tag="browse"><TextBlock Text="浏览与 AI" FontWeight="SemiBold" /></ListBoxItem>
        <ListBoxItem Tag="advanced"><TextBlock Text="高级" FontWeight="SemiBold" /></ListBoxItem>
      </ListBox>
    </Border>

    <!-- 右：设置内容（分组列表） -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="4,0,4,0">

        <!-- ─────── 外观 ─────── -->
        <StackPanel x:Name="AppearanceSection">
          <TextBlock Text="外观" Style="{StaticResource Layout.PageTitle}" />
          <TextBlock Text="主题、导航、背景和材质效果均由统一设计 Token 驱动；点击色卡立即全局换肤（本页即实时预览）。" Style="{StaticResource Layout.SettingsHint}" />

          <Grid Margin="0,12,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="主题 · 6 套" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

              <Button x:Name="ThemeCardDynamicLight" Grid.Row="0" Grid.Column="0" Tag="Dynamic.Light" Click="ThemeCard_Click" Style="{StaticResource ThemeCard}">
                <Grid>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Dynamic.Light.Primary}" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Dynamic.Light.Secondary}" Margin="4,0,0,0" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Dynamic.Light.Tertiary}" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="经典黑白" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" Margin="0,8,0,0" />
                    <TextBlock Text="浅色" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                  </StackPanel>
                  <Border x:Name="ThemeCheckDynamicLight" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="✓" Foreground="{DynamicResource Brush.OnPrimary}" FontSize="{StaticResource Typography.Caption}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="ThemeCardDynamicDark" Grid.Row="0" Grid.Column="2" Tag="Dynamic.Dark" Click="ThemeCard_Click" Style="{StaticResource ThemeCard}">
                <Grid>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Dynamic.Dark.Primary}" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Dynamic.Dark.Secondary}" Margin="4,0,0,0" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Dynamic.Dark.Tertiary}" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="经典黑白" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" Margin="0,8,0,0" />
                    <TextBlock Text="深色" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                  </StackPanel>
                  <Border x:Name="ThemeCheckDynamicDark" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="✓" Foreground="{DynamicResource Brush.OnPrimary}" FontSize="{StaticResource Typography.Caption}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="ThemeCardForestLight" Grid.Row="0" Grid.Column="4" Tag="Forest.Light" Click="ThemeCard_Click" Style="{StaticResource ThemeCard}">
                <Grid>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Forest.Light.Primary}" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Forest.Light.Secondary}" Margin="4,0,0,0" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Forest.Light.Tertiary}" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="森林绿" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" Margin="0,8,0,0" />
                    <TextBlock Text="浅色" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                  </StackPanel>
                  <Border x:Name="ThemeCheckForestLight" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="✓" Foreground="{DynamicResource Brush.OnPrimary}" FontSize="{StaticResource Typography.Caption}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="ThemeCardForestDark" Grid.Row="2" Grid.Column="0" Tag="Forest.Dark" Click="ThemeCard_Click" Style="{StaticResource ThemeCard}">
                <Grid>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Forest.Dark.Primary}" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Forest.Dark.Secondary}" Margin="4,0,0,0" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Forest.Dark.Tertiary}" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="森林绿" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" Margin="0,8,0,0" />
                    <TextBlock Text="深色" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                  </StackPanel>
                  <Border x:Name="ThemeCheckForestDark" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="✓" Foreground="{DynamicResource Brush.OnPrimary}" FontSize="{StaticResource Typography.Caption}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="ThemeCardVioletLight" Grid.Row="2" Grid.Column="2" Tag="Violet.Light" Click="ThemeCard_Click" Style="{StaticResource ThemeCard}">
                <Grid>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Violet.Light.Primary}" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Violet.Light.Secondary}" Margin="4,0,0,0" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Violet.Light.Tertiary}" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="紫罗兰" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" Margin="0,8,0,0" />
                    <TextBlock Text="浅色" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                  </StackPanel>
                  <Border x:Name="ThemeCheckVioletLight" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="✓" Foreground="{DynamicResource Brush.OnPrimary}" FontSize="{StaticResource Typography.Caption}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="ThemeCardVioletDark" Grid.Row="2" Grid.Column="4" Tag="Violet.Dark" Click="ThemeCard_Click" Style="{StaticResource ThemeCard}">
                <Grid>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Violet.Dark.Primary}" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Violet.Dark.Secondary}" Margin="4,0,0,0" /><Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Brush.ThemeSwatch.Violet.Dark.Tertiary}" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="紫罗兰" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" Margin="0,8,0,0" />
                    <TextBlock Text="深色" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                  </StackPanel>
                  <Border x:Name="ThemeCheckVioletDark" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Brush.Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="✓" Foreground="{DynamicResource Brush.OnPrimary}" FontSize="{StaticResource Typography.Caption}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
            </Grid>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="导航菜单" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="一级菜单显示" Style="{StaticResource Settings.RowTitle}" />
                <TextBlock Text="选择侧栏导航显示文字、图标，或两者同时显示。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource Navigation.Segment}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="TextNavigationRadio" Content="文字" Tag="{x:Static navigation:NavigationDisplayMode.Text}" GroupName="NavigationDisplayMode" Checked="NavigationDisplayMode_Checked" Style="{StaticResource Navigation.SegmentItem}" AutomationProperties.Name="文字菜单" />
                  <RadioButton x:Name="IconNavigationRadio" Content="图标" Tag="{x:Static navigation:NavigationDisplayMode.Icon}" GroupName="NavigationDisplayMode" Checked="NavigationDisplayMode_Checked" Style="{StaticResource Navigation.SegmentItem}" AutomationProperties.Name="图标菜单" />
                  <RadioButton x:Name="IconAndTextNavigationRadio" Content="图标和文字" Tag="{x:Static navigation:NavigationDisplayMode.IconAndText}" GroupName="NavigationDisplayMode" Checked="NavigationDisplayMode_Checked" Style="{StaticResource Navigation.SegmentItem}" AutomationProperties.Name="图标和文字菜单" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="背景与材质" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="背景来源" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="跟随主题 / 自定义图片 / 纯色。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding BackgroundMode, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="背景显示方式" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="填充 / 居中 / 保持长宽比 / 拉伸。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding BackgroundImageLayouts}" SelectedItem="{Binding BackgroundImageLayout, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="玻璃强度" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="背景模糊与半透明程度。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <Slider Grid.Column="1" Width="200" VerticalAlignment="Center" Minimum="0.25" Maximum="0.95" Value="{Binding GlassIntensity, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="亚克力材质" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="启用系统级亚克力背景模糊（DWM）。关闭后使用半透明降级方案。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsAcrylicEnabled, Mode=TwoWay}"
                          ToolTip="使用 Windows DWM 原生亚克力/模糊背景（性能最佳，Windows 11 优先；Windows 10 自动降级为系统亚克力，再不支持则使用应用内半透明玻璃）。"
                          AutomationProperties.Name="亚克力材质开关" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="自定义背景" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="选择本地图片作为窗口背景。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="选择自定义背景" Style="{StaticResource Button.Secondary}" Command="{Binding ChooseBackgroundCommand}" />
                  <Button Content="清除背景" Style="{StaticResource Button.Secondary}" Command="{Binding ClearBackgroundCommand}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="应用窗口图标" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="窗口图标" Style="{StaticResource Settings.RowTitle}" />
                <TextBlock Text="仅影响应用窗口当前可用的图标范围，不替换 exe 全部品牌资源。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="选择图标" Style="{StaticResource Button.Secondary}" Command="{Binding ChooseAppIconCommand}" />
                <Button Content="清除图标" Style="{StaticResource Button.Secondary}" Command="{Binding ClearAppIconCommand}" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ─────── 常规 ─────── -->
        <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
          <TextBlock Text="常规" Style="{StaticResource Layout.PageTitle}" />
          <TextBlock Text="控制应用启动方式与窗口恢复。修改会即时保存。" Style="{StaticResource Layout.SettingsHint}" />

          <Grid Margin="0,12,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="启动与窗口" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="开机自启动" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="写入 Windows 当前用户启动项；失败时自动回滚并提示。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="恢复上次窗口状态" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="恢复宽度、高度、位置和最大化状态；不可见位置自动校正。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding RestoreWindowState, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <TextBlock Text="{Binding WindowStateSummary}" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
            </StackPanel>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="新手指南" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="重新查看新手指南" Style="{StaticResource Settings.RowTitle}" />
                <TextBlock Text="照片库、导入、AI、人物识别和批处理工具的使用方法。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="再次查看新手指南" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center" Command="{Binding ReplayOnboardingCommand}" />
            </Grid>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="版本与更新日志" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <TextBlock Text="版本树" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" />
                <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerHigh}">
                  <TextBlock Text="{Binding ReleaseNotes.CurrentVersionLabel}" FontSize="{StaticResource Typography.BodySmall}" FontWeight="SemiBold" />
                </Border>
              </DockPanel>
              <Grid MinHeight="250">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="ReleaseVersionTree" BorderThickness="0" Background="Transparent" ItemsSource="{Binding ReleaseNotes.Versions}" SelectedItem="{Binding ReleaseNotes.SelectedVersion, Mode=TwoWay}" AutomationProperties.Name="版本更新树">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BranchGlyph}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Version}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding DateText}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="7,2" CornerRadius="8" Background="{DynamicResource Brush.Surface.ContainerHigh}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="1" Background="{DynamicResource Brush.OutlineVariant}" />
                <DockPanel Grid.Column="2" Margin="18,0,0,0">
                  <TextBlock DockPanel.Dock="Top" Text="{Binding ReleaseNotes.SelectedReleaseTitle}" FontSize="{StaticResource Typography.TitleSmall}" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <ScrollViewer x:Name="ReleaseNotesScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="250">
                    <TextBlock Text="{Binding ReleaseNotes.SelectedReleaseNotes}" TextWrapping="Wrap" LineHeight="24" Foreground="{DynamicResource Brush.Text.Secondary}" />
                  </ScrollViewer>
                </DockPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ─────── 照片库与导入 ─────── -->
        <StackPanel x:Name="LibrarySection" Visibility="Collapsed">
          <TextBlock Text="照片库与导入" Style="{StaticResource Layout.PageTitle}" />
          <TextBlock Text="管理唯一的照片库根目录；导入任务参数仍留在导入页面。" Style="{StaticResource Layout.SettingsHint}" />

          <Grid Margin="0,12,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="照片库" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <TextBlock Text="照片库根目录" Style="{StaticResource Settings.RowTitle}" />
              <TextBlock Text="所有照片按 月\日期\类别 组织；修改后应用会重新扫描。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,10" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding LibraryRoot}" IsReadOnly="True" Style="{StaticResource Input.TextBox}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="更改照片库" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center" Command="{Binding BrowseLibraryCommand}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LibraryHealthText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DiscoveredDateCount, StringFormat= · {0} 个日期}" Margin="10,0,0,0" Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
              </StackPanel>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="导入时检查重复" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="开启后检查目标日期文件夹里是否已有相同照片（不扫描整个图库），有重复才弹窗确认。关闭后直接导入。"
                             Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CheckDuplicatesOnImport, Mode=TwoWay}"
                          ToolTip="开启后对每个文件只查其目标日期文件夹（LibraryRoot\日期目录）里已有的照片，做 SHA-256 哈希比对，发现重复时弹窗让你决定跳过还是保留；不扫描整个图库。"
                          AutomationProperties.Name="导入时检查重复开关" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="扫描与索引" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <TextBlock Text="扫描重复内容" Style="{StaticResource Settings.RowTitle}" />
              <TextBlock Text="对整个图库做两层检测：① 文件哈希（SHA-256）找出完全相同的副本；② 视觉指纹进一步比对画面/内容相似的图片（如重压缩、改尺寸、二次截图等），并支持逐组勾选删除。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,10" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="扫描重复" Style="{StaticResource Button.Primary}" Command="{Binding ScanLibraryDuplicatesCommand}" AutomationProperties.Name="扫描重复内容" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding IsDuplicateScanRunning, Converter={StaticResource BoolToVis}}">
                  <ProgressBar Width="140" Height="6" IsIndeterminate="True" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ProgressLabel}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Typography.BodySmall}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="功能说明位置" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <TextBlock Text="筛选字段标签位置" Style="{StaticResource Settings.RowTitle}" />
              <TextBlock Text="照片图库筛选面板里「分类 / 修图状态 / 评分分类」等字段标签统一放在控件上方或左侧。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,10" />
              <ComboBox Style="{StaticResource Input.SettingsComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding FeatureDescriptionPosition, Mode=TwoWay}">
                <ComboBoxItem Content="标签在上" Tag="Top" />
                <ComboBoxItem Content="标签在左" Tag="Left" />
              </ComboBox>
            </StackPanel>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="图库分组标题" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="文件夹标题显示" Style="{StaticResource Settings.RowTitle}" />
                <TextBlock Text="选择解析日期、磁盘文件夹名，或同时显示两者。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,20,0" />
              </StackPanel>
              <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding GalleryGroupTitleMode, Mode=TwoWay}">
                <ComboBoxItem Content="解析后的日期标题" Tag="ParsedDate" />
                <ComboBoxItem Content="实际文件夹名称" Tag="FolderName" />
                <ComboBoxItem Content="日期标题 + 文件夹名称" Tag="ParsedDateAndFolderName" />
              </ComboBox>
            </Grid>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="自定义导入格式" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <TextBlock Text="自定义 RAW 后缀" Style="{StaticResource Settings.RowTitle}" />
              <TextBlock Text="内置 RAW（ARW / CR2 / CR3 / NEF / RAF / RW2 / ORF / DNG / RAW）之外的格式，用逗号或空格分隔，例如 R3D、IIQ。保存后会自动记住。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,6" />
              <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding CustomRawExtensionsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自定义RAW后缀" />
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <TextBlock Text="自定义视频后缀" Style="{StaticResource Settings.RowTitle}" />
              <TextBlock Text="内置视频（MP4 / MOV / MXF / MTS / M2TS / AVI / MKV / WMV / M4V / WEBM / MPEG / MPG / 3GP / FLV 等）之外的格式，用逗号或空格分隔，例如 BRAW。保存后会自动记住。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,6" />
              <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding CustomVideoExtensionsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自定义视频后缀" />
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <TextBlock Text="导入文件命名模板" Style="{StaticResource Settings.RowTitle}" />
              <TextBlock Text="占位符：{seq} 序号（4 位）、{seq:N} 指定位数序号、{orig} 原文件名、{date} 日期。例如 JK{seq} 生成 JK0001、JK0002。保存后自动记住并复用。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,6" />
              <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding ImportNamingTemplate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="导入命名模板" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="BrowseSection" Visibility="Collapsed">
          <TextBlock Text="浏览与 AI" Style="{StaticResource Layout.PageTitle}" />
          <TextBlock Text="这里的默认值不会被当前浏览会话覆盖。" Style="{StaticResource Layout.SettingsHint}" />

          <Grid Margin="0,12,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="浏览默认值" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="默认评分筛选" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="进入浏览页时应用的评分下限。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding RatingFilters}" SelectedItem="{Binding DefaultRatingFilter, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="默认排序" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="照片墙初始排列方式。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding PreviewSortChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding DefaultPreviewSort, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="浏览进入恢复策略" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="打开浏览页时回到上次位置或首页。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding BrowseEntryModes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding BrowseEntryModeSetting, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="全局默认缩略图尺寸" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="新会话照片墙的缩略图基准尺寸。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <Slider Grid.Column="1" Width="200" VerticalAlignment="Center" Minimum="96" Maximum="260" Value="{Binding DefaultThumbnailSize, Mode=TwoWay}" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="AI 识别" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="默认识别引擎" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="本地 Chinese-CLIP · ONNX Runtime · 照片不出本机。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding PhotoAnalysis.Engines}" SelectedItem="{Binding PhotoAnalysis.SelectedEngine, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="语义标签数量" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="每张照片生成多少个语义标签。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding SemanticLabelCounts}" SelectedItem="{Binding SemanticMaxLabels, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="相似度窗口" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="语义搜索结果判定为「相似」的阈值窗口。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <Slider Grid.Column="1" Width="200" VerticalAlignment="Center" Minimum="0.02" Maximum="0.30" Value="{Binding SemanticSimilarityWindow, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <TextBlock Text="语义参数仅对支持语义标签的引擎生效；人物识别继续在人物页面手动触发。" Style="{StaticResource Settings.RowDesc}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ─────── 高级 ─────── -->
        <StackPanel x:Name="AdvancedSection" Visibility="Collapsed">
          <TextBlock Text="高级" Style="{StaticResource Layout.PageTitle}" />
          <TextBlock Text="性能、存储位置、诊断、安全与快捷键参考。" Style="{StaticResource Layout.SettingsHint}" />

          <Grid Margin="0,12,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="性能" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="推理设备" Style="{StaticResource Settings.RowTitle}" />
                <TextBlock Text="{Binding InferenceProviderStatus}" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding InferenceDevices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding InferenceDevice, Mode=TwoWay}" />
            </Grid>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="人脸识别" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="识别引擎" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="人物页扫描与按脸查找共用此设置。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding FaceRecognitionEngines}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FaceRecognitionEngine, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="性能模式" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="快速（更省时） / 精准（更高召回）。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Input.SettingsComboBox}" ItemsSource="{Binding FaceRecognitionProfiles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FaceRecognitionProfile, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <TextBlock Text="ArcFace 检测器 ONNX 路径" Style="{StaticResource Settings.RowTitle}" />
              <TextBlock Text="需自行提供模型；许可须允许在本应用中使用。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,6" />
              <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding ArcFaceDetectorModelPath, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="ArcFace R100 识别器 ONNX 路径" Style="{StaticResource Settings.RowTitle}" Margin="0,12,0,0" />
              <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding ArcFaceRecognizerModelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="匹配阈值（ArcFace 默认 0.45）" Style="{StaticResource Settings.RowTitle}" />
                  <TextBlock Text="高于阈值判定为同一人；越严格误报越少。" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" />
                </StackPanel>
                <Slider Grid.Column="1" Width="200" VerticalAlignment="Center" Minimum="0.2" Maximum="0.9" Value="{Binding ArcFaceMatchThreshold, Mode=TwoWay}" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
              <CheckBox Content="我确认模型由我提供，且许可允许在本应用中使用" IsChecked="{Binding ArcFaceModelLicenseConfirmed, Mode=TwoWay}" Margin="0,0,0,8" />
              <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding ArcFaceModelLicenseDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="填写模型来源或许可说明" />
              <TextBlock Text="{Binding ArcFaceAvailabilityReason}" Style="{StaticResource Settings.RowDesc}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="存储与诊断" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <TextBlock Text="settings.json、主题、元数据、人物相册、地图缓存与云会话均位于当前 Windows 用户的本机应用数据目录。第一期只读展示，不提供清理、迁移或修改路径。" Style="{StaticResource Settings.RowDesc}" />
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="快捷键" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <TextBlock Style="{StaticResource Settings.RowDesc}" Text="浏览页&#x0a;· Ctrl+F 聚焦搜索 · Ctrl+A 全选 · Ctrl+1..9 切换导航页面&#x0a;· Enter 打开选中照片 · Delete 删除所选（确认后进回收站）&#x0a;· Esc 清除选择 · S 循环评分 · 0-5 直接评分 · Ctrl+滚轮 缩放缩略图&#x0a;&#x0a;照片查看器（双击照片打开）&#x0a;· ←/→ 或 ↑/↓ 切换照片 · F11 全屏 · Esc 退出全屏 / 关闭&#x0a;· 空格 播放/暂停 · Shift+←/→ 快退/快进 10 秒 · [ / ] 降低/提高倍速（视频）&#x0a;· 1-5 评分 · Delete 移入回收站 · 滚轮 缩放 · 双击 适应窗口&#x0a;&#x0a;树图浏览（树状模式）&#x0a;· Ctrl+滚轮 缩放 · 空格+拖拽 平移 · Enter 打开选中项&#x0a;&#x0a;对话框&#x0a;· Esc 取消 / 关闭（删除确认、设置等）" />
          </Border>

          <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="安全与隐私" Style="{StaticResource Settings.GroupHeader}" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.OutlineVariant}" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
          <Border Style="{StaticResource Settings.Group}">
            <TextBlock Text="云凭据使用本地加密；本地 AI 在设备上运行。删除确认始终启用且不可关闭。" Style="{StaticResource Settings.RowDesc}" />
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- 右：Inspector（主题实时预览 + 数据与存储 + 关于） -->
    <Border Grid.Column="4" Style="{StaticResource Inspector.Panel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="当前主题" Style="{StaticResource Inspector.SectionLabel}" />
          <Border Margin="0,8,0,0" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Primary}" />
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Secondary}" Margin="6,0,0,0" />
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Tertiary}" Margin="6,0,0,0" />
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.PrimaryContainer}" Margin="6,0,0,0" />
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.TertiaryContainer}" Margin="6,0,0,0" />
                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Surface}" Margin="6,0,0,0" />
              </StackPanel>
              <TextBlock x:Name="CurrentThemeTag" Text="动态色彩 · 浅色" FontWeight="SemiBold" FontSize="{StaticResource Typography.BodySmall}" Margin="0,10,0,0" />
              <!-- 窗口迷你预览（随 Token 实时变化） -->
              <Border Margin="0,10,0,0" Padding="8" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface.Dim}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
                <Grid Height="96">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource Brush.Surface.ContainerLowest}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                      <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Brush.Surface.ContainerHigh}" />
                      <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Brush.PrimaryContainer}" Margin="0,4,0,0" />
                      <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Brush.Surface.ContainerHigh}" Margin="0,4,0,0" />
                      <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Brush.Surface.ContainerHigh}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="16" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource Brush.Surface.ContainerLow}" />
                    <Grid Grid.Row="2">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                      <Border Grid.Row="0" Grid.Column="0" CornerRadius="4" Background="{DynamicResource Brush.PrimaryContainer}" />
                      <Border Grid.Row="0" Grid.Column="2" CornerRadius="4" Background="{DynamicResource Brush.SecondaryContainer}" />
                      <Border Grid.Row="0" Grid.Column="4" CornerRadius="4" Background="{DynamicResource Brush.TertiaryContainer}" />
                      <Border Grid.Row="2" Grid.Column="0" CornerRadius="4" Background="{DynamicResource Brush.PrimaryContainer}" Opacity="0.75" />
                      <Border Grid.Row="2" Grid.Column="2" CornerRadius="4" Background="{DynamicResource Brush.Surface.Container}" />
                      <Border Grid.Row="2" Grid.Column="4" CornerRadius="4" Background="{DynamicResource Brush.SecondaryContainer}" Opacity="0.8" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
              <TextBlock Text="点击左侧色卡即可全局换肤 —— 本预览随 Token 实时变化。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <TextBlock Text="数据与存储" Style="{StaticResource Inspector.SectionLabel}" Margin="0,20,0,0" />
          <Border Margin="0,8,0,0" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="设置目录" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                <TextBlock Grid.Column="1" Text="{x:Static services:AppDataPaths.Root}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,8" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="照片库" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                <TextBlock Grid.Column="1" Text="{Binding LibraryHealthText}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}" TextAlignment="Right" Margin="10,0,0,0" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,8" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="已发现日期" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                <TextBlock Grid.Column="1" Text="{Binding DiscoveredDateCount, StringFormat={}{0} 个}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}" TextAlignment="Right" Margin="10,0,0,0" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="关于" Style="{StaticResource Inspector.SectionLabel}" Margin="0,20,0,0" />
          <Border Margin="0,8,0,0" Padding="12" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Surface.ContainerLowest}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="版本" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                <TextBlock Grid.Column="1" Text="{Binding ReleaseNotes.CurrentVersionLabel}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}" TextAlignment="Right" Margin="10,0,0,0" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,8" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="构建" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                <TextBlock Grid.Column="1" Text="net8.0-windows" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}" TextAlignment="Right" Margin="10,0,0,0" />
              </Grid>
              <Border Style="{StaticResource Settings.Divider}" Margin="0,8" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="许可" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" />
                <TextBlock Grid.Column="1" Text="个人使用" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}" TextAlignment="Right" Margin="10,0,0,0" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 支持作者（微信赞赏码） -->
          <Border Style="{StaticResource Settings.Divider}" Margin="0,12" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="支持作者" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="如果好用，请作者喝杯咖啡 ☕" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.Caption}" TextAlignment="Right" Margin="10,0,0,0" />
          </Grid>
          <Button x:Name="SponsorQrCard" Margin="0,10,0,0" Padding="10" HorizontalAlignment="Left" Click="SponsorQr_Click" Style="{StaticResource ThemeCard}" Cursor="Hand" ToolTip="点击打开微信赞赏码大图" AutomationProperties.Name="打开微信赞赏码大图">
            <StackPanel>
              <Border Width="168" Height="168" CornerRadius="12" Background="{DynamicResource Brush.Surface.ContainerLow}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1" ClipToBounds="True">
                <Image Source="pack://application:,,,/Assets/wechat-sponsor-qr.jpg" Width="156" Height="156" Stretch="Uniform" />
              </Border>
              <TextBlock Text="微信赞赏码 · 点击查看大图" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="AfdianLinkCard" Margin="0,10,0,0" Padding="14,12" HorizontalAlignment="Left" Click="AfdianLink_Click" Style="{StaticResource ThemeCard}" Cursor="Hand" ToolTip="打开爱发电主页支持作者" AutomationProperties.Name="打开爱发电主页支持作者">
            <StackPanel>
              <TextBlock Text="爱发电 (Afdian)" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{StaticResource Typography.BodySmall}" FontWeight="SemiBold" />
              <TextBlock Text="afdian.com/a/hanabededsec · 点击打开主页" Foreground="{DynamicResource Brush.OnSurfaceVariant}" FontSize="{StaticResource Typography.Caption}" Margin="0,4,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
