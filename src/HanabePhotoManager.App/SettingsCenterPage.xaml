<UserControl x:Class="HanabePhotoManager.App.SettingsCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HanabePhotoManager.App"
    xmlns:navigation="clr-namespace:HanabePhotoManager.App.Navigation"
         xmlns:navigations="clr-namespace:HanabePhotoManager.App.Navigation;assembly=HanabePhotoManager.Shared"
    xmlns:services="clr-namespace:HanabePhotoManager.App.Services"
         xmlns:servicess="clr-namespace:HanabePhotoManager.App.Services;assembly=HanabePhotoManager.Shared"
    Loaded="SettingsCenterPage_Loaded"
    Foreground="{DynamicResource Brush.OnSurface}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:AssistantOutfitPreviewConverter x:Key="OutfitPreview" />
    <local:EnumNameConverter x:Key="EnumName" />

    <!-- 分区图标（线性图标，描边由 Settings.NavIcon 统一） -->
    <Geometry x:Key="Settings.Icon.Palette">M12 22a10 10 0 1 1 10-10c0 2.8-2.2 4-4 4h-2a2 2 0 0 0-1.5 3.3A2 2 0 0 1 12 22z M7.5 10.5h.01 M12 7.5h.01 M16.5 10.5h.01</Geometry>
    <Geometry x:Key="Settings.Icon.Heart">M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z</Geometry>
    <Geometry x:Key="Settings.Icon.Spark">M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z M19 16v4 M17 18h4</Geometry>
    <Geometry x:Key="Settings.Icon.Tool">M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z</Geometry>
    <Geometry x:Key="Settings.Icon.Shield">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z</Geometry>
    <Geometry x:Key="Settings.Icon.Keyboard">M3 6h18a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z M6 10h.01 M10 10h.01 M14 10h.01 M18 10h.01 M7 14h10</Geometry>

    <!-- 文字层级：分组标题 / 设置名 / 说明（搜索按这三种样式建立索引） -->
    <Style x:Key="Settings.GroupHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource Typography.Caption}" />
      <Setter Property="Margin" Value="4,26,0,10" />
    </Style>
    <Style x:Key="Settings.RowTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource Typography.Body}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Settings.RowDesc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
      <Setter Property="FontSize" Value="{StaticResource Typography.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="Settings.TableHead" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource Typography.Caption}" />
    </Style>

    <!-- 卡片与行：每组设置一张圆角卡，行之间细分隔线，控件统一靠右 -->
    <Style x:Key="Settings.Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="20,2" />
    </Style>
    <Style x:Key="Settings.Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,14" />
      <Setter Property="LastChildFill" Value="True" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style x:Key="Settings.KeyRow" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,9" />
      <Setter Property="LastChildFill" Value="True" />
    </Style>
    <Style x:Key="Settings.RowDivider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- 开关 -->
    <Style x:Key="Settings.Toggle" TargetType="CheckBox" BasedOn="{StaticResource Input.Switch}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- 滑块数值胶囊 -->
    <Style x:Key="Settings.ValuePill" TargetType="Border">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerHigh}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Settings.ValueText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource Typography.BodySmall}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- 分段按钮：2–5 个互斥选项直接平铺，不再藏在下拉框里 -->
    <Style x:Key="Settings.SegmentItem" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <!-- 应用级 TextBlock 隐式样式会固定文字颜色；这里让文字跟随选中态 -->
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="{StaticResource Typography.BodySmall}" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Primary.Fill}" /><Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Settings.Segment" TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.SegmentItem}" />
      <Setter Property="ItemsPanel">
        <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ItemsPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 图片 / 卡片选择器：服装、声音风格 -->
    <Style x:Key="Settings.PickerItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" CornerRadius="14" Background="{DynamicResource Brush.Surface.Subtle}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1.5">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Settings.PickerList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ItemsPanel">
        <Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 高级项折叠 -->
    <Style x:Key="Settings.Disclosure" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{StaticResource Typography.BodySmall}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,16,0,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="Transparent" Padding="6,6" CornerRadius="{StaticResource Radius.Small}" BorderBrush="Transparent" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="Chevron" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 按键帽 -->
    <Style x:Key="Settings.KeyCap" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border MinWidth="28" Height="28" Padding="8,0" CornerRadius="7" Background="{DynamicResource Brush.Surface.ContainerHighest}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="1,1,1,2.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.FontSize="{StaticResource Typography.BodySmall}" TextElement.Foreground="{DynamicResource Brush.Text.Primary}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Settings.KeyJoin" TargetType="TextBlock">
      <Setter Property="Margin" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      <Setter Property="FontSize" Value="{StaticResource Typography.Caption}" />
    </Style>

    <!-- 左侧分区导航 -->
    <Style x:Key="Settings.NavIcon" TargetType="Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{DynamicResource Brush.OnSurfaceVariant}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Settings.SectionNavItem" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="4,1" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Chrome" CornerRadius="{StaticResource Radius.Control}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
              <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" /><Setter TargetName="Bar" Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 搜索结果卡 -->
    <Style x:Key="Settings.ResultCard" TargetType="Button">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="{StaticResource Radius.Dialog}" Padding="18,14" Background="{DynamicResource Brush.Surface.ContainerLow}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主题色卡 -->
    <Style x:Key="ThemeCard" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLowest}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="{StaticResource Radius.Dialog}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </UserControl.Resources>
  <Grid Background="Transparent" Margin="{StaticResource Spacing.Card}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左：分区导航（11 个分区）+ 搜索 -->
    <Border Grid.Column="0" Style="{DynamicResource Layout.GlassPanel}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10,6,10,14">
          <TextBlock Text="Settings" Style="{DynamicResource Layout.Eyebrow}" />
          <TextBlock Text="设置" FontSize="{StaticResource Typography.Title}" FontWeight="Bold" Margin="0,2,0,14" />
          <Grid>
            <TextBox x:Name="SettingsSearchBox" Style="{StaticResource Input.TextBox}" Padding="30,8,10,8" VerticalContentAlignment="Center" TextChanged="SettingsSearch_TextChanged" KeyDown="SettingsSearch_KeyDown" ToolTip="输入设置名称；Enter 打开首项，Esc 清空" AutomationProperties.Name="查找设置" />
            <Path Data="{StaticResource Icon.Search}" Stroke="{DynamicResource Brush.OnSurfaceVariant}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
            <TextBlock Text="搜索设置  Ctrl+F" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=SettingsSearchBox, Path=Text}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </StackPanel>
        <ListBox x:Name="SectionNavList" Style="{StaticResource List.Default}" ItemContainerStyle="{StaticResource Settings.SectionNavItem}" SelectionChanged="SectionNav_SelectionChanged" AutomationProperties.Name="设置分区">
          <ListBox.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Style>
          </ListBox.Resources>
          <ListBoxItem Tag="general" AutomationProperties.Name="常规"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Icon.Settings}" /><TextBlock Text="常规" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="appearance" AutomationProperties.Name="外观"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Settings.Icon.Palette}" /><TextBlock Text="外观" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="pet" AutomationProperties.Name="Hanabe 桌宠"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Settings.Icon.Heart}" /><TextBlock Text="Hanabe 桌宠" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="import" AutomationProperties.Name="导入"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Icon.Import}" /><TextBlock Text="导入" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="library" AutomationProperties.Name="照片库"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Icon.Folder}" /><TextBlock Text="照片库" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="browse" AutomationProperties.Name="浏览"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Icon.Image}" /><TextBlock Text="浏览" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="intelligence" AutomationProperties.Name="AI 与人物"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Settings.Icon.Spark}" /><TextBlock Text="AI 与人物" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="tools" AutomationProperties.Name="工具"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Settings.Icon.Tool}" /><TextBlock Text="工具" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="storage" AutomationProperties.Name="存储与隐私"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Settings.Icon.Shield}" /><TextBlock Text="存储与隐私" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="shortcuts" AutomationProperties.Name="快捷键"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Settings.Icon.Keyboard}" /><TextBlock Text="快捷键" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="about" AutomationProperties.Name="关于"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Settings.NavIcon}" Data="{StaticResource Icon.Info}" /><TextBlock Text="关于" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右：当前分区内容 -->
    <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <Grid Margin="8,4,24,32">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="940" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
