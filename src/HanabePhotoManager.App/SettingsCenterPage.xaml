      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="940" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="SearchResultHeading" Style="{StaticResource Layout.PageTitle}" />
        <TextBlock x:Name="SearchResultCount" Style="{StaticResource Layout.SettingsHint}" Margin="0,4,0,16" />
        <ItemsControl x:Name="SearchResultsList">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Tag="{Binding}" Click="SettingsSearchResult_Click" Style="{StaticResource Settings.ResultCard}" AutomationProperties.Name="{Binding Text}">
              <DockPanel>
                <Path DockPanel.Dock="Right" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel>
                  <TextBlock Text="{Binding Breadcrumb}" FontSize="{StaticResource Typography.Caption}" Foreground="{DynamicResource Brush.Primary}" />
                  <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="{StaticResource Typography.Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Settings.RowDesc}" Margin="0,2,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </DockPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="SearchSuggestions" Margin="0,8,0,0" Padding="16,12" CornerRadius="{StaticResource Radius.Control}" BorderBrush="{DynamicResource Brush.OutlineVariant}" BorderThickness="1">
          <WrapPanel>
            <TextBlock Text="试试：" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
            <Button Content="背景" Style="{StaticResource Button.Ghost}" Click="SearchSuggestion_Click" />
            <Button Content="查重" Style="{StaticResource Button.Ghost}" Click="SearchSuggestion_Click" />
            <Button Content="开机" Style="{StaticResource Button.Ghost}" Click="SearchSuggestion_Click" />
            <Button Content="命名" Style="{StaticResource Button.Ghost}" Click="SearchSuggestion_Click" />
            <Button Content="声音" Style="{StaticResource Button.Ghost}" Click="SearchSuggestion_Click" />
          </WrapPanel>
        </Border>
      </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
