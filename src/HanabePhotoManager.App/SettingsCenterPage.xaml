nel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="试听" Style="{StaticResource Button.Ghost}" Margin="0,0,12,0" AutomationProperties.Name="试听跳过" Command="{Binding PreviewSoundEventCommand}" CommandParameter="Skipped" /><CheckBox Style="{StaticResource Settings.Toggle}" Margin="0" IsChecked="{Binding HanabeSoundSkipEnabled, Mode=TwoWay}" AutomationProperties.Name="跳过提示音" /></StackPanel><StackPanel Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="跳过" Style="{StaticResource Settings.RowTitle}" /><TextBlock Text="导入遇到已存在或主动跳过的项目时提示；连续项目合并提示。" Style="{StaticResource Settings.RowDesc}" Margin="0,3,0,0" /></StackPanel></DockPanel><Border Style="{StaticResource Settings.RowDivider}" /><DockPanel Style="{StaticResource Settings.Row}"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="试听" Style="{StaticResource Button.Ghost}" Margin="0,0,12,0" AutomationProperties.Name="试听打开功能" Command="{Binding PreviewSoundEventCommand}" CommandParameter="FeatureOpened" /><CheckBox Style="{StaticResource Settings.Toggle}" Margin="0" IsChecked="{Binding HanabeSoundOpenEnabled, Mode=TwoWay}" AutomationProperties.Name="打开功能提示音" /></StackPanel><StackPanel Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="打开功能" Style="{StaticResource Settings.RowTitle}" /><TextBlock Text="切换功能页面时播放轻提示音，默认关闭。" Style="{StaticResource Settings.RowDesc}" Margin="0,3,0,0" /></StackPanel></DockPanel><Border Style="{StaticResource Settings.RowDivider}" /><DockPanel Style="{StaticResource Settings.Row}"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="试听" Style="{StaticResource Button.Ghost}" Margin="0,0,12,0" AutomationProperties.Name="试听安全停止" Command="{Binding PreviewSoundEventCommand}" CommandParameter="Canceled" /><CheckBox Style="{StaticResource Settings.Toggle}" Margin="0" IsChecked="{Binding HanabeSoundCancelEnabled, Mode=TwoWay}" AutomationPropertie