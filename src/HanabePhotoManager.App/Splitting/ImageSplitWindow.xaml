<Window x:Class="HanabePhotoManager.App.Splitting.ImageSplitWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="切图 · 中分 / 六分 / 九宫格" Width="1180" Height="780" MinWidth="900" MinHeight="620"
 Style="{DynamicResource Dialog.Window}" WindowStartupLocation="CenterOwner">
 <Grid Margin="{StaticResource Spacing.Card}" Background="{DynamicResource Brush.Background.Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="{StaticResource Spacing.Stack.16}">
   <TextBlock Text="切图" Style="{DynamicResource Layout.PageTitle}"/>
   <TextBlock Text="中分 · 六分 · 九宫格 / 先构图，再分割" Foreground="{DynamicResource Brush.Text.Primary}"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Brush.Surface.ContainerLow}" Padding="{StaticResource Spacing.Control}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="{StaticResource BorderThickness.Divider.Bottom}">
    <StackPanel IsEnabled="{Binding CanEdit}">
     <TextBlock Text="01 / 图片与分割" Style="{DynamicResource Layout.SectionTitle}" Margin="{StaticResource Spacing.Stack.16}"/>
     <Button Content="选择图片" Click="ChooseImage" Style="{DynamicResource Button.Primary}"/>
     <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}" Margin="{StaticResource Spacing.Row.Vertical.8}"/>
     <TextBlock Text="分割方式" Style="{DynamicResource Layout.SettingsFieldLabel}"/>
     <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Style="{DynamicResource Input.ComboBox}">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock Text="从左到右、从上到下编号。选区尺寸不能整除时，相邻块最多相差 1 像素。" Style="{DynamicResource Layout.SettingsHint}" Margin="{StaticResource Spacing.Stack.8}"/>
    </StackPanel>
   </Border>
   <Grid Grid.Column="1" Margin="{StaticResource Spacing.Inline.8}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Brush.Viewer.Canvas}" Padding="{StaticResource Spacing.IconButton}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="1">
     <Viewbox Stretch="Uniform">
      <Canvas x:Name="PreviewCanvas" Width="800" Height="600" Background="Transparent" Focusable="True" Cursor="SizeAll"
       MouseLeftButtonDown="DragStart" MouseMove="DragMove" MouseLeftButtonUp="DragEnd" LostMouseCapture="DragLost" KeyDown="MoveByKey"/>
     </Viewbox>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding Dimensions}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="{StaticResource Spacing.Row.Vertical.8}" TextWrapping="Wrap"/>
   </Grid>
   <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.ContainerLow}" Padding="{StaticResource Spacing.Card}" Margin="{StaticResource Spacing.Inline.8}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="02 / 构图与导出" Style="{DynamicResource Layout.SectionTitle}" Margin="{StaticResource Spacing.Stack.16}"/>
      <CheckBox Content="方形选区" IsChecked="{Binding Square}" Style="{DynamicResource Selection.CheckBox}"/>
      <TextBlock Text="选区大小（10%–100%）" Style="{DynamicResource Layout.SettingsFieldLabel}" Margin="{StaticResource Spacing.Stack.8}"/>
      <Slider Minimum="10" Maximum="100" Value="{Binding Scale}" Style="{DynamicResource Selection.Slider}" AutomationProperties.Name="选区大小"/>
      <TextBlock Text="水平位置" Style="{DynamicResource Layout.SettingsFieldLabel}"/>
      <Slider Minimum="0" Maximum="100" Value="{Binding PositionX}" Style="{DynamicResource Selection.Slider}" AutomationProperties.Name="水平位置"/>
      <TextBlock Text="垂直位置" Style="{DynamicResource Layout.SettingsFieldLabel}"/>
      <Slider Minimum="0" Maximum="100" Value="{Binding PositionY}" Style="{DynamicResource Selection.Slider}" AutomationProperties.Name="垂直位置"/>
      <Button Content="居中并重置大小" Command="{Binding CenterCommand}" Style="{DynamicResource Button.Secondary}" Margin="{StaticResource Spacing.Row.Vertical.8}"/>
      <TextBlock Text="拖动预览移动选区。聚焦预览后，方向键可微调位置。" Style="{DynamicResource Layout.SettingsHint}"/>
      <CheckBox Content="PNG 无损（取消则 JPEG）" IsChecked="{Binding Png}" Style="{DynamicResource Selection.CheckBox}"/>
      <TextBlock Text="输出目录（D 盘）" Style="{DynamicResource Layout.SettingsFieldLabel}" Margin="{StaticResource Spacing.Stack.8}"/>
      <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.TextBox}"/>
      <Button Content="选择输出目录" Click="ChooseOutput" Style="{DynamicResource Button.Secondary}" Margin="{StaticResource Spacing.Row.Vertical.8}"/>
      <Button Content="导出切图" Command="{Binding ExportCommand}" Style="{DynamicResource Button.Primary}"/>
      <Button Content="打开导出文件夹" Click="OpenResult" IsEnabled="{Binding HasResult}" Style="{DynamicResource Button.Secondary}" Margin="{StaticResource Spacing.Stack.8}"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2" Margin="{StaticResource Spacing.Stack.8}">
   <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="{StaticResource Spacing.4}"/>
   <DockPanel Margin="{StaticResource Spacing.Stack.8}">
    <Button DockPanel.Dock="Right" Content="取消处理" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Style="{DynamicResource Button.Secondary}"/>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>

