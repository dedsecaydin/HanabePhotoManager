<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Background.Canvas" Color="{StaticResource Color.Background.Canvas}"/><SolidColorBrush x:Key="Brush.Background.Subtle" Color="{StaticResource Color.Background.Subtle}"/><SolidColorBrush x:Key="Brush.Background.Chrome" Color="{StaticResource Color.Background.Chrome}"/>
  <SolidColorBrush x:Key="Brush.Surface.Default" Color="{StaticResource Color.Surface.Default}"/><SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Color.Surface.Subtle}"/><SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}"/><SolidColorBrush x:Key="Brush.Surface.Interactive" Color="{StaticResource Color.Surface.Interactive}"/><SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}"/><SolidColorBrush x:Key="Brush.Surface.Disabled" Color="{StaticResource Color.Surface.Disabled}"/><SolidColorBrush x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}"/>
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}"/><SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}"/><SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}"/><SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}"/><SolidColorBrush x:Key="Brush.Border.Disabled" Color="{StaticResource Color.Border.Disabled}"/>
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/><SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/><SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/><SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/><SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Text.Inverse}"/><SolidColorBrush x:Key="Brush.Text.Link" Color="{StaticResource Color.Text.Link}"/>
  <SolidColorBrush x:Key="Brush.Accent.Default" Color="{StaticResource Color.Accent.Default}"/><SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/><SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}"/><SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}"/><SolidColorBrush x:Key="Brush.Accent.Disabled" Color="{StaticResource Color.Accent.Disabled}"/>
  <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Status.Info}"/><SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}"/><SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}"/><SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}"/><SolidColorBrush x:Key="Brush.Status.InfoSubtle" Color="{StaticResource Color.Status.InfoSubtle}"/><SolidColorBrush x:Key="Brush.Status.SuccessSubtle" Color="{StaticResource Color.Status.SuccessSubtle}"/><SolidColorBrush x:Key="Brush.Status.WarningSubtle" Color="{StaticResource Color.Status.WarningSubtle}"/><SolidColorBrush x:Key="Brush.Status.DangerSubtle" Color="{StaticResource Color.Status.DangerSubtle}"/>
  <SolidColorBrush x:Key="Brush.Viewer.Canvas" Color="{StaticResource Color.Viewer.Canvas}"/><SolidColorBrush x:Key="Brush.Viewer.Chrome" Color="{StaticResource Color.Viewer.Chrome}"/><SolidColorBrush x:Key="Brush.Viewer.Text" Color="{StaticResource Color.Viewer.Text}"/><SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="{StaticResource Color.Overlay.Scrim}"/>
  <DrawingBrush x:Key="Brush.Shell.Background" Stretch="Fill"><DrawingBrush.Drawing><DrawingGroup>
    <GeometryDrawing Geometry="M0,0 L100,0 100,100 0,100Z"><GeometryDrawing.Brush><SolidColorBrush Color="{StaticResource Color.Surface.Dim}"/></GeometryDrawing.Brush></GeometryDrawing>
    <GeometryDrawing Geometry="M0,0 L100,0 100,100 0,100Z"><GeometryDrawing.Brush><RadialGradientBrush Center="0.8,0.06" GradientOrigin="0.8,0.06" RadiusX="0.40" RadiusY="0.55"><GradientStop Color="{StaticResource Color.Shell.Glow1}" Offset="0"/><GradientStop Color="{StaticResource Color.Shell.GlowClear}" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
    <GeometryDrawing Geometry="M0,0 L100,0 100,100 0,100Z"><GeometryDrawing.Brush><RadialGradientBrush Center="0.28,1.04" GradientOrigin="0.28,1.04" RadiusX="0.44" RadiusY="0.60"><GradientStop Color="{StaticResource Color.Shell.Glow2}" Offset="0"/><GradientStop Color="{StaticResource Color.Shell.GlowClear}" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
    <GeometryDrawing Geometry="M0,0 L100,0 100,100 0,100Z"><GeometryDrawing.Brush><RadialGradientBrush Center="1.02,0.92" GradientOrigin="1.02,0.92" RadiusX="0.36" RadiusY="0.50"><GradientStop Color="{StaticResource Color.Shell.Glow3}" Offset="0"/><GradientStop Color="{StaticResource Color.Shell.GlowClear}" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
  </DrawingGroup></DrawingBrush.Drawing></DrawingBrush><SolidColorBrush x:Key="Brush.Shell.Sidebar" Color="{StaticResource Color.Surface.ContainerLowest}"/><SolidColorBrush x:Key="Brush.Shell.TopBar" Color="{StaticResource Color.Surface.ContainerLow}"/><SolidColorBrush x:Key="Brush.Shell.Summary" Color="{StaticResource Color.Surface.ContainerLow}"/><SolidColorBrush x:Key="Brush.Shell.Highlight" Color="{StaticResource Color.Surface.Container}"/>
  <!-- Material 3 semantic brushes（key 与上方既有语义键并存，页面只消费语义 Token） -->
  <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/><SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource Color.OnPrimary}"/><SolidColorBrush x:Key="Brush.PrimaryContainer" Color="{StaticResource Color.PrimaryContainer}"/><SolidColorBrush x:Key="Brush.OnPrimaryContainer" Color="{StaticResource Color.OnPrimaryContainer}"/>
  <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}"/><SolidColorBrush x:Key="Brush.OnSecondary" Color="{StaticResource Color.OnSecondary}"/><SolidColorBrush x:Key="Brush.SecondaryContainer" Color="{StaticResource Color.SecondaryContainer}"/><SolidColorBrush x:Key="Brush.OnSecondaryContainer" Color="{StaticResource Color.OnSecondaryContainer}"/>
  <SolidColorBrush x:Key="Brush.Tertiary" Color="{StaticResource Color.Tertiary}"/><SolidColorBrush x:Key="Brush.OnTertiary" Color="{StaticResource Color.OnTertiary}"/><SolidColorBrush x:Key="Brush.TertiaryContainer" Color="{StaticResource Color.TertiaryContainer}"/><SolidColorBrush x:Key="Brush.OnTertiaryContainer" Color="{StaticResource Color.OnTertiaryContainer}"/>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/><SolidColorBrush x:Key="Brush.OnSurface" Color="{StaticResource Color.OnSurface}"/><SolidColorBrush x:Key="Brush.Surface.Variant" Color="{StaticResource Color.Surface.Variant}"/><SolidColorBrush x:Key="Brush.OnSurfaceVariant" Color="{StaticResource Color.OnSurfaceVariant}"/>
  <SolidColorBrush x:Key="Brush.Surface.Dim" Color="{StaticResource Color.Surface.Dim}"/><SolidColorBrush x:Key="Brush.Surface.ContainerLowest" Color="{StaticResource Color.Surface.ContainerLowest}"/><SolidColorBrush x:Key="Brush.Surface.ContainerLow" Color="{StaticResource Color.Surface.ContainerLow}"/><SolidColorBrush x:Key="Brush.Surface.Container" Color="{StaticResource Color.Surface.Container}"/><SolidColorBrush x:Key="Brush.Surface.ContainerHigh" Color="{StaticResource Color.Surface.ContainerHigh}"/><SolidColorBrush x:Key="Brush.Surface.ContainerHighest" Color="{StaticResource Color.Surface.ContainerHighest}"/>
  <SolidColorBrush x:Key="Brush.Outline" Color="{StaticResource Color.Outline}"/><SolidColorBrush x:Key="Brush.OutlineVariant" Color="{StaticResource Color.OutlineVariant}"/>

  <!-- 镜面玻璃（樱粉镜面主题有光晕和渐变；其它配色这些键与原纯色一致） -->
  <SolidColorBrush x:Key="Brush.Background.Page" Color="{StaticResource Color.Background.Page}"/>
  <LinearGradientBrush x:Key="Brush.Primary.Fill" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{StaticResource Color.Primary.FillStart}" Offset="0"/><GradientStop Color="{StaticResource Color.Primary.FillEnd}" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.Glass.Stroke" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{StaticResource Color.Glass.StrokeTop}" Offset="0"/><GradientStop Color="{StaticResource Color.Glass.StrokeBottom}" Offset="1"/></LinearGradientBrush>
  <BitmapImage x:Key="Image.AppLogo" UriSource="pack://application:,,,/Assets/HanabeAppLogo.Transparent.png" />
  <LinearGradientBrush x:Key="Brush.Glass.Surface" StartPoint="0,0" EndPoint="0.84,1"><GradientStop Color="{StaticResource Color.Glass.SurfaceStart}" Offset="0"/><GradientStop Color="{StaticResource Color.Glass.SurfaceEnd}" Offset="1"/></LinearGradientBrush>
  <RadialGradientBrush x:Key="Brush.Shell.Ambient1" Center="0.8,0.06" GradientOrigin="0.8,0.06" RadiusX="0.40" RadiusY="0.55"><GradientStop Color="{StaticResource Color.Shell.Glow1}" Offset="0"/><GradientStop Color="{StaticResource Color.Shell.GlowClear}" Offset="1"/></RadialGradientBrush>
  <RadialGradientBrush x:Key="Brush.Shell.Ambient2" Center="0.28,1.04" GradientOrigin="0.28,1.04" RadiusX="0.44" RadiusY="0.60"><GradientStop Color="{StaticResource Color.Shell.Glow2}" Offset="0"/><GradientStop Color="{StaticResource Color.Shell.GlowClear}" Offset="1"/></RadialGradientBrush>
  <RadialGradientBrush x:Key="Brush.Shell.Ambient3" Center="1.02,0.92" GradientOrigin="1.02,0.92" RadiusX="0.36" RadiusY="0.50"><GradientStop Color="{StaticResource Color.Shell.Glow3}" Offset="0"/><GradientStop Color="{StaticResource Color.Shell.GlowClear}" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
