<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Background.Canvas" Color="{StaticResource Color.Background.Canvas}"/><SolidColorBrush x:Key="Brush.Background.Subtle" Color="{StaticResource Color.Background.Subtle}"/>
  <SolidColorBrush x:Key="Brush.Surface.Default" Color="{StaticResource Color.Surface.Default}"/><SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Color.Surface.Subtle}"/><SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}"/><SolidColorBrush x:Key="Brush.Surface.Interactive" Color="{StaticResource Color.Surface.Interactive}"/><SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}"/>
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}"/><SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}"/><SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}"/><SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}"/>
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/><SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/><SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/><SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/><SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Text.Inverse}"/>
  <SolidColorBrush x:Key="Brush.Accent.Default" Color="{StaticResource Color.Accent.Default}"/><SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/><SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}"/><SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}"/>
  <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Status.Info}"/><SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}"/><SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}"/><SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}"/><SolidColorBrush x:Key="Brush.Viewer.Canvas" Color="{StaticResource Color.Viewer.Canvas}"/>
  <LinearGradientBrush x:Key="Brush.Shell.Background" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{StaticResource Color.Background.Subtle}" Offset="0"/><GradientStop Color="{StaticResource Color.Background.Canvas}" Offset="0.52"/><GradientStop Color="{StaticResource Color.Accent.Subtle}" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.Shell.Sidebar" Color="{StaticResource Color.Surface.Default}" Opacity="0.72"/>
  <SolidColorBrush x:Key="Brush.Shell.TopBar" Color="{StaticResource Color.Background.Subtle}" Opacity="0.68"/>
  <SolidColorBrush x:Key="Brush.Shell.Summary" Color="{StaticResource Color.Surface.Default}" Opacity="0.62"/>
  <SolidColorBrush x:Key="Brush.Shell.Highlight" Color="{StaticResource Color.Surface.Default}" Opacity="0.82"/>
</ResourceDictionary>
