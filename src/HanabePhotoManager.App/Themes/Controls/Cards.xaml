<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Card.Default" TargetType="Border"><Setter Property="Padding" Value="{StaticResource Spacing.Card}"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Card.Subtle" TargetType="Border" BasedOn="{StaticResource Card.Default}"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}"/></Style>
  <Style x:Key="Card.Interactive" TargetType="Border" BasedOn="{StaticResource Card.Default}"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Interactive}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Disabled}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Card.Selected" TargetType="Border" BasedOn="{StaticResource Card.Default}"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/></Style>
</ResourceDictionary>
