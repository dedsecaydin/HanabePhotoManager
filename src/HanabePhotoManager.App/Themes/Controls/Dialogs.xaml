<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Style x:Key="Dialog.Window" TargetType="Window"><Setter Property="Background" Value="{DynamicResource Brush.Background.Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/><Setter Property="ShowInTaskbar" Value="False"/></Style><Style x:Key="Dialog.Surface" TargetType="Border" BasedOn="{StaticResource Card.Default}"><Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}"/><Setter Property="Effect" Value="{StaticResource Shadow.Dialog}"/></Style><Style x:Key="Dialog.Title" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource Typography.Title}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/></Style><Style x:Key="Dialog.Body" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource Typography.Body}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style></ResourceDictionary>
