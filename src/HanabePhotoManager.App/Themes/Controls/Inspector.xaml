<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Inspector.Container" TargetType="Border" BasedOn="{StaticResource Card.Default}">
    <Setter Property="Padding" Value="{StaticResource Spacing.Card}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}"/>
  </Style>
  <Style x:Key="Inspector.Panel" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource Spacing.Card}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Container}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLow}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="Inspector.Header" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/>
    <Setter Property="FontSize" Value="{StaticResource Typography.Label}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
  </Style>
  <Style x:Key="Inspector.SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/>
    <Setter Property="FontSize" Value="{StaticResource Typography.Caption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
  </Style>
  <Style x:Key="Inspector.FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/>
    <Setter Property="FontSize" Value="{StaticResource Typography.Caption}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style x:Key="Inspector.FieldValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/>
    <Setter Property="FontSize" Value="{StaticResource Typography.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
</ResourceDictionary>
