<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Layout.Shell" TargetType="Grid"><Setter Property="Background" Value="{DynamicResource Brush.Shell.Background}"/></Style>
  <Style x:Key="Layout.Workspace" TargetType="Border"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Layout.TopBar" TargetType="Border"><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="4,8,8,0"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Container}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLow}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Layout.HomeSummary" TargetType="Border"><Setter Property="Padding" Value="{StaticResource Spacing.Card}"/><Setter Property="Margin" Value="0,0,0,20"/><Setter Property="Background" Value="{DynamicResource Brush.Glass.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/></Style>
  <Style x:Key="Layout.HomeSection" TargetType="Border"><Setter Property="Padding" Value="{StaticResource Spacing.Card}"/><Setter Property="Margin" Value="0,0,0,24"/><Setter Property="Background" Value="{DynamicResource Brush.Glass.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/></Style>
  <Style x:Key="Layout.PageSurface" TargetType="Border"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="Padding" Value="{StaticResource Spacing.Page}"/><Setter Property="Background" Value="{DynamicResource Brush.Background.Page}"/></Style>
  <!-- 连续工作区：页面不重复绘制外框，独立内容保留语义层级。 -->
  <Style x:Key="Layout.PagePanel" TargetType="Border">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.None}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Background.Page}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <!-- 扁平分区：页内左右/中列不再各自成圆角卡片 -->
  <Style x:Key="Layout.Section" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource Spacing.Card}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Glass.Surface}"/>
    <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/></Style>
  <Style x:Key="Layout.PageTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/><Setter Property="FontSize" Value="{StaticResource Typography.PageHeading}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0,0,0,2"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style x:Key="Layout.SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource Typography.TitleSmall}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0,0,0,2"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style x:Key="Layout.SettingsGroup" TargetType="Border"><Setter Property="Margin" Value="0,0,0,24"/><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Layout.SettingsFieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Layout.SettingsHint" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Layout.StatusBar" TargetType="Border"><Setter Property="Height" Value="{StaticResource Size.Control.Default}"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="{StaticResource Spacing.StatusBar.Content}"/><Setter Property="CornerRadius" Value="{StaticResource Radius.None}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/></Style>
  <Style x:Key="Layout.GlassPanel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush.Glass.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="Padding" Value="16,18"/></Style>
  <Style x:Key="Layout.Eyebrow" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.Script}"/><Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style x:Key="Layout.Numeric" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.Mono}"/><Setter Property="FontSize" Value="{StaticResource Typography.BodySmall}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
</ResourceDictionary>
