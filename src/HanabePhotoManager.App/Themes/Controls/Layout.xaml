<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Layout.Shell" TargetType="Grid"><Setter Property="Background" Value="{DynamicResource Brush.Shell.Background}"/></Style>
  <Style x:Key="Layout.Workspace" TargetType="Border"><Setter Property="Padding" Value="24,20,24,24"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Layout.TopBar" TargetType="Border"><Setter Property="Padding" Value="0,0,0,18"/><Setter Property="Margin" Value="0,0,0,20"/><Setter Property="Background" Value="{DynamicResource Brush.Shell.TopBar}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style x:Key="Layout.HomeSummary" TargetType="Border"><Setter Property="Padding" Value="20,18"/><Setter Property="Margin" Value="0,0,0,24"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="Background" Value="{DynamicResource Brush.Shell.Summary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Shell.Highlight}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Effect" Value="{StaticResource Shadow.Emphasis}"/></Style>
  <Style x:Key="Layout.HomeSection" TargetType="Border"><Setter Property="Padding" Value="0,0,0,24"/><Setter Property="Margin" Value="0,0,0,24"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style x:Key="Layout.PageSurface" TargetType="Border"><Setter Property="Padding" Value="{StaticResource Spacing.Page}"/><Setter Property="Background" Value="{DynamicResource Brush.Background.Canvas}"/></Style>
  <Style x:Key="Layout.PageTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/><Setter Property="FontSize" Value="{StaticResource Typography.Display}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0,0,0,2"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style x:Key="Layout.SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource Typography.TitleSmall}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0,0,0,2"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style x:Key="Layout.SettingsGroup" TargetType="Border"><Setter Property="Margin" Value="0,0,0,24"/><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Layout.SettingsFieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Layout.SettingsHint" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary>
