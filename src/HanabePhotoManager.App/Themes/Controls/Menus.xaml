<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Style x:Key="Menu.Context" TargetType="ContextMenu"><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/></Style><Style x:Key="Menu.Item" TargetType="MenuItem"><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Interactive}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/></Trigger></Style.Triggers></Style><Style x:Key="Separator.Menu" TargetType="Separator"><Setter Property="Margin" Value="8,4"/><Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}"/></Style></ResourceDictionary>
