<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    右键菜单：与 AI 面板 / 浮层同一套语言 —— 圆角玻璃面板 + 柔和投影、胶囊悬停、粉色圆角勾选框、
    小号灰色分组标题、右侧快捷键。完整替换系统模板（系统模板自带灰色图标槽和蓝色复选框）。
    注意：只提供带 x:Key 的样式，不做全局隐式样式（见 ControlThemeTests）。
  -->

  <Style x:Key="Menu.Item" TargetType="MenuItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GlyphColumn" Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- 勾选框：未选是细描边圆角方块，选中填充主色 + 白色对勾 -->
              <Border x:Name="CheckBox" Width="16" Height="16" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1.5" Background="Transparent" Visibility="Collapsed">
                <Path x:Name="CheckMark" Data="M3.2,8.2 L6.5,11.3 L12.8,4.7" Stroke="{DynamicResource Brush.OnPrimary}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Visibility="Collapsed" />
              </Border>
              <ContentPresenter x:Name="IconHost" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" />

              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <!-- App.xaml 有全局 TextBlock 样式会给自动生成的文字写死颜色；这里让菜单文字跟随菜单项自己的前景色 -->
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                    <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
              <TextBlock x:Name="Gesture" Grid.Column="2" Margin="28,0,2,0" VerticalAlignment="Center" Text="{TemplateBinding InputGestureText}"
                         Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{StaticResource Typography.Caption}" />
              <Path x:Name="SubmenuArrow" Grid.Column="3" Margin="10,0,0,0" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.5"
                    VerticalAlignment="Center" Visibility="Collapsed" />

              <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" VerticalOffset="-8" AllowsTransparency="True" Focusable="False"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                <Border Margin="4,2,14,14" Padding="6" CornerRadius="14" MinWidth="200" Background="{DynamicResource Brush.Surface.Overlay}"
                        BorderBrush="{DynamicResource Brush.Glass.Stroke}" BorderThickness="1" Effect="{DynamicResource Shadow.Dialog}">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
              <Setter TargetName="CheckBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckBox" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="CheckBox" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
              <Setter TargetName="CheckBox" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 分组标题：小号灰字，不可点、不高亮 -->
  <Style x:Key="Menu.SectionHeader" TargetType="MenuItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <TextBlock Margin="10,6,10,4" Text="{TemplateBinding Header}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                     FontSize="{StaticResource Typography.Caption}" FontWeight="SemiBold" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Separator.Menu" TargetType="Separator">
    <Setter Property="Margin" Value="8,5" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Menu.Context" TargetType="ContextMenu">
    <Style.Resources>
      <Style TargetType="MenuItem" BasedOn="{StaticResource Menu.Item}" />
      <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource Separator.Menu}" />
    </Style.Resources>
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}" />
    <Setter Property="FontSize" Value="{StaticResource Typography.BodySmall}" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="MousePoint" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <!-- 外层留出投影空间（菜单弹层本身是透明的） -->
          <Border Margin="4,2,14,14" Padding="{TemplateBinding Padding}" CornerRadius="14"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  MinWidth="{TemplateBinding MinWidth}" Effect="{DynamicResource Shadow.Dialog}" SnapsToDevicePixels="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
