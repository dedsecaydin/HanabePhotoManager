<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Selection.CheckBox" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="SelectionBox" Width="20" Height="20" CornerRadius="6" Background="{DynamicResource Brush.Surface.Default}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1.5" VerticalAlignment="Center"><Path x:Name="CheckMark" Data="M 4,10 L 8,14 L 16,6" Stroke="{DynamicResource Brush.OnPrimary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Border>
        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/><Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource Brush.Primary}"/><Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/><Setter TargetName="SelectionBox" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/><Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource Brush.Surface.Disabled}"/><Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Selection.RadioButton" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily.UI}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="SelectionRing" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Brush.Surface.Default}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1.5" VerticalAlignment="Center"><Ellipse x:Name="SelectionDot" Width="10" Height="10" Fill="{DynamicResource Brush.Primary}" Visibility="Collapsed"/></Border>
        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/><Setter TargetName="SelectionRing" Property="Background" Value="{DynamicResource Brush.Surface.Interactive}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="SelectionRing" Property="Background" Value="{DynamicResource Brush.Surface.Selected}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/><Setter TargetName="SelectionDot" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/><Setter TargetName="SelectionRing" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/><Setter TargetName="SelectionRing" Property="Background" Value="{DynamicResource Brush.Surface.Disabled}"/><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}"/><Setter TargetName="SelectionDot" Property="Fill" Value="{DynamicResource Brush.Text.Disabled}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Selection.Slider" TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Effect" Value="{StaticResource Shadow.FocusGlow}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Disabled}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface.Disabled}"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
