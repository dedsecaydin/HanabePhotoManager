<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Sidebar.Container" TargetType="Border"><Setter Property="Width" Value="{StaticResource Size.Rail.Width}"/><Setter Property="Margin" Value="8,8,4,8"/><Setter Property="Padding" Value="0,12"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Container}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface.ContainerLowest}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Sidebar.Header" TargetType="Border"><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="4,0,4,18"/><Setter Property="Padding" Value="14,0"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/><Setter Property="Background" Value="{DynamicResource Brush.Shell.TopBar}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Shell.Highlight}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Sidebar.GroupLabel" TargetType="TextBlock"><Setter Property="Margin" Value="12,16,12,6"/><Setter Property="FontSize" Value="{StaticResource Typography.Caption}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/></Style>
  <Style x:Key="Sidebar.SettingsNavigation" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush.Shell.Sidebar}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/><Setter Property="BorderThickness" Value="0,1,0,0"/></Style>
</ResourceDictionary>
