<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DropShadowEffect x:Key="Shadow.Floating" BlurRadius="16" ShadowDepth="4" Opacity="0.14"/>
  <DropShadowEffect x:Key="Shadow.Dialog" BlurRadius="28" ShadowDepth="8" Opacity="0.18"/>
  <DropShadowEffect x:Key="Shadow.Emphasis" BlurRadius="22" ShadowDepth="5" Opacity="0.10"/>
  <DropShadowEffect x:Key="Shadow.FocusGlow" BlurRadius="12" ShadowDepth="0" Color="{DynamicResource Color.Accent.Default}" Opacity="0.24"/>
</ResourceDictionary>
