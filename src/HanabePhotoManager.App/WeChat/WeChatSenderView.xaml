<UserControl x:Class="HanabePhotoManager.App.WeChat.WeChatSenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{DynamicResource Card.Default}">
          <StackPanel>
            <TextBlock Text="原图发送队列" Style="{DynamicResource Layout.SectionTitle}"/>
            <TextBlock Margin="0,6,0,14" TextWrapping="Wrap"
                       Text="每批最多 9 张，以文件附件发送原图；不压缩、不转码。结果不确定时会暂停，不会盲目重发。"
                       Style="{DynamicResource Status.Description}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Content="选择照片" Style="{DynamicResource Button.Secondary}" Click="ChooseFiles_Click"/>
              <Button Grid.Column="1" Margin="8,0,0,0" Content="选择文件夹"
                      Style="{DynamicResource Button.Secondary}" Click="ChooseFolder_Click"/>
            </Grid>
            <Button Margin="0,8,0,0" Content="清空队列" Style="{DynamicResource Button.Ghost}"
                    Command="{Binding ClearCommand}"/>
          </StackPanel>
        </Border>

        <Border Margin="0,16,0,0" Style="{DynamicResource Card.Default}">
          <StackPanel>
            <TextBlock Text="1. 检测微信" Style="{DynamicResource Layout.SectionTitle}"/>
            <Button Margin="0,10,0,0" Content="检测并打开微信" Style="{DynamicResource Button.Secondary}"
                    Command="{Binding DetectCommand}"/>
            <TextBlock Margin="0,8,0,0" Text="{Binding StatusText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </StackPanel>
        </Border>

        <Border Margin="0,16,0,0" Style="{DynamicResource Card.Default}">
          <StackPanel>
            <TextBlock Text="2. 定位并确认目标" Style="{DynamicResource Layout.SectionTitle}"/>
            <TextBox Margin="0,10,0,0" Style="{DynamicResource Input.TextBox}"
                     Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Margin="0,8,0,0" Content="定位目标聊天" Style="{DynamicResource Button.Secondary}"
                    Command="{Binding LocateTargetCommand}"/>
            <Border Margin="0,10,0,0" Padding="10" Background="{DynamicResource Brush.Surface.Subtle}"
                    CornerRadius="8">
              <StackPanel>
                <TextBlock Text="{Binding LocatedTitle, StringFormat=微信标题：{0}}" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" Text="{Binding LocatedTargetType, StringFormat=类型：{0}}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
              </StackPanel>
            </Border>
            <Button Margin="0,8,0,0" Content="确认此目标" Style="{DynamicResource Button.Primary}"
                    Command="{Binding ConfirmTargetCommand}"/>
            <Border Margin="0,16,0,0" Padding="12"
                    Background="{DynamicResource Brush.Surface.Subtle}"
                    CornerRadius="8">
              <StackPanel>
                <TextBlock Text="自动定位失败时" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,10" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="先在微信里手动打开上方填写的聊天。应用每次把最多 9 张原图复制为文件，你在微信按 Ctrl+V 并发送，再回来确认本批。"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Button Content="复制/重新复制本批"
                          Style="{DynamicResource Button.Secondary}"
                          Command="{Binding PrepareManualBatchCommand}"/>
                  <Button Grid.Column="1" Margin="8,0,0,0"
                          Content="本批已发送"
                          Style="{DynamicResource Button.Primary}"
                          Command="{Binding ConfirmManualBatchSentCommand}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Margin="0,16,0,0" Style="{DynamicResource Card.Default}">
          <StackPanel>
            <TextBlock Text="3. 开始发送" Style="{DynamicResource Layout.SectionTitle}"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Content="开始发送" Style="{DynamicResource Button.Primary}" Command="{Binding StartCommand}"/>
              <Button Grid.Column="1" Margin="8,0,0,0" Content="取消"
                      Style="{DynamicResource Button.Secondary}" Command="{Binding CancelCommand}"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="2" Style="{DynamicResource Card.Default}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <StackPanel>
            <TextBlock Text="发送进度" Style="{DynamicResource Layout.SectionTitle}"/>
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Secondary}">
              <Run Text="批次 "/><Run Text="{Binding CurrentBatch, Mode=OneWay}"/>
              <Run Text=" · 成功 "/><Run Text="{Binding SentCount, Mode=OneWay}"/>
              <Run Text=" · 失败 "/><Run Text="{Binding FailedCount, Mode=OneWay}"/>
              <Run Text=" · 不确定 "/><Run Text="{Binding AmbiguousCount, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, StringFormat={}{0:N0} 张}"
                     FontSize="18" FontWeight="SemiBold"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,12">
          <ProgressBar Height="8" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"/>
          <TextBlock Margin="0,6,0,0" Text="{Binding CurrentFile}"
                     Foreground="{DynamicResource Brush.Text.Secondary}"/>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" Style="{DynamicResource List.Default}"
                 ItemContainerStyle="{DynamicResource ListItem.Default}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="移除" Style="{DynamicResource Button.Toolbar}"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}">
                    <Run Text="{Binding Length, Mode=OneWay, StringFormat={}{0:N0} 字节}"/>
                    <Run Text=" · "/><Run Text="{Binding State, Mode=OneWay}"/>
                    <Run Text=" · 重试 "/><Run Text="{Binding RetryCount, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                             Foreground="{DynamicResource Brush.Text.Secondary}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
